    RenderFragment MatchCard(MatchItem m) => __builder =>
    {
        var open = m.ArticleId is { } aid && reading.Contains(aid);
        <article class="md-match r-@m.Res" id="md-m-@m.Id" data-tint-h="@m.HomeLogo" data-tint-a="@m.AwayLogo">
            <div class="md-gfx @(m.Photo is null ? null : "ph")">
                @if (m.Photo is not null) { <img class="md-mph" src="/tin-anh/@m.Photo" alt="@m.PhotoCaption" loading="lazy" /> }
                <span class="md-comp"><i class="ms" aria-hidden="true">sports_soccer</i>@m.Comp · @(m.MineHome ? "sân nhà" : "sân khách")</span>
                <div class="md-vs">
                    <span class="t @(m.MineHome ? "me" : null)"><Crest Name="@m.Home" Logo="@m.HomeLogo" Large="true" /><b>@Short(m.Home)</b></span>
                    <b class="sc">@m.Score</b>
                    <span class="t @(m.MineHome ? null : "me")"><Crest Name="@m.Away" Logo="@m.AwayLogo" Large="true" /><b>@Short(m.Away)</b></span>
                </div>
            </div>
            <div class="md-mb">
                <h3>@(m.Title ?? $"{m.Home} {m.Score} {m.Away}")</h3>
                @if (m.Scorers.Count > 0)
                {
                    <ul class="md-goals">
                        @foreach (var s in m.Scorers) { <li class="@(s.Home ? "h" : "a")"><i class="ms fill" aria-hidden="true">sports_soccer</i>@s.Name <span>@s.Minutes</span></li> }
                    </ul>
                }
                @if (m.Poss is { } po)
                {
                    <div class="md-stat">
                        <div class="bar"><b>@po.H%</b><span style="--p:@po.H%"><i></i></span><b>@po.A%</b></div>
                        <div class="lb"><span>Kiểm soát bóng</span>@if (m.Shots is { } st) { <span>Sút @st.H (@st.HOn trúng) · @st.A (@st.AOn trúng)</span> }</div>
                    </div>
                }
                @if (open)
                {
                    <div class="md-body">@foreach (var para in m.Paras) { <p>@para</p> }</div>
                }
                <div class="md-act">
                    @if (m.Motm is not null) { <span class="md-motm"><i class="ms fill" aria-hidden="true">star</i>Hay nhất trận <b>@m.Motm</b> <em>@(m.MotmRating is { } mr ? Num(mr) : null)</em></span> }
                    <span class="md-btns">
                        @if (m.ArticleId is { } id && m.Paras.Count > 0)
                        {
                            <button type="button" class="cx-btn ghost sm" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(id)"><i class="ms" aria-hidden="true">@(open ? "expand_less" : "newspaper")</i>@(open ? "Thu gọn" : "Đọc bài")</button>
                        }
                        <a class="cx-btn ghost sm" href="tran/@m.Id"><i class="ms" aria-hidden="true">scoreboard</i>Trận</a>
                    </span>
                </div>
            </div>
        </article>
    };

    void Toggle(Guid id) { if (!reading.Remove(id)) reading.Add(id); }

    // ---- Lời trích họp báo: câu trả lời đã chọn × kết quả (PO 21/11 duyệt mẫu, không AI) ----
    static readonly Dictionary<(PressTone, int), string[]> Quotes = new()
    {
        [(PressTone.Praise, 1)] = ["Các cầu thủ xứng đáng với mọi lời khen hôm nay", "Tôi tự hào về cách cả đội chiến đấu từ phút đầu đến phút cuối"],
        [(PressTone.Praise, 0)] = ["Một điểm hôm nay là thứ cả đội phải đổ mồ hôi mới có được", "Tôi hài lòng với tinh thần của các cầu thủ, dù tỉ số chưa như ý"],
        [(PressTone.Praise, -1)] = ["Thua trận nhưng tôi không thể trách các cầu thủ về sự nỗ lực", "Các cầu thủ đã cho đi tất cả, tỉ số không nói hết những gì họ làm"],
        [(PressTone.Calm, 1)] = ["Ba điểm là quan trọng, nhưng chúng tôi chưa đạt được gì cả", "Chúng tôi vui một chút rồi quay lại tập luyện ngay ngày mai"],
        [(PressTone.Calm, 0)] = ["Một trận hoà không thay đổi mục tiêu của chúng tôi", "Có những điều cần sửa, và chúng tôi sẽ sửa trước trận tới"],
        [(PressTone.Calm, -1)] = ["Không cần hoảng loạn, chúng tôi sẽ xem lại trận đấu và đứng dậy", "Một thất bại không định nghĩa cả mùa giải"],
        [(PressTone.Demanding, 1)] = ["Thắng rồi, nhưng đội bóng này còn có thể chơi tốt hơn nhiều", "Kết quả tốt, nhưng những lúc lơi lỏng hôm nay không được lặp lại"],
        [(PressTone.Demanding, 0)] = ["Hoà là không đủ, mỗi cầu thủ phải đòi hỏi ở bản thân nhiều hơn", "Chúng tôi đã đánh rơi hai điểm, tôi chờ một phản ứng ở trận tới"],
        [(PressTone.Demanding, -1)] = ["Màn trình diễn hôm nay không thể chấp nhận được", "Không ai được phép hài lòng sau trận này, kể cả tôi"],
    };
    static string Quote(PressTone tone, int gd, Guid fixtureId) => Quotes[(tone, Math.Sign(gd))][fixtureId.ToByteArray()[0] & 1];
    static string ToneLabel(PressTone t) => t switch { PressTone.Praise => "khen ngợi các cầu thủ", PressTone.Calm => "điềm tĩnh, tập trung trận tới", _ => "đòi hỏi nhiều hơn" };
    static string ResText(int gd) => gd > 0 ? "Thắng" : gd == 0 ? "Hoà" : "Thua";
    static string ResCss(int gd) => gd > 0 ? "win" : gd == 0 ? "draw" : "loss";
    static readonly System.Globalization.CultureInfo Vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    static string Clip(string s, int n) => s.Length <= n ? s : (s.LastIndexOf(' ', n) is var i and > 0 ? s[..i] : s[..n]) + "…";
    static readonly string[] Tails = [" FC", " AFC", " CF", " SC"];
    /// <summary>Tên gọn: bỏ đuôi FC/AFC… ("Aston Villa FC" → "Aston Villa").</summary>
    static string Short(string name) => Tails.FirstOrDefault(t => name.EndsWith(t, StringComparison.Ordinal)) is { } t ? name[..^t.Length] : name;
}
