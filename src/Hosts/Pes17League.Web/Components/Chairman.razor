</svg>

@code {
    [Parameter, EditorRequired] public string Club { get; set; } = "";
    [Parameter] public bool Scarf { get; set; }

    sealed record Look(string Skin, string Shade, string Hair, string HairDark, int Style, bool Beard, bool Glasses);

    static readonly (string Skin, string Shade)[] Skins =
        [("#F3D0B0", "#CF9F7C"), ("#EBBE97", "#C48E69"), ("#D6A178", "#AC7752"), ("#B97E55", "#8E5A38"), ("#8A5634", "#653B22"), ("#5E3A24", "#432717")];
    static readonly (string Hair, string Dark)[] Hairs =
        [("#C9CFDA", "#8E96A6"), ("#E6E8EC", "#AEB3BC"), ("#2A2328", "#141014"), ("#5B3C28", "#3A2618"), ("#8C8F96", "#5E6168")];
    // màu dự phòng khi chưa đọc được logo (giống Crest)
    static readonly string[] Palette = ["#c8102e", "#034694", "#6cabdd", "#da291c", "#132257", "#fdb913", "#7a263a", "#003399", "#ef0107", "#00a650", "#95bfe5", "#e03a3e", "#5c2d91", "#0057b8"];
    static readonly HashSet<string> Skip = ["fc", "cf", "afc", "sc", "ac", "the", "clb", "fk", "sk", "cd", "ud", "rc", "ss", "as", "us", "sv", "vfl", "bv", "1.", "club", "de"];

    Look L = default!;
    string Fb1 = "", Fb2 = "#E9EDF7", FbInk = "#fff", ScarfText = "";

    /// <summary>FNV-1a — ổn định giữa các lần chạy (string.GetHashCode thì không).</summary>
    static uint Fnv(string s) { var h = 2166136261u; foreach (var c in s) { h ^= c; h *= 16777619u; } return h; }

    protected override void OnParametersSet()
    {
        var h = Fnv(Club);
        var (skin, shade) = Skins[h % (uint)Skins.Length];
        var (hair, dark) = Hairs[(h >> 4) % (uint)Hairs.Length];
        L = new Look(skin, shade, hair, dark, (int)((h >> 8) % 3), ((h >> 11) & 3) == 0, (h >> 14) % 3 == 0);
        Fb1 = Palette[Club.Aggregate(7, (a, ch) => (a * 31 + ch) & 0x7fffffff) % Palette.Length];
        var rgb = Convert.FromHexString(Fb1[1..]);
        FbInk = (.2126 * rgb[0] + .7152 * rgb[1] + .0722 * rgb[2]) / 255 > .55 ? "#0B1430" : "#fff";   // chữ trên khăn đủ tương phản
        var words = Club.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => !Skip.Contains(w.ToLowerInvariant())).ToList();
        if (words.Count == 0) words = [Club];
        var t = string.Join(' ', words);
        ScarfText = (t.Length <= 20 ? t : words.OrderByDescending(w => w.Length).First()).ToUpperInvariant();
    }
}
