@* Thẻ HLV career (PO 19/11): viền theo danh tiếng (đồng/bạc/vàng/huyền thoại), danh tiếng, bằng, ảnh mặt 2D (PO 20/11 bỏ 3D), tên, nhãn, radar năng lực. *@
@{ var t = CoachRules.RepCard(C.Reputation); var face = CoachUi.FaceUrl(C); }
<div class="hlv-card" data-t="@t">
    <div class="in">
        <div class="hd">
            <div class="rep">
                <b>@C.Reputation</b><small>Danh tiếng</small>
                <span class="tierl">@CoachRules.RepTier(C.Reputation)</span>
                <span class="lic">@CoachUi.License(C.License)</span>
            </div>
            <div class="face">
                @if (face is not null) { <img class="flat" src="@face" alt="Ảnh mặt @C.Name" /> }
                else { <span class="ms" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:96px;color:rgba(255,255,255,.18)">person</span> }
            </div>
        </div>
        <div class="nm">
            <b>@C.Name</b>
            <small>@(string.IsNullOrWhiteSpace(C.Nickname) ? "" : $"\"{C.Nickname}\" · ")@C.Age tuổi · @C.Nationality</small>
            <div class="tags">
                <span>@CoachRules.Origin(C.Origin).Name</span><span>@CoachRules.Trait(C.Trait).Name</span><span>@C.Formation</span><span>@C.Style</span>
                @if (ClubName is not null) { <span>@ClubName</span> }
            </div>
        </div>
        @CoachUi.Radar(C.Skills, ShowBase ? C.BaseSkills : null)
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Coach C { get; set; } = default!;
    [Parameter] public string? ClubName { get; set; }
    [Parameter] public string? ClubLogo { get; set; }
    [Parameter] public bool ShowBase { get; set; }
}
