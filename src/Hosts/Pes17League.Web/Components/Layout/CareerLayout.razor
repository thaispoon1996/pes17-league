@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject CurrentUser Me
@inject NavigationManager Nav
@inject MailHub Mail
@inject MatchJobService Jobs
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject TimeProvider Clock
@implements IDisposable

@* UI Career đợt 1 (Stitch "Nocturnal Apex", PO duyệt 19/11): người chơi đang cầm CLB career → khung game (đầu trang CLB, menu nổi ≤5 mục mở dần,
   thẻ "Vừa mở khoá", màn kết quả trận). Chưa có CLB: chỉ trang /su-nghiep dùng khung này (hướng dẫn bắt đầu); khách/admin/trang khác → MainLayout như cũ. *@
@if (!ready)
{
    <div class="cx cx-boot"><div class="cx-sky" aria-hidden="true"></div></div>
}
else if (P is null && !(onboarding && OnCareerHome))
{
    <MainLayout Body="@Body" />
}
else
{
    <div class="cx @(P is null ? "cx-solo" : "")" data-music="@(MusicOn ? "on" : "off")">
        @{ var zones = Zones().ToList(); var here = ZoneOf(zones); var home = Path == "su-nghiep"; }
        @* PO 22/11: gộp 2 UI → khung career dùng đầu trang xanh "Pro Pitch Broadcast" của giải online. Máy tính: dải trên (CLB, quỹ, tìm kiếm, tài khoản)
           + menu chính (Trang chủ + mỗi khu là 1 menu thả xuống, ui.js đóng khi bấm ra ngoài). Điện thoại: dải trên gọn + thanh dưới 7 ô (.cx-dock) mở bảng mục con. *@
        <header class="site-header cxh">
            <div class="top-nav">
                <div class="in">
                    @if (P is { } p)
                    {
                        <a class="cxh-club" href="su-nghiep">
                            <Crest Name="@p.ClubName" Logo="@p.ClubLogo" />
                            <span><b>@p.ClubName</b><small>@p.SeasonName · @(p.Finished ? "hết mùa" : $"Khung {Math.Max(p.Slot, 1)}/{p.Slots}")</small></span>
                        </a>
                        <span class="cxh-coin" title="Quỹ CLB"><i class="ms" aria-hidden="true">payments</i><b data-count="@p.Budget" data-fmt="money">@Fmt.Money(p.Budget)</b></span>
                    }
                    else
                    {
                        @* Chưa cầm CLB (tạo HLV, tìm việc, thất nghiệp) *@
                        <a class="cxh-club" href="su-nghiep">
                            <i class="ms fill" aria-hidden="true">sports</i>
                            <span><b>Sự nghiệp HLV</b><small>@(coach switch { null => "Chưa có hồ sơ", CoachStatus.Creating => "Đang tạo hồ sơ", _ => "Chưa có CLB" })</small></span>
                        </a>
                    }
                    @* Chuông thông báo (PO 22/11): việc cần xử lý, thay khối "Cần xử lý" ở trang chủ. Máy tính thả xuống, điện thoại bảng dưới dải trên. *@
                    @if (me is not null)
                    {
                        <details class="nav-more cxh-bell @(todo.Count > 0 ? "has" : null)">
                            <summary class="no-busy" aria-label="@(todo.Count > 0 ? $"Thông báo: {todo.Count} việc cần xử lý" : "Thông báo")" title="Cần xử lý">
                                <i class="ms @(todo.Count > 0 ? "fill" : null)" aria-hidden="true">notifications</i>@if (todo.Count > 0) { <span class="badge">@todo.Count</span> }
                            </summary>
                            <div class="nav-more__menu cxh-bp">
                                <p class="cxh-bh"><b>Cần xử lý</b>@if (todo.Count > 0) { <small>@todo.Count việc</small> }</p>
                                @if (todo.Count == 0)
                                {
                                    <p class="cxh-none"><i class="ms" aria-hidden="true">task_alt</i>Không có việc cần xử lý.</p>
                                }
                                @foreach (var t in todo)
                                {
                                    <a class="cxh-it t-@t.Tone" href="@t.Href">
                                        <i class="ms" aria-hidden="true">@t.Icon</i><span>@t.Title@if (t.Text is not null) { <small>@t.Text</small> }</span>
                                        @if (t.Chip is not null) { <em>@t.Chip</em> }
                                    </a>
                                }
                            </div>
                        </details>
                    }
                    <a class="cxh-link" href="tim-kiem" aria-label="Tìm kiếm"><i class="ms" aria-hidden="true">search</i><span>Tìm kiếm</span></a>
                    @if (MusicOn) { <button type="button" class="cx-ibtn snd" data-snd="music" aria-label="Bật/tắt nhạc" title="Nhạc nền (tự sáng tác)"><i class="ms" aria-hidden="true">music_note</i></button> }
                    @if (admin) { <a class="cxh-link wide" href="admin"><i class="ms" aria-hidden="true">settings</i><span>Quản trị</span></a> }
                    @if (who is not null)
                    {
                        <form class="cxh-who" method="post" action="/logout" data-enhance="false">@if (profile is not null) { <a class="who" href="@profile">@who</a> } else { <small class="who">@who</small> }<button class="link">Thoát</button></form>
                    }
                </div>
            </div>
            <div class="main-nav">
                <div class="in">
                    <a class="brand" href="su-nghiep" aria-label="PES 17 League">
                        <svg class="shield" viewBox="0 0 32 36" aria-hidden="true"><path d="M16 1 30 6v11c0 9-6 15-14 18C8 32 2 26 2 17V6z" fill="var(--primary)"/><path d="M16 5 26 8.6V17c0 6.6-4.2 11.2-10 13.6C10.2 28.2 6 23.6 6 17V8.6z" fill="#0a0e18"/><path d="m16 10 1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z" fill="var(--primary)"/></svg>
                        <span>PES 17<b>League</b></span></a>
                    <nav class="cxh-nav" aria-label="Điều hướng">
                        <a href="su-nghiep" class="@(home ? "active" : null)" aria-current="@(home ? "page" : null)">Trang chủ</a>
                        @foreach (var z in zones)
                        {
                            <details @key="z.Id" class="nav-more cxh-dd @(here?.Id == z.Id ? "on" : null)">
                                <summary class="no-busy" @onclick="OpenMenuAsync">@z.Short @if (z.Badge > 0) { <span class="badge">@z.Badge</span> } else if (z.Items.Any(i => i.Fresh)) { <i class="cx-dot" aria-label="mới"></i> }</summary>
                                <div class="nav-more__menu">
                                    @if (z.Stat is { } zs) { <p class="cxh-stat @z.Tone">@zs</p> }
                                    @foreach (var it in z.Items)
                                    {
                                        @if (it.Lock is { } why)
                                        {
                                            <span class="cxh-it lock" aria-disabled="true"><i class="ms" aria-hidden="true">lock</i><span>@it.Label<small>@why</small></span></span>
                                        }
                                        else
                                        {
                                            <a class="cxh-it @(it.Href is { } ih && !it.Hard && Bare(ih) == Path ? "active" : null)" href="@it.Href" data-enhance-nav="@(it.Hard ? "false" : null)">
                                                <i class="ms" aria-hidden="true">@it.Icon</i><span>@it.Label@if (it.Note is { } nt) { <small>@nt</small> }</span>
                                                @if (it.Badge > 0) { <span class="badge">@it.Badge</span> }
                                                else if (it.Fresh) { <i class="cx-dot" aria-label="mới"></i> }
                                            </a>
                                        }
                                    }
                                </div>
                            </details>
                        }
                    </nav>
                </div>
            </div>
        </header>
        @if (P is not null && here is { Id: not "life" } hz)
        {
            var subs = hz.Items.Where(i => i.Lock is null && !i.Hard && i.Href is { } h && h.IndexOfAny(['?', '#']) < 0).ToList();
            @if (subs.Count > 1)
            {
                <nav class="cx-sub" aria-label="@hz.Title">
                    @foreach (var s in subs)
                    {
                        @* So theo đường dẫn bỏ ?query (vd thu-hlv?thu=… từ trang chủ vẫn sáng "Thư HLV") *@
                        <a href="@s.Href" class="@(Path == s.Href ? "active" : null)" aria-current="@(Path == s.Href ? "page" : null)">@(s.Short ?? s.Label) @if (s.Fresh) { <i class="cx-dot" aria-label="mới"></i> }</a>
                    }
                </nav>
            }
        }
        <CascadingValue Value="this" IsFixed="true">
            <main class="cx-page">@Body</main>
        </CascadingValue>
        @* Thanh dưới (PO 20/11, phương án A): Trang chủ + các khu (Văn phòng, Thay đồ, Chuyển nhượng, Giải đấu, Hòm thư & thông báo, Cá nhân & cài đặt).
           Bấm ô khu → bảng mục con trượt lên ngay trên thanh; mở/đóng ở career.js (data-sheet, data-open) để bấm là mở ngay, Blazor chỉ nạp số liệu khu. *@
        <div class="cx-menu" id="cx-menu">
            <div class="cx-mscrim" data-sheet="close" aria-hidden="true"></div>
            @foreach (var z in zones)
            {
                <section @key="z.Id" class="cx-msheet z-@z.Id" id="cxs-@z.Id" role="dialog" aria-labelledby="cxz-@z.Id">
                    <div class="cx-mbody">
                        @if (z.Id == "life")
                        {
                            <a class="cx-dme" href="@(coach is null ? profile ?? "su-nghiep" : "hlv")">
                                @if (menu?.Face is { } face) { <img src="@face" alt="" /> }
                                else { <i class="ms fill" aria-hidden="true">person</i> }
                                <span><b>@(menu?.CoachName ?? who ?? "Khách")</b><small>@(P is { } dp ? "HLV trưởng " + dp.ClubName : coach switch { null => "Chưa có hồ sơ HLV", CoachStatus.Creating => "Đang tạo hồ sơ", _ => "Đang tìm CLB" })</small></span>
                            </a>
                        }
                        <h2 id="cxz-@z.Id"><i class="ms fill" aria-hidden="true">@z.Icon</i><span>@z.Title</span>@if (z.Stat is { } zs) { <b class="cx-zstat @z.Tone">@zs</b> }</h2>
                        @{ var ti = 0; }
                        @foreach (var g in z.Items.GroupBy(i => i.Group))
                        {
                            @if (g.Key is { } gk) { <h3 class="cx-mgroup">@gk</h3> }
                            <div class="cx-ztiles">
                                @foreach (var it in g)
                                {
                                    var i = ti++;
                                    @if (it.Lock is { } why)
                                    {
                                        <span class="cx-zt lock" style="--i:@i" aria-disabled="true"><i class="ms" aria-hidden="true">lock</i><span>@it.Label<small>@why</small></span></span>
                                    }
                                    else
                                    {
                                        <a class="cx-zt" style="--i:@i" href="@it.Href" data-enhance-nav="@(it.Hard ? "false" : null)">
                                            <i class="ms" aria-hidden="true">@it.Icon</i><span>@it.Label@if (it.Note is { } nt) { <small>@nt</small> }</span>
                                            @if (it.Badge > 0) { <em>@it.Badge</em> }
                                            else if (it.Fresh) { <i class="cx-dot" aria-label="mới"></i> }
                                        </a>
                                    }
                                }
                            </div>
                        }
                        @if (z.Id == "life" && me is not null)
                        {
                            <form method="post" action="/logout" data-enhance="false" class="cx-dfoot"><button><i class="ms" aria-hidden="true">logout</i>Đăng xuất</button></form>
                        }
                    </div>
                </section>
            }
        </div>
        <nav class="cx-dock" aria-label="Điều hướng sự nghiệp">
            <a class="@(home ? "on" : null)" href="su-nghiep" aria-current="@(home ? "page" : null)"><i class="ms @(home ? "fill" : null)" aria-hidden="true">stadium</i><span>Trang chủ</span></a>
            @foreach (var z in zones)
            {
                var on = here?.Id == z.Id;
                <button type="button" class="no-busy @(on ? "on" : null) @(fresh.Contains(z.Id) ? "fly" : null)" data-sheet="@z.Id" aria-controls="cxs-@z.Id" @onclick="OpenMenuAsync">
                    @if (z.Badge > 0) { <em>@z.Badge</em> }
                    else if (z.Items.Any(i => i.Fresh)) { <span class="cx-new">MỚI</span> }
                    <i class="ms @(on ? "fill" : null)" aria-hidden="true">@z.Icon</i><span>@(z.Id == "transfer" ? "Chuyển nh." : z.Short)</span>
                </button>
            }
        </nav>
        @if (P is { } q)
        {
            @if (result is { } r)
            {
                <div class="cx-ov cx-result-ov @(r.Verdict switch { 'W' => "win", 'L' => "loss", _ => "draw" })" role="dialog" aria-modal="true" aria-label="Kết quả trận">
                    <canvas class="cx-confetti" aria-hidden="true"></canvas>
                    <div class="cx-result">
                        <div class="cx-eyebrow">@r.Competition@(r.Stage == FixtureStage.League ? "" : " · " + AdminText.SlotKind(r.Stage, r.Leg)) · Hết giờ</div>
                        <div class="cx-score">
                            <span class="t"><Crest Name="@r.Home" Logo="@r.HomeLogo" Large="true" /><b>@r.Home</b></span>
                            <span class="n"><b data-count="@r.HomeGoals">@r.HomeGoals</b><i>–</i><b data-count="@r.AwayGoals">@r.AwayGoals</b></span>
                            <span class="t"><Crest Name="@r.Away" Logo="@r.AwayLogo" Large="true" /><b>@r.Away</b></span>
                        </div>
                        @if (r.HomePens is { } hp && r.AwayPens is { } ap) { <p class="cx-pens">Luân lưu @hp–@ap</p> }
                        <span class="cx-verdict">@(r.Verdict switch { 'W' => "Thắng", 'L' => "Thua", _ => "Hoà" })</span>
                        @if (r.Scorers.Count > 0)
                        {
                            <div class="cx-scorers">
                                <p>@string.Join(", ", r.Scorers.Where(s => s.Home).Select(s => $"{s.Name} {s.Minute}'"))</p>
                                <i class="ms" aria-hidden="true">sports_soccer</i>
                                <p>@string.Join(", ", r.Scorers.Where(s => !s.Home).Select(s => $"{s.Name} {s.Minute}'"))</p>
                            </div>
                        }
                        <div class="cx-facts">
                            <div>@if (r.BestId is { } bid) { <Face Id="bid" Name="@r.BestName" Size="md" /> }<b>@(r.BestRating?.ToString("0.0") ?? "–")</b><span>@(r.BestName ?? "Hay nhất")</span></div>
                            <div><b class="cx-up">@(r.Prize is { } pz ? "+" + Fmt.Money(pz) : "–")</b><span>Tiền thưởng</span></div>
                            @{ var dr = r.RankBefore is { } rb && r.RankAfter is { } ra ? rb - ra : 0; }
                            <div><b class="@(dr > 0 ? "cx-up" : dr < 0 ? "cx-down" : "")">@(r.RankAfter is { } rk ? (dr > 0 ? "▲ " : dr < 0 ? "▼ " : "") + rk : "–")</b><span>Hạng giải</span></div>
                        </div>
                        <div class="cx-acts">
                            <a class="cx-btn ghost" href="tran/@r.FixtureId" @onclick="CloseResult">Xem trận</a>
                            <button class="cx-btn gold" @onclick="CloseResult">Tiếp tục</button>
                        </div>
                    </div>
                </div>
            }
            else if (intro is { } f && Intros.TryGetValue(f, out var info))
            {
                <div class="cx-ov cx-unlock-ov" role="dialog" aria-modal="true" aria-label="Vừa mở khoá">
                    <div class="cx-sheet">
                        <div class="cx-lock" aria-hidden="true"><i class="ms fill">lock</i><i class="ms fill open">@info.Icon</i>@for (var k = 0; k < 8; k++) { <s style="--k:@k"></s> }</div>
                        <div class="cx-eyebrow">Vừa mở khoá</div>
                        <h2>@info.Title</h2>
                        <p>@info.Text</p>
                        <div class="cx-acts">
                            <button class="cx-btn ghost" @onclick="() => CloseIntro(false)">Để sau</button>
                            <button class="cx-btn gold" @onclick="() => CloseIntro(true)">Xem ngay</button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    /// <summary>PO 20/11: TẠM tắt nhạc nền career (âm hiệu ứng vẫn kêu). Bật lại: đổi true — career-audio.js đọc data-music trên .cx.</summary>
    public const bool MusicOn = false;

    public sealed record Intro(string Title, string Text, string Icon, string Href);

    public static readonly IReadOnlyDictionary<string, Intro> Intros = new Dictionary<string, Intro>
    {
        [CareerUnlocks.Transfer] = new("Chuyển nhượng", "Chợ đang mở. Mua người hợp với tuyến yếu nhất, bán bớt người dư để có tiền. CLB BOT cũng sẽ hỏi mua cầu thủ của bạn.", "swap_horiz", "chuyen-nhuong"),
        [CareerUnlocks.Stats] = new("Thống kê", "Trận đầu tiên đã có kết quả. Xem vua phá lưới, điểm cầu thủ và phong độ cả giải.", "query_stats", "thong-ke"),
        [CareerUnlocks.Finance] = new("Tài chính", "Mỗi khung có trận, CLB nhận tiền bản quyền, tài trợ, tiền vé và tiền thưởng, rồi trả lương. Giữ quỹ dương để ban lãnh đạo hài lòng.", "account_balance", "tai-chinh"),
        [CareerUnlocks.Board] = new("Ban lãnh đạo", "Ban lãnh đạo đặt mục tiêu theo sức mạnh đội. Thứ hạng tốt thì niềm tin tăng; tụt quá sâu thì ghế HLV lung lay.", "domain", "ban-lanh-dao"),
        [CareerUnlocks.Offers] = new("Đề nghị chuyển nhượng", "Có CLB vừa hỏi mua cầu thủ của bạn. Chấp nhận, trả giá hoặc từ chối trước khi chợ đóng.", "handshake", "de-nghi"),
        [CareerUnlocks.Training] = new("Tập luyện", "Đặt giáo án và chọn người để phát triển. Chỉ số tăng dần cho tới khi chạm tiềm năng.", "fitness_center", "tap-luyen"),
        [CareerUnlocks.Contracts] = new("Gia hạn hợp đồng", "Hợp đồng tính theo số trận. Có cầu thủ còn dưới 10 trận: gia hạn ở trang Đội hình, hoặc để họ ra đi.", "contract_edit", "clb"),
        [CareerUnlocks.Academy] = new("Học viện & trinh sát", "Giữa mùa rồi: gửi trinh sát tìm tài năng trẻ và đôn người từ học viện lên.", "school", "hoc-vien"),
    };

    static readonly Dictionary<string, string> PathFeature = new()
    {
        ["su-nghiep"] = CareerUnlocks.Home, ["clb"] = CareerUnlocks.Squad, ["chuyen-nhuong"] = CareerUnlocks.Transfer, ["de-nghi"] = CareerUnlocks.Offers,
        ["tai-chinh"] = CareerUnlocks.Finance, ["ban-lanh-dao"] = CareerUnlocks.Board, ["tap-luyen"] = CareerUnlocks.Training, ["hoc-vien"] = CareerUnlocks.Academy,
        ["bxh"] = CareerUnlocks.League, ["lich"] = CareerUnlocks.League, ["thong-ke"] = CareerUnlocks.Stats,
    };

    /// <summary>Trang (đường dẫn tương đối, vd "bxh") đã mở khoá chưa; trang không gắn tính năng luôn mở.</summary>
    public bool CanOpen(string path) => P is null || !PathFeature.TryGetValue(path, out var f) || P.Has(f);

    /// <summary>Trạng thái career của người chơi (null = chưa cầm CLB).</summary>
    public CareerProgress? P { get; private set; }
    /// <summary>Báo trang con khi P đổi (trang chủ đọc lại).</summary>
    public event Action? Changed;

    bool ready, onboarding, admin;
    Guid? me;
    int unread, coachUnread;
    List<TodoItem> todo = [];   // chuông thông báo
    CoachStatus? coach;
    string? who, profile;
    CareerMatchResult? result;
    string? intro;
    HashSet<string> fresh = [];   // khu vừa có mục mở khoá → ô khu nảy trên thanh dưới

    /// <summary>Đường dẫn tương đối không ?query; "" (trang gốc, PO 22/11 = trang chủ career) coi như "su-nghiep".</summary>
    string Path => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') is { Length: > 0 } x ? x : "su-nghiep";
    /// <summary>Trang dùng khung career cả khi chưa cầm CLB: trang chủ career + hồ sơ / việc làm / thư HLV (PO 19/11).</summary>
    bool OnCareerHome => Path is "su-nghiep" or "hlv" or "hlv/viec-lam" or "thu-hlv" or "cuoc-song" or "cai-dat" or "dieu-khien";

    protected override async Task OnInitializedAsync()
    {
        admin = await Me.IsAdminAsync();
        var guest = await Me.IsGuestAsync();
        me = await Me.ManagerIdAsync();
        onboarding = !guest && me is not null;
        if (me is not null)
        {
            who = await Me.NameAsync();
            profile = "nguoi-choi/" + await Me.UsernameAsync();
            await LoadAsync(first: true);
            await CountMailAsync();
            Mail.Changed += OnMail;
            Jobs.Changed += OnJob;
            Nav.LocationChanged += OnLocation;
        }
        ready = true;
    }

    public async Task RefreshAsync()
    {
        await LoadAsync(first: false);
        await CountMailAsync();   // việc vừa xử lý trên trang → chuông cập nhật ngay
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadAsync(bool first)
    {
        if (me is not { } id) return;
        await using var db = await Dbs.CreateDbContextAsync();
        var svc = new CareerProgressService(db, Clock);
        var before = P;
        P = await svc.LoadAsync(id);
        if (P is null) { result = null; intro = null; return; }
        if (PathFeature.TryGetValue(Path, out var f) && P.Has(f) && !P.Seen.Contains("visit:" + f))
        {
            await svc.MarkAsync(id, "visit:" + f, "intro:" + f);
            P = await svc.LoadAsync(id);
        }
        // Khu vừa có mục mở khoá so với lần đọc trước → ô khu đó nảy trên thanh dưới.
        if (before is not null && P is not null)
            fresh = [.. Zones().Where(z => z.Items.Any(i => i.Feature is { } f && P.Has(f) && !before.Has(f))).Select(z => z.Id)];
        // Màn kết quả trước, rồi tới thẻ mở khoá; không chen khi máy đang mô phỏng hoặc đang ở trang chuẩn bị/xem trận.
        var quiet = Jobs.Running || Path.StartsWith("chuan-bi") || Path.StartsWith("vao-tran");
        result = !quiet && P?.PendingResult is { } rid ? await svc.ResultAsync(rid, P.ClubId) : null;
        intro = !quiet && result is null ? P?.PendingIntros.FirstOrDefault(Intros.ContainsKey) : null;
        Changed?.Invoke();
    }

    async Task CloseResult()
    {
        if (me is not { } id || result is null) return;
        await using (var db = await Dbs.CreateDbContextAsync())
            await new CareerProgressService(db, Clock).MarkAsync(id, "result:" + result.FixtureId);
        result = null;
        await LoadAsync(first: false);
    }

    async Task CloseIntro(bool go)
    {
        if (me is not { } id || intro is not { } f) return;
        await using (var db = await Dbs.CreateDbContextAsync())
            await new CareerProgressService(db, Clock).MarkAsync(id, go ? ["intro:" + f, "visit:" + f] : ["intro:" + f]);
        intro = null;
        if (go && Intros.TryGetValue(f, out var info)) { Nav.NavigateTo(info.Href); return; }
        await LoadAsync(first: false);
    }

    void OnLocation(object? _, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        try { await LoadAsync(first: false); await CountMailAsync(); } catch { /* khung phụ: lỗi đọc không chặn trang */ }
        StateHasChanged();
    });

    bool wasRunning;
    void OnJob() => InvokeAsync(async () =>
    {
        if (wasRunning && !Jobs.Running)
        {
            try { await LoadAsync(first: false); await CountMailAsync(); } catch { }
            StateHasChanged();
        }
        wasRunning = Jobs.Running;
    });

    /// <summary>Số thư chưa đọc (ô Hòm thư) + việc cần xử lý (chuông).</summary>
    async Task CountMailAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        todo = me is { } mid ? await CareerTodo.LoadAsync(db, Clock, mid, P) : [];
        unread = await new MailService(db, Clock).UnreadAsync(me);
        coach = me is { } id ? await db.Coaches.AsNoTracking().Where(c => c.ManagerId == id).Select(c => (CoachStatus?)c.Status).FirstOrDefaultAsync() : null;
        coachUnread = me is { } m && coach is CoachStatus.Employed or CoachStatus.Unemployed ? await new CoachLetterService(db, Clock).UnreadAsync(m) : 0;
    }

    /// <summary>Trang HLV gọi sau khi đọc thư / tạo hồ sơ để số thư ở ô Hòm thư cập nhật.</summary>
    public async Task RefreshMailAsync()
    {
        await CountMailAsync();
        await InvokeAsync(StateHasChanged);
    }

    void OnMail() => InvokeAsync(async () => { await CountMailAsync(); StateHasChanged(); });


    // ===== Thanh dưới theo khu (PO 20/11, phương án A) =====
    sealed record MItem(string Label, string Icon, string? Href, string? Lock = null, int Badge = 0, string? Note = null, bool Fresh = false, bool Hard = false,
        string? Feature = null, string? Short = null, string? Group = null);
    /// <summary>Một ô trên thanh dưới: Short = nhãn ô, Title = tiêu đề bảng trượt lên, Badge = số đỏ trên ô.</summary>
    sealed record Zone(string Id, string Title, string Short, string Icon, string? Stat, string Tone, IReadOnlyList<MItem> Items, int Badge = 0);
    /// <summary>Số liệu thật cho từng khu, nạp khi bấm ô khu.</summary>
    sealed record MenuStats(string? CoachName, string? Face, long? Wallet, int? Stress, int Pending, int? Confidence, int? Rank, int Teams, int? Morale, int Injured);
    MenuStats? menu;

    async Task OpenMenuAsync()
    {
        try { await LoadMenuAsync(); }
        catch { /* bảng vẫn mở với số cũ */ }
    }

    async Task LoadMenuAsync()
    {
        if (me is not { } id) return;
        await using var db = await Dbs.CreateDbContextAsync();
        var c = await db.Coaches.AsNoTracking().Where(x => x.ManagerId == id && x.Status != CoachStatus.Creating)
            .Select(x => new { x.Id, x.Name, x.Stress, x.UpdatedAt, HasFace = x.Face != null }).FirstOrDefaultAsync();
        long? wallet = null; var pending = 0;
        if (c is not null)
        {
            wallet = await db.CoachLedger.Where(e => e.CoachId == c.Id).SumAsync(e => e.Amount);
            pending = await db.CoachLetters.CountAsync(l => l.CoachId == c.Id && l.Kind == LetterKind.Decision && l.Chosen == null && !l.Archived);
        }
        int? conf = null, rank = null, morale = null; int teams = 0, injured = 0;
        if (P is { } p)
        {
            if (await new BoardService(db, Clock).StatusAsync(p.SeasonId, p.ClubId) is { } b) (conf, rank, teams) = (b.Confidence, b.Position, b.Teams);
            var squad = await new ConditionService(db, Clock).SquadAsync(p.ClubId);
            if (squad.Count > 0) morale = (int)Math.Round(squad.Average(r => r.Morale));
            injured = squad.Count(r => r.InjuredRounds > 0);
        }
        menu = new(c?.Name, c is { HasFace: true } ? $"hlv/anh/mat/{c.Id}?v={c.UpdatedAt.UtcTicks}" : null, wallet, c?.Stress, pending, conf, rank, teams, morale, injured);
    }

    static string LockHint(string f, CareerProgress p) => f switch
    {
        CareerUnlocks.Stats or CareerUnlocks.Club or CareerUnlocks.Finance or CareerUnlocks.Board => "Mở sau trận đầu",
        CareerUnlocks.Transfer => p.NextMarketSlot is { } n ? $"Chợ mở khung {n}" : "Chợ đã đóng",
        CareerUnlocks.Offers => "Khi có CLB hỏi mua",
        CareerUnlocks.Training => $"Mở sau {CareerUnlocks.TrainingAfter} trận",
        CareerUnlocks.Academy => $"Mở từ khung {Pes17TransferWindows.WinterStart(p.Slots)}",
        _ => "Chưa mở",
    };

    static string Bare(string href) => href.Split('?', '#')[0].TrimEnd('/');
    /// <summary>Khu chứa trang đang xem (sáng ô đó trên thanh dưới, hiện thanh phụ của khu).</summary>
    Zone? ZoneOf(IEnumerable<Zone> zs) { var path = Path; return zs.FirstOrDefault(z => z.Items.Any(i => i.Href is { } h && !i.Hard && Bare(h) == path)); }

    /// <summary>Các khu theo thứ tự ô trên thanh dưới (sau ô Trang chủ). Chưa cầm CLB: chỉ Văn phòng, Hòm thư, Cá nhân.</summary>
    IEnumerable<Zone> Zones()
    {
        var p = P; var m = menu;
        var hasCoach = coach is CoachStatus.Employed or CoachStatus.Unemployed;
        static string Tone(int v, int bad, int warn) => v < bad ? "bad" : v < warn ? "warn" : "ok";
        // Mục theo tính năng mở dần: chưa mở → ổ khoá + điều kiện; vừa mở → chấm "mới".
        MItem F(string label, string icon, string href, string f, string? shortL = null, string? note = null) =>
            new(label, icon, href, p is null || p.Has(f) ? null : LockHint(f, p), Note: note, Fresh: p?.IsNew(f) == true, Feature: f, Short: shortL);

        // Văn phòng HLV
        var office = new List<MItem> { hasCoach ? new("Hồ sơ & năng lực", "badge", "hlv", Short: "Hồ sơ") : new("Tạo hồ sơ HLV", "person_add", "hlv", Short: "Hồ sơ") };
        if (hasCoach) office.Add(new("Hợp đồng", "history_edu", "hlv#hop-dong"));
        if (p is not null)
        {
            office.Add(F("Ban lãnh đạo & nhân sự", "domain", "ban-lanh-dao", CareerUnlocks.Board, "Ban lãnh đạo"));
            office.Add(F("Tài chính CLB", "account_balance", "tai-chinh", CareerUnlocks.Finance, "Tài chính"));
        }
        if (hasCoach) office.Add(new("Việc làm HLV", "work", "hlv/viec-lam", Short: "Việc làm"));
        var (os, ot) = p is not null && p.Has(CareerUnlocks.Board) && m?.Confidence is { } cf ? ($"BLĐ tin {cf}", Tone(cf, BoardRules.ReviewBelow, 45))
            : coach == CoachStatus.Unemployed ? ("Thất nghiệp", "warn") : ((string?)null, "");
        yield return new("office", "Văn phòng HLV", "Văn phòng", "business_center", os, ot, office);

        if (p is not null)
        {
            // Phòng thay đồ
            yield return new("locker", "Đội bóng", "Đội bóng", "groups", m?.Morale is { } mo ? $"Tinh thần {mo}" : null, m?.Morale is { } mt ? Tone(mt, 35, 60) : "",
            [
                new("Đội hình", "groups", "clb"),
                new("Tinh thần & trò chuyện", "forum", "phong-thay-do", Short: "Tinh thần", Note: m is { Injured: > 0 } ? $"{m.Injured} chấn thương" : null),
                F("Tập luyện", "fitness_center", "tap-luyen", CareerUnlocks.Training),
                F("Học viện & trinh sát", "school", "hoc-vien", CareerUnlocks.Academy, "Học viện"),
            ]);

            // Chuyển nhượng
            var open = p.Has(CareerUnlocks.Transfer);
            yield return new("transfer", "Chuyển nhượng", "Chuyển nhượng", "swap_horiz",
                open ? (p.MarketSlotsLeft > 0 ? $"Chợ mở · còn {p.MarketSlotsLeft} khung" : "Chợ đang mở") : LockHint(CareerUnlocks.Transfer, p), open ? "ok" : "info",
            [
                F("Thị trường", "storefront", "chuyen-nhuong", CareerUnlocks.Transfer, note: "Mua, bán cầu thủ"),
                F("Đề nghị", "handshake", "de-nghi", CareerUnlocks.Offers, note: "CLB khác hỏi mua"),
            ]);

            // Giải đấu
            yield return new("league", "Giải đấu", "Giải đấu", "emoji_events", m?.Rank is { } rk ? $"Hạng {rk}/{m.Teams}" : null, "info",
            [
                new("Bảng xếp hạng", "leaderboard", "bxh", Short: "BXH"),
                new("Lịch thi đấu", "calendar_month", "lich", Short: "Lịch"),
                new("Trực tiếp", "live_tv", "truc-tiep", Note: Jobs.LiveFixtureId is not null ? "Đang phát" : "Trận cầu đinh"),   // PO 23/11
                F("Thống kê", "query_stats", "thong-ke", CareerUnlocks.Stats),
                new("Tin tức", "newspaper", "tin", Group: "Xem thêm"),
                new("Bàn thắng & highlight", "movie", "ban-thang", Short: "Bàn thắng", Group: "Xem thêm"),
                new("Vinh danh", "military_tech", "vinh-danh", Group: "Xem thêm"),
                new("Các mùa", "folder_open", "mua", Group: "Xem thêm"),
            ]);
        }

        // Hòm thư & thông báo (gộp chuông cũ)
        var mail = new List<MItem>();
        if (hasCoach) mail.Add(new("Thư HLV", "mail", "thu-hlv", Badge: coachUnread, Note: m is { Pending: > 0 } ? $"{m.Pending} quyết định chờ" : "Quyết định, yêu cầu"));
        if (p is not null)
        {
            mail.Add(new("Việc cần làm & họp báo", "task_alt", "hop-thu", Short: "Việc cần làm"));
            mail.Add(new("Truyền thông", "newspaper", "truyen-thong", Note: "Họp báo, bài báo, album, bên lề"));
            mail.Add(new("Thư ban tổ chức", "campaign", "thu", Badge: unread, Short: "Thư BTC", Note: "Thông báo giải"));
        }
        var unreadAll = (hasCoach ? coachUnread : 0) + (p is not null ? unread : 0);
        if (mail.Count > 0) yield return new("mail", "Hòm thư & thông báo", "Hòm thư", "inbox", unreadAll > 0 ? $"{unreadAll} chưa đọc" : null, "bad", mail, unreadAll);

        // Cá nhân & cài đặt
        string? NoCoach = hasCoach ? null : "Cần hồ sơ HLV";
        const string Life = "Cuộc sống", Set = "Cài đặt";
        var life = new List<MItem>
        {
            new("Ví & mức sống", "account_balance_wallet", "cuoc-song?muc=vi", NoCoach, Note: hasCoach && m?.Stress is { } st ? $"Căng thẳng {st}" : null, Group: Life),
            new("Tài sản", "villa", "cuoc-song?muc=tai-san", NoCoach, Group: Life),
            new("Sổ ví", "receipt_long", "cuoc-song?muc=so-vi", NoCoach, Group: Life),
            new("Album ảnh", "photo_library", "cuoc-song?muc=album", NoCoach, Group: Life),
            new("Ảnh HLV", "photo_camera", "hlv?doi-anh=1", NoCoach, Note: "Đổi ảnh chân dung", Group: Set),
            new("Cài đặt", "settings", "cai-dat", Note: "Âm thanh, mô phỏng", Group: Set),
            new("Máy game", "videogame_asset", "cai-dat#st-pes", Note: "Độ khó, đồ hoạ", Group: Set),
            new("Máy chơi", "dns", "may-choi", Note: "Máy nào đang rảnh", Group: Set),
            new("Điều khiển game", "sports_esports", "dieu-khien", Group: Set),
        };
        if (profile is not null) life.Add(new("Trang người chơi", "person", profile, Group: Set));
        if (admin) life.Add(new("Quản trị", "admin_panel_settings", "admin", Group: Set));
        yield return new("life", "Cá nhân & cài đặt", "Cá nhân", "account_circle", m?.Wallet is { } w ? "Ví " + Fmt.Money(w) : null, m?.Wallet < 0 ? "bad" : "gold", life);
    }

    public void Dispose()
    {
        Mail.Changed -= OnMail;
        Jobs.Changed -= OnJob;
        Nav.LocationChanged -= OnLocation;
    }
}
