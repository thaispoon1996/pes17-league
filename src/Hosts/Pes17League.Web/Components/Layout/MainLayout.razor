@inherits LayoutComponentBase
@inject CurrentUser Me
@inject NavigationManager Nav
@inject MailHub Mail
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Pes17League.Clubs.Infrastructure.ClubsDbContext> Dbs
@inject TimeProvider Clock
@implements IDisposable
<header class="site-header">
    <div class="top-nav">
        <div class="in">
            <nav>
                <a href="">PES 17 League</a>
                <a href="mua">Các mùa</a>
                <a href="tim-kiem"><span class="ms ic" aria-hidden="true">search</span>Tìm kiếm</a>
            </nav>
            @if (admin) { <a class="to-admin" href="admin"><span class="ms ic" aria-hidden="true">settings</span>Quản trị</a> }
            @if (guest)
            {
                <a class="to-login" href="login">Đăng nhập</a> <a class="to-login" href="dang-ky">Đăng ký</a>
            }
            else
            {
                <a class="to-mail" href="thu" title="Hòm thư"><span class="ms ic" aria-hidden="true">mail</span>Thư @if (unread > 0) { <span class="badge">@unread</span> }</a>
                <form method="post" action="/logout" data-enhance="false">@if (profile is not null) { <a class="who" href="@profile">@who</a> } else { <small class="who">@who</small> }<button class="link">Thoát</button></form>
            }
            @* PO 16/11: khách chỉ xem (không còn là admin khi tắt đăng nhập) → hiện link Đăng nhập; admin có lối vào khu quản trị riêng. *@
        </div>
    </div>
    <div class="main-nav">
        <div class="in">
            <a class="brand" href="" aria-label="PES 17 League">
                <svg class="shield" viewBox="0 0 32 36" aria-hidden="true"><path d="M16 1 30 6v11c0 9-6 15-14 18C8 32 2 26 2 17V6z" fill="var(--accent)"/><path d="M16 5 26 8.6V17c0 6.6-4.2 11.2-10 13.6C10.2 28.2 6 23.6 6 17V8.6z" fill="var(--brand)"/><path d="m16 10 1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z" fill="var(--accent)"/></svg>
                <span>PES 17<b>League</b></span></a>
            <nav>
                @* PO 22/11: tập trung career, tạm hoãn chế độ online → ẩn Vòng đấu, Trực tiếp, Giao hữu, Đăng ký giải, Kỷ luật (trang vẫn còn, chỉ bỏ khỏi menu). *@
                <NavLink href="" Match="NavLinkMatch.All">Trang chủ</NavLink>
                <NavLink href="tin">Tin tức</NavLink>
                <NavLink href="lich">Lịch</NavLink>
                <NavLink href="giai">Giải đấu</NavLink>
                <NavLink href="bxh">BXH</NavLink>
                <NavLink href="thong-ke">Thống kê</NavLink>
                <details class="nav-more">
                    <summary>Thêm</summary>
                    <div class="nav-more__menu">
                        @if (player) { <NavLink href="dieu-khien">Điều khiển</NavLink> }
                        <NavLink href="tong-ket">Tổng kết vòng</NavLink>
                        <NavLink href="thi-truong">Thị trường</NavLink>
                        <NavLink href="vinh-danh">Vinh danh</NavLink>
                        <NavLink href="ban-thang">Bàn thắng</NavLink>
                        <NavLink href="so-sanh">So sánh cầu thủ</NavLink>
                        <NavLink href="vai-tro">Vai trò &amp; quyền</NavLink>
                    </div>
                </details>
            </nav>
            @* Điện thoại (PO 17/11): đầu trang 1 tầng — thư + menu ☰ gom mọi mục ngoài thanh đáy. *@
            <div class="m-actions">
                <a class="m-icon" href="tim-kiem" aria-label="Tìm kiếm"><span class="ms ic" aria-hidden="true">search</span></a>
                @if (!guest) { <a class="m-icon" href="thu" aria-label="Hòm thư"><span class="ms ic" aria-hidden="true">mail</span>@if (unread > 0) { <span class="badge">@unread</span> }</a> }
                <details class="m-menu">
                    <summary aria-label="Mở menu"><span></span><span></span><span></span></summary>
                    <div class="m-menu__panel">
                        @if (guest) { <div class="m-menu__auth"><a class="btn primary" href="login">Đăng nhập</a><a class="btn" href="dang-ky">Đăng ký</a></div> }
                        else { <div class="m-menu__who">@if (profile is not null) { <a href="@profile"><span class="ms ic" aria-hidden="true">person</span>@who</a> } else { <span><span class="ms ic" aria-hidden="true">person</span>@who</span> }</div> }
                        <p>Giải đấu</p>
                        @if (!guest) { <NavLink href="bxh"><span class="ms ic" aria-hidden="true">trophy</span>Bảng xếp hạng</NavLink> }
                        <NavLink href="tin"><span class="ms ic" aria-hidden="true">newspaper</span>Tin tức</NavLink>
                        <NavLink href="giai"><span class="ms ic" aria-hidden="true">stadium</span>Giải đấu</NavLink>
                        <NavLink href="thong-ke"><span class="ms ic" aria-hidden="true">bar_chart</span>Thống kê</NavLink>
                        <NavLink href="tong-ket"><span class="ms ic" aria-hidden="true">edit_note</span>Tổng kết vòng</NavLink>
                        <NavLink href="ban-thang"><span class="ms ic" aria-hidden="true">sports_soccer</span>Bàn thắng</NavLink>
                        <NavLink href="vinh-danh"><span class="ms ic" aria-hidden="true">military_tech</span>Vinh danh</NavLink>
                        <NavLink href="mua"><span class="ms ic" aria-hidden="true">folder_open</span>Các mùa</NavLink>
                        <NavLink href="thi-truong"><span class="ms ic" aria-hidden="true">monitoring</span>Thị trường</NavLink>
                        <NavLink href="so-sanh"><span class="ms ic" aria-hidden="true">balance</span>So sánh cầu thủ</NavLink>
                        @if (!guest)
                        {
                            <p>Của tôi</p>
                            <NavLink href="thu"><span class="ms ic" aria-hidden="true">mail</span>Hòm thư @if (unread > 0) { <span class="badge">@unread</span> }</NavLink>
                            @if (player)
                            {
                                <NavLink href="dieu-khien"><span class="ms ic" aria-hidden="true">sports_esports</span>Điều khiển</NavLink>
                            }
                        }
                        <NavLink href="vai-tro">ℹ️ Vai trò &amp; quyền</NavLink>
                        @if (admin) { <a class="m-menu__admin" href="admin"><span class="ms ic" aria-hidden="true">settings</span>Quản trị</a> }
                        @if (!guest) { <form method="post" action="/logout" data-enhance="false"><button class="link">Đăng xuất</button></form> }
                    </div>
                </details>
            </div>
        </div>
    </div>
</header>
<main>@Body</main>
<nav class="bottom-nav" aria-label="Điều hướng nhanh">
    <NavLink href="" Match="NavLinkMatch.All"><i class="ms">home</i>Trang chủ</NavLink>
    @if (guest)
    {
        <NavLink href="tin"><i class="ms">newspaper</i>Tin tức</NavLink>
        <NavLink href="lich"><i class="ms">calendar_month</i>Lịch</NavLink>
        <NavLink href="bxh"><i class="ms">leaderboard</i>BXH</NavLink>
        <a href="login"><i class="ms">person</i>Đăng nhập</a>
    }
    else if (admin)
    {
        @* PO 17/11: admin = Ban tổ chức, không có CLB/giao hữu để chơi *@
        <NavLink href="tin"><i class="ms">newspaper</i>Tin tức</NavLink>
        <NavLink href="lich"><i class="ms">calendar_month</i>Lịch</NavLink>
        <NavLink href="bxh"><i class="ms">leaderboard</i>BXH</NavLink>
        <a href="admin"><i class="ms">settings</i>Quản trị</a>
    }
    else
    {
        @* PO 22/11: chỉ còn career → chưa cầm CLB thì lối chính là Sự nghiệp (bắt đầu/tìm việc) *@
        <NavLink href="su-nghiep"><i class="ms">sports</i>Sự nghiệp</NavLink>
        <NavLink href="tin"><i class="ms">newspaper</i>Tin tức</NavLink>
        <NavLink href="lich"><i class="ms">calendar_month</i>Lịch</NavLink>
        <NavLink href="bxh"><i class="ms">leaderboard</i>BXH</NavLink>
    }
</nav>
<div id="blazor-error-ui">Có lỗi xảy ra. <a href="" class="reload">Tải lại</a></div>

@code {
    bool admin, guest, coach;   // coach = người chơi đang cầm CLB (PO 17/11: chưa có CLB thì ẩn CLB/Quản lý/Chuyển nhượng)
    bool player => !guest && !admin;   // PO 17/11: admin không có mục của người chơi (CLB, chuyển nhượng, điều khiển, đăng ký giải)
    string? who, profile;
    Guid? me;
    int unread;

    protected override async Task OnInitializedAsync()
    {
        admin = await Me.IsAdminAsync();
        guest = await Me.IsGuestAsync();
        who = await Me.NameAsync();   // tên hiển thị cạnh nút Thoát (admin/HLV)
        me = await Me.ManagerIdAsync();
        if (!guest && (me is not null || admin)) { Mail.Changed += OnMail; await CountAsync(); }
        if (me is { } mid)
        {
            await using var db = await Dbs.CreateDbContextAsync();
            coach = await new FriendlyService(db, Clock).ClubOfAsync(mid) is not null;
        }
        if (me is not null) profile = "nguoi-choi/" + await Me.UsernameAsync();   // hồ sơ người chơi (16/11)
        // Phân quyền (PO 16/11): điều hướng trong Blazor không qua middleware → khách bấm link trang người chơi thì đưa sang đăng nhập
        if (guest) { Nav.LocationChanged += OnLocation; Guard(Nav.Uri); }
    }

    void OnLocation(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Guard(e.Location);

    void Guard(string uri)
    {
        var path = "/" + Nav.ToBaseRelativePath(uri).Split('?', '#')[0];
        if (CurrentUser.PlayerOnly(path)) Nav.NavigateTo("/login?ve=" + Uri.EscapeDataString(path), forceLoad: true);
    }

    async Task CountAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        unread = await new MailService(db, Clock).UnreadAsync(me);
    }

    void OnMail() => InvokeAsync(async () => { await CountAsync(); StateHasChanged(); });

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocation;
        Mail.Changed -= OnMail;
    }
}
