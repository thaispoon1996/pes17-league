@page "/admin/cau-thu/moi"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@using Pes17League.OptionFile
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject TimeProvider Clock
@inject NavigationManager Nav

@* Bước 3c phần 2 (A8, PO chọn 06/11): tạo cầu thủ ở ô 32768–32951 của patch mùa đang mở → cầu thủ tự do trên thị trường.
   Chỉ số gợi ý = trung vị cầu thủ patch cùng vị trí; đổi vị trí thì gợi ý lại các ô chưa sửa tay. Vào game từ OF vòng sau, không có ảnh mặt. *@
<h1>Tạo cầu thủ</h1>
<p><a href="admin/cau-thu">← Danh sách cầu thủ</a></p>
@if (msg is not null) { <p class="msg">@msg</p> }
@if (free is null || template is null) { return; }

<div class="panel">
    <h2>Cầu thủ mới</h2>
    <p class="muted">Còn <b>@free</b>/@OptionFileImage.EditCount ô tạo cầu thủ (ô PES @OptionFileImage.FirstEditId–@(OptionFileImage.FirstEditId + OptionFileImage.EditCount - 1)) trong patch của mùa đang mở.</p>
    @if (free == 0) { <p class="warn">Hết ô: xoá hẳn cầu thủ tạo mới chưa từng ra sân/thuộc CLB để lấy lại ô.</p> }
    else
    {
    <div class="fields">
        <label>Tên (web + trong game) <input @bind="form.Name" @bind:event="oninput" maxlength="40" /></label>
        <label>Vị trí <select @bind="form.Position" @bind:after="PositionChanged">@foreach (var p in Enum.GetValues<Position>()) { <option value="@p">@p</option> }</select></label>
        <label>Năm sinh <input type="number" @bind="form.BirthYear" min="1900" placeholder="—" /></label>
        <label>Quốc tịch (mã trong game) <input @bind="form.Nationality" maxlength="3" placeholder="VIE" list="nations" /></label>
        <datalist id="nations">@foreach (var n in GameText.Nations.Distinct()) { <option value="@n" /> }</datalist>
    </div>
    var game = GameText.ToDisplayable(form.Name ?? "");
    <p class="muted">
        Tên trong game: <b class="@(game.Length > OptionFileImage.MaxNameLength ? "warn" : "")">@game</b> (@game.Length/@OptionFileImage.MaxNameLength ký tự),
        tên in áo: <b>@GameText.ShirtName(form.Name ?? "")</b>. Thành cầu thủ tự do trên thị trường, CLB mua theo giá.
        Trong game từ OF vòng sau: vị trí đá được = vị trí đăng ký; quốc tịch theo mã (không có trong game → Tự do); có năm sinh thì tuổi = năm hiện tại − năm sinh (thay AGE); chân thuận, kỹ năng đặc biệt, ngoại hình như ô mẫu của game; không có ảnh mặt.
    </p>
    }
</div>

<div class="panel">
    <h2>Chỉ số</h2>
    <p class="muted">OVR <b>@price.Overall(form.Position, values)</b>. Số nhỏ = gợi ý (trung vị cầu thủ patch vị trí @form.Position); đổi vị trí thì gợi ý lại các ô chưa sửa.</p>
    <div class="attrs">
        @foreach (var f in PlayerField.Verified)
        {
            var (min, max) = PlayerAdminService.Range(f);
            <label class="@(values[f.Name] != template[f.Name] ? "changed" : "")">
                <span>@f.Name</span>
                <input type="number" min="@min" max="@max" @bind="values[f.Name]" />
                <small>@template[f.Name]</small>
            </label>
        }
    </div>
    <div class="actions">
        <button class="primary" @onclick="Create">Tạo cầu thủ</button>
        <button @onclick="Reset">Về gợi ý</button>
    </div>
</div>

@code {
    int? free;
    IReadOnlyDictionary<string, int>? template;
    Dictionary<string, int> values = [];
    readonly Form form = new();
    readonly PriceModel price = new();
    string? msg;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        var svc = new PlayerAdminService(db, Clock);
        try { (free, template) = (await svc.FreeSlotsAsync(), await svc.TemplateAsync(form.Position)); }
        catch (AdminRuleException e) { msg = e.Message; return; }
        Reset();
    }

    void Reset() => values = new(template!);

    async Task PositionChanged()
    {
        var old = template!;
        await using var db = await Dbs.CreateDbContextAsync();
        try { template = await new PlayerAdminService(db, Clock).TemplateAsync(form.Position); }
        catch (AdminRuleException e) { msg = e.Message; return; }
        foreach (var f in PlayerField.Verified)
            if (values[f.Name] == old[f.Name]) values[f.Name] = template[f.Name];
    }

    async Task Create()
    {
        msg = null;
        Guid id;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            id = await new PlayerAdminService(db, Clock).CreateAsync(form.Input(), values, AdminText.Actor);
        }
        catch (AdminRuleException e) { msg = e.Message; return; }
        Nav.NavigateTo($"admin/cau-thu/{id}");
    }

    sealed class Form
    {
        public string? Name { get; set; }
        public Position Position { get; set; } = Position.CF;
        public int? BirthYear { get; set; }
        public string? Nationality { get; set; }

        public PlayerInput Input() => new(Name ?? "", Position, BirthYear, Nationality);
    }
}
