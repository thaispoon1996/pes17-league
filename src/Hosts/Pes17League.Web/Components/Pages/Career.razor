    bool wasRunning;
    void OnJob() => InvokeAsync(async () =>
    {
        if (wasRunning != Jobs.Running || (Jobs.Log.LastOrDefault() ?? "").Contains("xong")) await LoadAsync();   // trận xong / máy rảnh → đọc lại
        wasRunning = Jobs.Running;
        StateHasChanged();
    });

    public void Dispose() => Jobs.Changed -= OnJob;

    async Task OpenLeague(string name)
    {
        if (seasonId is not { } sid) return;
        try { detail = await Q.CareerLeagueAsync(sid, name, Store, Clock); }
        catch (Exception ex) { error = $"Không mở được chi tiết {name}: {ex.Message}"; }
        if (detail is null) Pick(name);
    }

    void Pick(string name)
    {
        detail = null;
        league = name;
        pick = null;
        step = 2;
    }

    /// <summary>PO 19/11: chọn CLB = ứng tuyển → thương lượng với chủ tịch → ký → họp báo ra mắt.</summary>
    async Task Apply(CareerClubChoice c)
    {
        if (coach is null || pendingSeason is null || !jobRows.TryGetValue(c.ClubId, out var row) || applying) return;
        applying = true; error = null;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var (app, err) = await new CoachJobService(db, Clock, Store).OpenAsync(coach, pendingSeason, row);
            if (app is null) { error = err; return; }
            appId = app.Id; pick = c; clubDetail = null; step = 3;
            if (Shell is not null) await Shell.RefreshMailAsync();
        }
        finally { applying = false; }
    }

    async Task CoachDone() { await LoadAsync(); if (Shell is not null) { await Shell.RefreshAsync(); await Shell.RefreshMailAsync(); } }

    void Signed() => Nav.NavigateTo("hlv?ra-mat=1", forceLoad: true);

    async Task Start()
    {
        if (pick is null || me is null || starting) return;
        starting = true;
        error = null;
        StateHasChanged();
        await Task.Yield();   // vẽ cảnh ra mắt trước khi dựng mùa
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            await new Pes17CareerService(db, Store, Clock).StartAsync(pick.ClubId, me, Random.Shared.Next(1, 10_000), $"career:{me}");
            Nav.NavigateTo("su-nghiep", forceLoad: true);
        }
        catch (AdminRuleException e) { error = e.Message; }
        finally { starting = false; }
    }
