    static string Range(int from, int count) => count == 1 ? $"{from}" : $"{from}–{from + count - 1}";
    static int CardTier(int ovr) => ovr >= 88 ? 3 : ovr >= 82 ? 2 : ovr >= 75 ? 1 : 0;

    IEnumerable<CareerClubChoice> LeagueClubs => choices.Where(c => c.League == league).OrderByDescending(c => c.Ovr);

    string MarketLine => current is null ? "Mùa giải đã xong"
        : marketOpen ? $"Chợ chuyển nhượng mở · còn {marketLeft} khung"
        : marketNext is { } mn ? $"Chợ mở lại ở khung {mn}" : "Chợ đã đóng tới hết mùa";

    /// <summary>Trang chưa mở khoá trong career → không gắn link (thẻ vẫn hiện số liệu).</summary>
    string? Open(string href) => Shell?.CanOpen(href) == false ? null : href;

    static string MoodWord(int m) => m >= 80 ? "Hưng phấn" : m >= 60 ? "Vui vẻ" : m >= 35 ? "Bình thường" : "Chán nản";

    string WhenLine(NextMatch n) => current is not { } c ? ""
        : n.Slot > c.Number ? $"Khung {n.Slot} · còn {n.Slot - c.Number} khung nữa"
        : c.MineFixture is null ? $"Khung {n.Slot} · trợ lý dẫn đội trận này"
        : $"Khung {n.Slot} · đến lượt bạn: vào trận hoặc mô phỏng" + (c.BotLeft > 0 ? $" · {c.BotLeft} trận khác tự mô phỏng sau" : "");   // PO 20/11: đá trước, tự mô phỏng sau

    string RankNote(int pos) => prevPos is { } pp
        ? pp == pos ? "Giữ hạng sau vòng vừa qua" : pp > pos ? $"▲ {pp - pos} bậc sau vòng vừa qua" : $"▼ {pos - pp} bậc sau vòng vừa qua"
        : board is { } b ? $"Kỳ vọng hạng {b.ExpectedPosition}" : $"{table.FirstOrDefault(r => r.Mine)?.Pts ?? 0} điểm";

    static int Stars(double ovr) => Math.Clamp((int)Math.Round((ovr - 64) / 3), 1, 5);

    (string Label, string Css) Difficulty(CareerClubChoice c)
    {
        var list = LeagueClubs.ToList();
        var rank = list.IndexOf(c);
        return rank < Math.Max(1, list.Count / 5) ? ("Ứng viên vô địch", "ok") : rank < list.Count / 2 ? ("Tầm trung", "") : ("Thử thách", "bad");
    }

    string Objective(CareerClubChoice c) => BoardRules.Objective(ExpectedPos(c), choices.Count(x => x.League == c.League));

    /// <summary>Hạng kỳ vọng = hạng giá trị đội hình trong giải (như BoardService).</summary>
    int ExpectedPos(CareerClubChoice c) => choices.Where(x => x.League == c.League).OrderByDescending(x => x.SquadValue).ToList().IndexOf(c) + 1;

    /// <summary>Bước 2: bảng chi tiết CLB đang mở (PO 19/11).</summary>
    CareerClubInfo? clubDetail;
    static string LineName(PositionGroup g) => g switch { PositionGroup.Goalkeeper => "Thủ môn", PositionGroup.Defender => "Hậu vệ", PositionGroup.Midfielder => "Tiền vệ", _ => "Tiền đạo" };
    /// <summary>Thanh OVR: 50 → 0%, 95 → 100%.</summary>
    static string Pct(double ovr) => Math.Clamp((ovr - 50) / 45 * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    async Task OpenClub(CareerClubChoice c)
    {
        if (seasonId is not { } sid) return;
        try { clubDetail = await Q.CareerClubAsync(sid, c.ClubId, Store, Clock); }
        catch (Exception ex) { error = $"Không mở được chi tiết {c.Name}: {ex.Message}"; }
        if (clubDetail is null) await Apply(c);
    }

    protected override async Task OnInitializedAsync()
    {
        Jobs.Changed += OnJob;
        me = await Me.ManagerIdAsync();
        await LoadAsync();
        loaded = true;
    }

    async Task LoadAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        if (me is { } mid)
        {
            coach = await db.Coaches.AsNoTracking().SingleOrDefaultAsync(c => c.ManagerId == mid);
            contract = coach is null ? null : await db.CoachContracts.AsNoTracking().FirstOrDefaultAsync(k => k.CoachId == coach.Id && k.Status == CoachContractStatus.Active);
        }
        if (me is { } id)
        {
            var mine = await (from a in db.TeamAssignments join c in db.Clubs on a.ClubId equals c.Id
                              where a.ParticipantId == id && a.To == null && a.ControllerType == ControllerType.Human select new { c.Id, c.Name, c.LogoPath }).FirstOrDefaultAsync();
            if (mine is not null)
            {
                club = mine.Name;
                clubId = mine.Id;
                budget = await db.Ledger.Where(e => e.ClubId == mine.Id).SumAsync(e => e.Amount);
                await new TransferOfferService(db, Clock).ExpireStaleAsync();
                var season = await db.Seasons.Where(s => s.Status == SeasonStatus.Active).OrderBy(s => s.Number).FirstOrDefaultAsync()
                    ?? await db.Seasons.Where(s => s.Status == SeasonStatus.Finished).OrderByDescending(s => s.Number).FirstOrDefaultAsync();
                seasonName = season?.Name;
                if (season is not null) await LoadClubAsync(db, season.Id, mine.Id);
                champion = [.. cups.Where(c => c.State.Contains("Vô địch")).Select(c => c.Name)];
                canNext = false;
                if (season?.Status == SeasonStatus.Finished && myPos == 1 && leagueName is not null) champion.Insert(0, leagueName);
                if (season?.Status == SeasonStatus.Finished)
                    canNext = await new SeasonRolloverService(db, Store, Clock).ReadyAsync() is not null
                        || await new Pes17CareerService(db, Store, Clock).PendingSeasonAsync() is { Number: > 1 };
                return;
            }
        }
        club = null;
        var career = new Pes17CareerService(db, Store, Clock);
        var pending = await career.PendingSeasonAsync();
        seasonId = pending?.Id;
        pendingSeason = pending;
        activeSeason = await db.Seasons.AnyAsync(s => s.Status == SeasonStatus.Active);
        if (pending is null)
        {
            canNext = !activeSeason && (await new SeasonRolloverService(db, Store, Clock).ReadyAsync() is not null);
            return;
        }
        seasonName = pending.Name;
        firstSeason = pending.Number == 1;
        taken = await career.HasCoachAsync();
        if (taken) return;
        choices = await career.ChoicesAsync(pending.Id);
        if (coach is { Status: not CoachStatus.Creating } cc)
            jobRows = (await new CoachJobService(db, Clock, Store).ClubsAsync(cc, pending.Id, choices)).ToDictionary(r => r.ClubId);
        leagueLogos = (await Q.EditionsAsync(pending.Id)).Where(e => e.Type == CompetitionType.DomesticLeague).GroupBy(e => e.Name).ToDictionary(g => g.Key, g => g.First().Logo);
    }

    async Task LoadClubAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        var fixtures = await (from f in db.Fixtures join m in db.Matchdays on f.MatchdayId equals m.Id
                              join e in db.Editions on f.CompetitionEditionId equals (Guid?)e.Id join comp in db.Competitions on e.CompetitionId equals comp.Id
                              join h in db.Clubs on f.HomeClubId equals h.Id join w in db.Clubs on f.AwayClubId equals w.Id
                              where m.SeasonId == seasonId && (f.HomeClubId == mineId || f.AwayClubId == mineId)
                              orderby m.Number
                              select new { F = f, Slot = m.Number, EditionId = e.Id, Comp = comp.Name, CompLogo = comp.LogoPath, comp.Type, Home = h.Name, HomeLogo = h.LogoPath, Away = w.Name, AwayLogo = w.LogoPath })
            .AsNoTracking().ToListAsync();
        string Label(string comp, FixtureStage stage, int? leg) => stage == FixtureStage.League ? comp : $"{comp} · {AdminText.SlotKind(stage, leg)}";

        next = fixtures.Where(x => x.F.Status != FixtureStatus.Played)
            .Select(x => new NextMatch(x.F.Id, x.Home, x.HomeLogo, x.F.HomeClubId, x.Away, x.AwayLogo, x.F.AwayClubId, Label(x.Comp, x.F.Stage, x.F.Leg), x.Slot)).FirstOrDefault();

        var played = fixtures.Where(x => x.F.Status == FixtureStatus.Played && x.F.HomeGoals is not null).ToList();
        upcoming = [.. fixtures.Where(x => x.F.Status != FixtureStatus.Played).Skip(1).Take(3).Select(x =>
        {
            var home = x.F.HomeClubId == mineId;
            return new Upcoming(x.F.Id, x.Slot, home ? x.Away : x.Home, home ? x.AwayLogo : x.HomeLogo, home, Label(x.Comp, x.F.Stage, x.F.Leg));
        })];
        var last = played.LastOrDefault();
        lastFixtureId = last?.F.Id;
        lastSlot = last?.Slot;
        since = played.Count > 1 ? played[^2].F.PlayedAt : null;
        lastWasLeague = last is { Type: CompetitionType.DomesticLeague } && last.F.Stage == FixtureStage.League;
        string Result(Fixture f) => f.WinnerClubId() is { } w ? (w == mineId ? "W" : "L") : f.HomeGoals == f.AwayGoals ? "D" : (f.HomeGoals > f.AwayGoals) == (f.HomeClubId == mineId) ? "W" : "L";
        tally = (played.Count(x => Result(x.F) == "W"), played.Count(x => Result(x.F) == "D"), played.Count(x => Result(x.F) == "L"));
        recent = [.. played.TakeLast(6).Select(x =>
        {
            var home = x.F.HomeClubId == mineId;
            return new ResultRow(x.F.Id, Label(x.Comp, x.F.Stage, x.F.Leg), home ? x.Away : x.Home, home ? x.AwayLogo : x.HomeLogo, home,
                home ? Fmt.Score(x.F.HomeGoals, x.F.AwayGoals, x.F.HomePenalties, x.F.AwayPenalties) : Fmt.Score(x.F.AwayGoals, x.F.HomeGoals, x.F.AwayPenalties, x.F.HomePenalties),
                Result(x.F));
        })];

        // Giải quốc nội: vị trí + bảng
        var league = await (from x in db.EditionClubs join e in db.Editions on x.EditionId equals e.Id join c in db.Competitions on e.CompetitionId equals c.Id
                            where e.SeasonId == seasonId && x.ClubId == mineId && c.Type == CompetitionType.DomesticLeague select new { e.Id, c.Name }).FirstOrDefaultAsync();
        if (league is not null)
        {
            leagueName = league.Name;
            var rows = await new CompetitionService(db, Store, Clock).GetEditionStandingsAsync(league.Id);
            var ids = rows.Select(r => r.Club).ToList();
            var names = await db.Clubs.Where(c => ids.Contains(c.Id)).ToDictionaryAsync(c => c.Id, c => new { c.Name, c.LogoPath });
            table = [.. rows.Select((r, i) => new TableRow(i + 1, names[r.Club].Name, names[r.Club].LogoPath, r.Played, r.GoalDifference, r.Points, r.Club == mineId))];
            myPos = table.FirstOrDefault(r => r.Mine)?.Pos;
            myPlayed = table.FirstOrDefault(r => r.Mine)?.P ?? 0;
            leagueEdition = league.Id;
            // Hạng trước vòng vừa qua (chỉ khi trận vừa rồi là trận giải): tính lại BXH bỏ các trận giải từ khung đó trở đi.
            prevPos = null;
            if (lastWasLeague && lastSlot is { } ls && myPlayed > 1)
            {
                var before = await (from f in db.Fixtures join m in db.Matchdays on f.MatchdayId equals m.Id
                                    where f.CompetitionEditionId == league.Id && f.Status == FixtureStatus.Played && f.Stage == FixtureStage.League && f.HomeGoals != null && m.Number < ls
                                    select new PlayedFixture<Guid>(f.HomeClubId, f.AwayClubId, f.HomeGoals!.Value, f.AwayGoals!.Value)).ToListAsync();
                var prior = Pes17League.Clubs.Domain.Standings.Compute(ids, before, id => names[id].Name, SanctionService.For(await SanctionService.DeductionsAsync(db), league.Id));
                var idx = prior.ToList().FindIndex(r => r.Club == mineId);
                prevPos = idx >= 0 ? idx + 1 : null;
            }
        }

        // Cúp: đang dự / bị loại / vô địch
        var cupEditions = fixtures.Where(x => x.Type != CompetitionType.DomesticLeague).GroupBy(x => (x.EditionId, x.Comp, x.CompLogo)).ToList();
        var editionIds = cupEditions.Select(g => g.Key.EditionId).ToList();
        var stages = (await db.Fixtures.Where(f => f.CompetitionEditionId != null && editionIds.Contains(f.CompetitionEditionId.Value))
                .Select(f => new { Edition = f.CompetitionEditionId!.Value, f.Stage }).Distinct().ToListAsync())   // Stage lưu dạng chuỗi → so thứ tự ở client
            .GroupBy(x => x.Edition).ToDictionary(g => g.Key, g => g.Max(x => x.Stage));
        cups = [.. cupEditions.Select(g =>
        {
            var open = g.FirstOrDefault(x => x.F.Status != FixtureStatus.Played);
            if (open is not null) return new CupRow(g.Key.Comp, $"Đang dự · {AdminText.SlotKind(open.F.Stage, open.F.Leg)}", g.Key.CompLogo);
            var last = g.Last().F;
            if (last.Stage == FixtureStage.Final) return new CupRow(g.Key.Comp, last.WinnerClubId() == mineId ? "Vô địch" : "Á quân", g.Key.CompLogo);
            return stages.GetValueOrDefault(g.Key.EditionId) > last.Stage
                ? new CupRow(g.Key.Comp, $"Bị loại · {AdminText.Stage(last.Stage)}", g.Key.CompLogo)
                : new CupRow(g.Key.Comp, $"Chờ vòng sau (đã đá {AdminText.Stage(last.Stage)})", g.Key.CompLogo);
        })];

        slots = await db.Matchdays.CountAsync(m => m.SeasonId == seasonId);
        var md = await new Pes17CareerService(db, Store, Clock).OpenMatchdayAsync(seasonId);
        current = null;
        if (md is not null)
        {
            var left = await db.Fixtures.Where(f => f.MatchdayId == md.Id && f.Status != FixtureStatus.Played)
                .Select(f => new { f.Id, Mine = (f.HomeClubId == mineId || f.AwayClubId == mineId) && !f.AssistantPlays }).ToListAsync();
            current = new Current(md.Id, md.Number, left.Count(x => !x.Mine), left.FirstOrDefault(x => x.Mine)?.Id);
        }

        // Chợ chuyển nhượng
        var window = await new FreeMarketService(db, Clock).WindowAsync(seasonId);
        marketOpen = window is not null && window.IsOpenAt(Clock.GetUtcNow());
        var at = Math.Max(current?.Number ?? slots, 1);
        marketLeft = marketOpen ? CareerUnlocks.MarketSlotsLeft(at, slots) : null;
        marketNext = marketOpen ? null : CareerUnlocks.NextMarketSlot(at, slots);

        board = await new BoardService(db, Clock).StatusAsync(seasonId, mineId);
        await LoadNextAsync(db, seasonId);
        await LoadStarAsync(db, seasonId, mineId);
        await LoadDeskAsync(db, seasonId, mineId);
        await LoadFeedAsync(db, seasonId, mineId);
    }

    /// <summary>OVR (TB 11 người cao nhất) và phong độ 5 trận của 2 đội trận tới.</summary>
    async Task LoadNextAsync(ClubsDbContext db, Guid seasonId)
    {
        if (next is not { } n) return;
        Guid[] both = [n.HomeId, n.AwayId];
        var ovrs = (await (from m in db.SquadMemberships join p in db.PlayerPrices on m.PlayerId equals p.PlayerId
                           where m.LeftAt == null && p.SeasonId == seasonId && both.Contains(m.ClubId) select new { m.ClubId, p.Overall }).ToListAsync())
            .GroupBy(x => x.ClubId).ToDictionary(g => g.Key, g => g.Select(x => x.Overall).OrderDescending().Take(11).DefaultIfEmpty(0).Average());
        var games = await (from f in db.Fixtures join m in db.Matchdays on f.MatchdayId equals m.Id
                           where m.SeasonId == seasonId && f.Status == FixtureStatus.Played && f.HomeGoals != null
                                 && (both.Contains(f.HomeClubId) || both.Contains(f.AwayClubId))
                           orderby m.Number descending
                           select f).AsNoTracking().ToListAsync();
        string Form(Guid club) => string.Concat(games.Where(f => f.HomeClubId == club || f.AwayClubId == club).Take(5).Reverse().Select(f =>
            f.WinnerClubId() is { } w ? (w == club ? 'W' : 'L') : f.HomeGoals == f.AwayGoals ? 'D' : (f.HomeGoals > f.AwayGoals) == (f.HomeClubId == club) ? 'W' : 'L'));
        n.HomeOvr = ovrs.TryGetValue(n.HomeId, out var ho) ? ho.ToString("0") : "–";
        n.AwayOvr = ovrs.TryGetValue(n.AwayId, out var ao) ? ao.ToString("0") : "–";
        n.HomeForm = Form(n.HomeId);
        n.AwayForm = Form(n.AwayId);
    }

    /// <summary>Ngôi sao của đội: ghi nhiều bàn nhất mùa này, chưa ai ghi bàn thì OVR cao nhất.</summary>
    async Task LoadStarAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        var squad = await (from m in db.SquadMemberships join p in db.Players on m.PlayerId equals p.Id join pr in db.PlayerPrices on p.Id equals pr.PlayerId
                           where m.ClubId == mineId && m.LeftAt == null && pr.SeasonId == seasonId
                           select new { p.Id, p.Name, p.Position, pr.Overall }).ToListAsync();
        if (squad.Count == 0) { star = null; return; }
        var ids = squad.Select(s => s.Id).ToList();
        var goals = await (from g in db.Goals join f in db.Fixtures on g.FixtureId equals f.Id join m in db.Matchdays on f.MatchdayId equals m.Id
                           where m.SeasonId == seasonId && g.ClubId == mineId && g.ScorerPlayerId != null && ids.Contains(g.ScorerPlayerId.Value)
                           group g by g.ScorerPlayerId into k select new { Id = k.Key!.Value, N = k.Count() }).ToDictionaryAsync(x => x.Id, x => x.N);
        var top = goals.Count > 0
            ? squad.OrderByDescending(s => goals.GetValueOrDefault(s.Id)).ThenByDescending(s => s.Overall).First()
            : squad.OrderByDescending(s => s.Overall).First();
        var values = await db.PlayerAttributes.Where(a => a.PlayerId == top.Id && a.SeasonId == seasonId).Select(a => a.Values).FirstOrDefaultAsync() ?? [];
        int V(string k) => values.GetValueOrDefault(k);
        IReadOnlyList<(string, int, bool)> attrs = top.Position == Position.GK
            ? [("Bắt bóng", V("GOAL KEEPING"), false), ("Phản xạ", V("PES17_REFLEXES"), true), ("Giữ bóng", V("PES17_CATCHING"), false), ("Phá bóng", V("PES17_CLEARING"), true), ("Bật nhảy", V("JUMP"), false)]
            : [("Tốc", V("TOP SPEED"), true), ("Sút", V("SHOT ACCURACY"), false), ("Chuyền", V("SHORT PASS ACCURACY"), true), ("Rê", V("DRIBBLE ACCURACY"), false), ("Thể lực", V("STAMINA"), true)];
        var n = goals.GetValueOrDefault(top.Id);
        star = new Star(top.Id, top.Name, top.Position.ToString(), top.Overall, top.Overall >= 88 ? 3 : top.Overall >= 82 ? 2 : top.Overall >= 75 ? 1 : 0,
            n > 0 ? $"Ghi {n} bàn mùa này" : "OVR cao nhất đội", attrs);
    }

    /// <summary>Cần xử lý: mục mới mở khoá, thư HLV cần quyết định (theo hạn), việc và cảnh báo từ bàn làm việc (MediaService), thư chưa đọc.
    /// Mục trỏ tới tính năng chưa mở thì đưa về trang gần nhất.</summary>
    async Task LoadDeskAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        var p = Shell?.P;
        string? Gate(string? link) => link switch
        {
            null => null,
            "tap-luyen" when p is not null && !p.Has(CareerUnlocks.Training) => null,
            "tai-chinh" when p is not null && !p.Has(CareerUnlocks.Finance) => null,
            "ban-lanh-dao" when p is not null && !p.Has(CareerUnlocks.Board) => null,
            "chuyen-nhuong" when p is not null && !p.Has(CareerUnlocks.Transfer) => "clb",
            _ => link,
        };
        static string Icon(InboxItem i) => i.Link switch
        {
            "de-nghi" => "handshake",
            "tap-luyen" when i.Kind == InboxKind.Task => "fitness_center",
            "tap-luyen" => "healing",
            "chuyen-nhuong" => "contract_edit",
            "tai-chinh" => "account_balance",
            "ban-lanh-dao" => "domain",
            _ when i.Title.Contains("Họp báo") => "mic",
            _ when i.Title.Contains("mệt") => "battery_alert",
            _ when i.Title.Contains("không vui") => "sentiment_dissatisfied",
            _ => i.Kind == InboxKind.Info ? "pending_actions" : "assignment",
        };

        var desk = await new MediaService(db, Clock).DeskAsync(seasonId, mineId);
        squadMorale = desk.Squad.Count == 0 ? null : (int)Math.Round(desk.Squad.Average(s => s.Morale));
        fanMood = desk.FanMood;
        desk_ = desk;
        todo = [];
        newFeature = p?.Unlocked.Where(p.IsNew).OrderBy(f => CareerUnlocks.Introduced.ToList().IndexOf(f)).LastOrDefault();
        if (newFeature is { } nf && CareerLayout.Intros.TryGetValue(nf, out var nfo))
            todo.Add(new("lock_open", "gold", "Mới mở khoá: " + nfo.Title, nfo.Text, nfo.Href, "Mới"));

        if (coach is { Status: not CoachStatus.Creating } co)
        {
            var now = await CoachService.NowTickAsync(db);
            var waiting = await db.CoachLetters.AsNoTracking().Where(l => l.CoachId == co.Id && l.Kind == LetterKind.Decision && l.Chosen == null && !l.Archived)
                .OrderBy(l => l.DeadlineTick).ToListAsync();
            foreach (var l in waiting)
            {
                int? left = l.DeadlineTick is { } d && d / 100 == now / 100 && d > now ? d - now : null;
                todo.Add(new("gavel", left is <= 1 ? "red" : "gold", l.Subject, "Thư từ " + l.Sender, $"thu-hlv?thu={l.Id}", left is { } n ? $"Còn {n} vòng" : "Cần quyết định"));
            }
            var unread = await db.CoachLetters.CountAsync(l => l.CoachId == co.Id && !l.Outgoing && !l.Read && !l.Archived && !(l.Kind == LetterKind.Decision && l.Chosen == null));
            if (unread > 0) todo.Add(new("mail", "cyan", $"{unread} thư chưa đọc", "Hòm thư HLV", "thu-hlv", null));
        }

        // Việc trước, cảnh báo sau; "Chuẩn bị vòng" đã có ở thẻ trận tiếp theo; tin (báo cáo, bài báo, BLĐ) sang Vòng vừa qua / ô chỉ số.
        foreach (var i in desk.Inbox.Where(i => i.Kind == InboxKind.Task && !(i.Link ?? "").StartsWith("chuan-bi")))
            todo.Add(new(Icon(i), "gold", i.Title, i.Body, Gate(i.Link) ?? "hop-thu", null));
        foreach (var i in desk.Inbox.Where(i => i.Kind == InboxKind.Warning))
            todo.Add(new(Icon(i), "red", i.Title, i.Body, Gate(i.Link) ?? "phong-thay-do", null));
        foreach (var i in desk.Inbox.Where(i => i.Kind == InboxKind.Info && i.Link is null))
            todo.Add(new(Icon(i), "cyan", i.Title, i.Body, "clb", null));
    }

    MediaDesk? desk_;

    /// <summary>Vòng vừa qua: kết quả + bài báo trận vừa rồi, đổi hạng, chỉ số cầu thủ, báo cáo tài chính, học viện, chuyển nhượng trong giải —
    /// tính từ sau trận trước của đội (since). Không có gì thật thì không thêm dòng.</summary>
    async Task LoadFeedAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        feed = [];
        if (lastFixtureId is not { } lf || recent.LastOrDefault() is not { } r || r.Id != lf) return;
        var (word, tone) = r.Result switch { "W" => ("Thắng", "green"), "L" => ("Thua", "red"), _ => ("Hoà", "gold") };
        feed.Add(new("sports_soccer", tone, $"{word} {r.Score} {(r.Home ? "trước" : "trên sân")} {r.Opponent}", r.Competition + (r.Home ? " · sân nhà" : " · sân khách"), $"tran/{r.Id}"));
        var art = await db.MatchArticles.Where(a => a.FixtureId == lf).OrderByDescending(a => a.PublishedAt).Select(a => new { a.Id, a.Title }).FirstOrDefaultAsync();
        if (art is not null) feed.Add(new("newspaper", "cyan", art.Title, "Bài báo sau trận", $"tin/{art.Id}"));

        if (prevPos is { } pp && myPos is { } mp)
        {
            var pts = table.FirstOrDefault(t => t.Mine)?.Pts ?? 0;
            feed.Add(pp == mp ? new("trending_flat", "cyan", $"Giữ hạng {mp}", $"{pts} điểm sau {myPlayed} trận", Open("bxh"))
                : new(pp > mp ? "trending_up" : "trending_down", pp > mp ? "green" : "red", pp > mp ? $"Lên hạng {mp}" : $"Tụt xuống hạng {mp}",
                    $"Trước vòng này hạng {pp} · {pts} điểm sau {myPlayed} trận", Open("bxh")));
        }

        var moves = await (from a in db.AttributeChanges join p in db.Players on a.PlayerId equals p.Id
                           join m in db.SquadMemberships on a.PlayerId equals m.PlayerId
                           where a.SeasonId == seasonId && m.ClubId == mineId && m.LeftAt == null && a.Source != AttributeChangeSource.Admin && (since == null || a.At > since)
                           group a by new { p.Id, p.Name } into g select new { g.Key.Name, D = g.Sum(x => x.Delta) }).ToListAsync();
        string Who(IEnumerable<(string Name, int D)> xs, int n) => "Tổng điểm chỉ số: " + string.Join(", ", xs.Take(3).Select(x => $"{x.Name} {x.D:+0;-0}")) + (n > 3 ? $" và {n - 3} người khác" : "");
        var ups = moves.Where(x => x.D > 0).OrderByDescending(x => x.D).Select(x => (x.Name, x.D)).ToList();
        var downs = moves.Where(x => x.D < 0).OrderBy(x => x.D).Select(x => (x.Name, x.D)).ToList();
        if (ups.Count > 0) feed.Add(new("north_east", "green", $"{ups.Count} cầu thủ tăng chỉ số", Who(ups, ups.Count), Open("clb")));
        if (downs.Count > 0) feed.Add(new("south_east", "red", $"{downs.Count} cầu thủ giảm chỉ số", Who(downs, downs.Count), Open("clb")));

        if (desk_?.Inbox.FirstOrDefault(i => i.Kind == InboxKind.Info && i.Link == "tai-chinh") is { } fin)
            feed.Add(new("payments", "gold", fin.Title, fin.Body, Open("tai-chinh")));

        var youth = await db.YouthIntakes.CountAsync(y => y.ClubId == mineId && y.SeasonId == seasonId && (since == null || y.CreatedAt > since));
        if (youth > 0) feed.Add(new("school", "violet", $"{youth} cầu thủ trẻ mới lên từ học viện", null, Open("hoc-vien")));

        if (leagueEdition is { } le)
        {
            var clubs = await db.EditionClubs.Where(x => x.EditionId == le).Select(x => x.ClubId).ToListAsync();
            var deals = await (from t in db.Transfers join w in db.TransferWindows on t.TransferWindowId equals w.Id join p in db.Players on t.PlayerId equals p.Id
                               where w.SeasonId == seasonId && t.Status == TransferStatus.Completed && t.CompletedAt != null && (since == null || t.CompletedAt > since)
                                     && ((t.FromClubId != null && clubs.Contains(t.FromClubId.Value)) || (t.ToClubId != null && clubs.Contains(t.ToClubId.Value)))
                               orderby t.CompletedAt descending
                               select new { t.PlayerId, p.Name, t.FromClubId, t.ToClubId, t.Fee, t.Kind }).Take(30).ToListAsync();
            var ids = deals.SelectMany(d => new[] { d.FromClubId, d.ToClubId }).OfType<Guid>().Distinct().ToList();
            var names = await db.Clubs.Where(c => ids.Contains(c.Id)).ToDictionaryAsync(c => c.Id, c => c.Name);
            string N(Guid? id) => id is { } g ? names.GetValueOrDefault(g) ?? "?" : "tự do";
            foreach (var d in deals.Take(3))
            {
                var mine = d.FromClubId == mineId || d.ToClubId == mineId;
                feed.Add(d.ToClubId is null || d.Kind == TransferKind.Release
                    ? new("person_remove", mine ? "gold" : "violet", $"{d.Name} rời {N(d.FromClubId)}", "Giải phóng hợp đồng", $"cau-thu/{d.PlayerId}")
                    : new("swap_horiz", mine ? "gold" : "violet", d.Kind == TransferKind.Loan ? $"{d.Name} được {N(d.ToClubId)} mượn" : $"{d.Name} gia nhập {N(d.ToClubId)}",
                        $"Từ {N(d.FromClubId)}" + (d.Kind == TransferKind.Loan ? "" : " · " + (d.Fee > 0 ? MoneyText.Format(d.Fee) : "miễn phí")), $"cau-thu/{d.PlayerId}"));
            }
            if (deals.Count > 3) feed.Add(new("swap_horiz", "violet", $"Thêm {deals.Count - 3} vụ chuyển nhượng khác trong giải", null, null));
        }
    }

