@page "/su-nghiep"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject IOptionFileStore Store
@inject CurrentUser Me
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject MatchJobService Jobs
@inject LeagueQueries Q
@implements IDisposable

<PageTitle>Sự nghiệp HLV</PageTitle>

@* Career PES17 (PO 19/11/2026: "chế độ tự chọn, gói gọn thành game"). UI đợt 1 (Stitch "Nocturnal Apex", PO duyệt 19/11):
   chưa cầm CLB → hướng dẫn 3 bước (giải → CLB → thư ban lãnh đạo); đang cầm CLB → phòng điều hành: thẻ mùa, ngôi sao của đội,
   trận tiếp theo, việc cần làm (≤3), nút lớn Tiếp tục. Khung (đầu trang, menu, thẻ mở khoá, màn kết quả) ở CareerLayout. *@
@if (!loaded) { <div class="cx-loading"><i></i><i></i><i></i></div>; return; }
@if (error is not null) { <p class="cx-msg neg">@error</p> }

@if (club is not null)
{
    @* Trang chủ career "Tờ báo buổi sáng" (PO 21/11): tin nóng + dải kết quả (CareerMedia) → trận tiếp theo, 4 chỉ số CLB, Cần xử lý dạng chip (gộp thư quyết định,
       đề nghị, cảnh báo) → Nhịp sống (Vòng vừa qua = cột Đội nhà) + album; cột mùa giải (lịch, mục tiêu, BXH, phong độ, cúp), ngôi sao đội. Máy tính 2 cột. *@
    var morale = squadMorale;
    <div class="hm">
        <div class="hm-main">
            <CareerMedia Stamp="@lastFixtureId" Club="@ClubFeed">
            @if (current is null)
            {
                <section class="cx-card cx-finale hm-hero-alt">
                    <div class="cx-eyebrow">@seasonName đã khép lại</div>
                    <div class="big">@(myPos is { } fp ? $"Hạng {fp}" : "Hết mùa")</div>
                    <p>@leagueName · @tally.W thắng · @tally.D hoà · @tally.L thua</p>
                    <div class="cx-facts">
                        <div><b>@champion.Count</b><span>Danh hiệu</span></div>
                        <div><b>@(board?.Verdict ?? "–")</b><span>Ban lãnh đạo</span></div>
                        <div><b class="@(budget >= 0 ? "cx-up" : "cx-down")">@Fmt.Money(budget)</b><span>Quỹ CLB</span></div>
                    </div>
                    @if (champion.Count > 0) { <p class="cx-trophies">@foreach (var t in champion) { <span><i class="ms fill" aria-hidden="true">emoji_events</i>@t</span> }</p> }
                </section>
            }
            else
            {
                var pct = slots > 0 ? (100.0 * (current.Number - 1) / slots).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "0";
                <a class="hm-hero" href="@(next is null ? null : current.MineFixture is { } mf ? $"chuan-bi/{mf}" : $"tran/{next.Id}")">
                    <i class="hm-beam l" aria-hidden="true"></i><i class="hm-beam r" aria-hidden="true"></i><i class="hm-pitch" aria-hidden="true"></i>
                    <div class="hm-top">
                        <span class="cx-label cyan"><i class="cx-pulse" aria-hidden="true"></i>@(next is null ? "Đã đá hết lịch" : "Trận tiếp theo")</span>
                        @if (next is { } n0) { <span class="cx-chip">@n0.Competition</span> }
                    </div>
                    @if (next is { } n)
                    {
                        <div class="hm-vs">
                            <span class="t @(n.HomeId == clubId ? "me" : null)"><Crest Name="@n.Home" Logo="@n.HomeLogo" Large="true" /><b>@n.Home</b><small>OVR @n.HomeOvr</small><FormDots Form="@n.HomeForm" /></span>
                            <span class="x"><b>VS</b><small>@(n.HomeId == clubId ? "Sân nhà" : "Sân khách")</small></span>
                            <span class="t @(n.AwayId == clubId ? "me" : null)"><Crest Name="@n.Away" Logo="@n.AwayLogo" Large="true" /><b>@n.Away</b><small>OVR @n.AwayOvr</small><FormDots Form="@n.AwayForm" /></span>
                        </div>
                        <p class="hm-when"><i class="ms" aria-hidden="true">@(current.MineFixture is not null ? "sports" : "schedule")</i>@WhenLine(n)</p>
                        <span class="cx-btn gold sm hm-go"><i class="ms fill" aria-hidden="true">@(current.MineFixture is not null ? "sports_soccer" : "visibility")</i>@(current.MineFixture is not null ? "Vào trận" : "Xem trận")</span>
                    }
                    else
                    {
                        <p class="hm-when solo">Đội bạn đã đá xong các trận của mùa. Các đội khác còn thi đấu.</p>
                    }
                    <div class="hm-season">
                        <span>@seasonName · @(leagueName ?? "Sự nghiệp")</span><b>Khung @current.Number/@slots</b>
                        <div class="cx-track thin"><div style="width:@pct%"></div></div>
                    </div>
                </a>
            }

            <div class="hm-kpis">
                <a class="hm-kpi" href="@Open("bxh")">
                    <span class="k"><i class="ms" aria-hidden="true">leaderboard</i>Hạng</span>
                    @if (myPlayed > 0 && myPos is { } mp)
                    {
                        <b class="@(mp <= (board?.ExpectedPosition ?? 0) ? "up" : null)"><span data-count="@mp">@mp</span><small>/@table.Count</small></b>
                        <span class="s @(prevPos is { } pp0 && pp0 != mp ? (pp0 > mp ? "up" : "down") : null)">@RankNote(mp)</span>
                    }
                    else
                    {
                        <b class="dim">–</b><span class="s">Chưa đá trận nào@(board is { } b0 ? $" · kỳ vọng hạng {b0.ExpectedPosition}" : "")</span>
                    }
                </a>
                <a class="hm-kpi" href="phong-thay-do">
                    <span class="k"><i class="ms" aria-hidden="true">mood</i>Tinh thần</span>
                    @if (morale is { } mo)
                    {
                        <b class="@(mo >= 60 ? "up" : mo < 35 ? "down" : null)"><span data-count="@mo">@mo</span><small>/100</small></b>
                        <span class="s">@MoodWord(mo) · CĐV @fanMood.ToLowerInvariant()</span>
                    }
                    else { <b class="dim">–</b><span class="s">Chưa có dữ liệu</span> }
                </a>
                <a class="hm-kpi" href="@Open("ban-lanh-dao")">
                    <span class="k"><i class="ms" aria-hidden="true">domain</i>Ban lãnh đạo</span>
                    @if (board is { } bd)
                    {
                        <b class="@(bd.Confidence >= 60 ? "up" : bd.Confidence < 40 ? "down" : null)"><span data-count="@bd.Confidence">@bd.Confidence</span><small>% tin</small></b>
                        <span class="s">@bd.Verdict</span>
                    }
                    else { <b class="dim">–</b><span class="s">Chưa đánh giá</span> }
                </a>
                <a class="hm-kpi" href="@Open("tai-chinh")">
                    <span class="k"><i class="ms" aria-hidden="true">account_balance</i>Quỹ CLB</span>
                    <b class="gold @(budget < 0 ? "down" : null)" data-count="@budget" data-fmt="money">@Fmt.Money(budget)</b>
                    <span class="s">@MarketLine</span>
                </a>
            </div>

            <section class="hm-sec hm-todo" aria-labelledby="hm-todo">
                <h2 class="hm-h" id="hm-todo">Cần xử lý @if (todo.Count > 0) { <small>@todo.Count</small> }</h2>
                @if (todo.Count == 0)
                {
                    <p class="hm-none"><i class="ms" aria-hidden="true">task_alt</i>@(current is null ? "Không có việc cần xử lý." : "Không có việc gấp. Bấm Tiếp tục để sang khung sau.")</p>
                }
                else
                {
                    <div class="hm-chips">
                        @foreach (var t in todo)
                        {
                            <a class="hm-chip t-@t.Tone" href="@t.Href" title="@t.Text">
                                <i class="ms" aria-hidden="true">@t.Icon</i><b>@t.Title</b>@if (t.Chip is not null) { <em>@t.Chip</em> }
                            </a>
                        }
                    </div>
                }
            </section>
            </CareerMedia>
        </div>

        <aside class="hm-side">
            <div class="hm-coach">
                @if (coach is null || coach.Status == CoachStatus.Creating)
                {
                    <a class="cx-cta solo" href="hlv"><span><b>Tạo hồ sơ HLV</b><small>Khuôn mặt, xuất thân, năng lực · nhận hợp đồng mặc định với @club</small></span><i class="ms fill" aria-hidden="true">person_add</i></a>
                }
                else if (contract is { Launched: false })
                {
                    <a class="cx-cta solo" href="hlv?ra-mat=1"><span><b>Họp báo ra mắt</b><small>Báo giới đang chờ ở @club</small></span><i class="ms fill" aria-hidden="true">photo_camera</i></a>
                }
                else
                {
                    <a class="hlv-bar" href="hlv">
                        @if (CoachUi.FaceUrl(coach) is { } fu) { <img src="@fu" alt="" /> } else { <span class="av"><i class="ms" aria-hidden="true">person</i></span> }
                        <div><b>@coach.Name</b>Danh tiếng @coach.Reputation · @CoachUi.License(coach.License)@(contract is { } k0 ? $" · lương {CoachUi.Cash(k0.Wage)}/vòng" : "")</div>
                        @if (coach.FreePoints > 0) { <span class="cx-chip ok">+@coach.FreePoints điểm</span> }
                        <i class="ms" aria-hidden="true">chevron_right</i>
                    </a>
                }
            </div>

            @if (upcoming.Count > 0)
            {
                <section class="hm-sec" aria-labelledby="hm-cal">
                    <h2 class="hm-h" id="hm-cal">Lịch sắp tới @if (Open("lich") is { } lh) { <a href="@lh">Cả lịch</a> }</h2>
                    <ul class="hm-fx">
                        @foreach (var u in upcoming)
                        {
                            <li><a href="tran/@u.Id">
                                <span class="sl">K@(u.Slot)</span>
                                <Crest Name="@u.Opponent" Logo="@u.Logo" />
                                <span class="tx"><b>@u.Opponent</b><small>@u.Competition · @(u.Home ? "sân nhà" : "sân khách")</small></span>
                            </a></li>
                        }
                    </ul>
                </section>
            }

            @if (board is { } b && current is not null)
            {
                <section class="cx-card cx-goal hm-goal">
                    <div class="row"><span class="cx-label">Mục tiêu ban lãnh đạo</span><span class="cx-chip @(b.Confidence >= 60 ? "ok" : b.Confidence >= 40 ? "" : "bad")">@b.Verdict</span></div>
                    <b>@b.League: @b.Objective</b>
                    <small>@(b.Position is { } bp && myPlayed > 0 ? $"Đang hạng {bp} · kỳ vọng hạng {b.ExpectedPosition}" : $"Kỳ vọng hạng {b.ExpectedPosition}")</small>
                    <div class="cx-track thin"><div style="width:@b.Confidence%"></div></div>
                </section>
            }

            @if (table.Count > 0)
            {
                <section class="hm-sec" aria-labelledby="hm-bxh">
                    <h2 class="hm-h" id="hm-bxh">@leagueName @if (Open("bxh") is { } bh) { <a href="@bh">Cả bảng</a> }</h2>
                    <div class="cx-card cx-table">
                        @if (myPlayed == 0) { <p class="hm-note">Chưa đá trận nào, bảng đang xếp theo tên.</p> }
                        @{ var prev = 0; }
                        @foreach (var r in TableSnippet)
                        {
                            if (r.Pos > prev + 1) { <div class="gap">…</div> }
                            prev = r.Pos;
                            <div class="tr @(r.Mine ? "mine" : "")"><span class="p">@r.Pos</span><span class="c"><Crest Name="@r.Club" Logo="@r.Logo" />@r.Club</span><span>@r.P</span><span>@(r.GD > 0 ? "+" : "")@r.GD</span><b>@r.Pts</b></div>
                        }
                    </div>
                </section>
            }

            @if (recent.Count > 0)
            {
                <section class="hm-sec" aria-labelledby="hm-form">
                    <h2 class="hm-h" id="hm-form">Phong độ <small>@tally.W T · @tally.D H · @tally.L B</small></h2>
                    <div class="cx-form">
                        @foreach (var x in recent)
                        {
                            <a class="res @x.Result" href="tran/@x.Id" title="@x.Competition"><b>@x.Score</b><small>@(x.Home ? "vs" : "@") @x.Opponent</small></a>
                        }
                    </div>
                </section>
            }

            @if (cups.Count > 0)
            {
                <section class="hm-sec" aria-labelledby="hm-cup">
                    <h2 class="hm-h" id="hm-cup">Cúp</h2>
                    <div class="hm-cups">
                        @foreach (var c in cups)
                        {
                            <div class="hm-cup @(c.State.Contains("Vô địch") ? "gold" : c.State.StartsWith("Bị loại") ? "out" : null)"><Crest Name="@c.Name" Logo="@c.Logo" Large="true" /><span><b>@c.Name</b><small>@c.State</small></span></div>
                        }
                    </div>
                </section>
            }

            @if (star is { } s)
            {
                <section class="hm-sec" aria-labelledby="hm-star">
                    <h2 class="hm-h" id="hm-star">Ngôi sao đội</h2>
                    <a class="cx-card cx-star hm-star tier-@s.Tier" href="cau-thu/@s.Id">
                        <span class="pic"><Face Id="s.Id" Name="@s.Name" Size="lg" /></span>
                        <span class="who">
                            <span><span class="cx-ovr" data-count="@s.Ovr">@s.Ovr</span><span class="ps">@s.Position</span></span>
                            <b>@s.Name</b>
                            <small>@s.Why</small>
                        </span>
                        <span class="hm-attrs">
                            @foreach (var (label, v, cyan) in s.Attrs)
                            {
                                <span><b>@v</b><i class="@(cyan ? "c" : "")" style="--v:@v"></i>@label</span>
                            }
                        </span>
                    </a>
                </section>
            }
        </aside>
    </div>

    <div class="hm-fade" aria-hidden="true"></div>
    @* Nút lớn: luôn nói người chơi làm gì tiếp *@
        <div class="cx-cta-dock">
            @if (Jobs.Running && Jobs.Title is MatchJobService.SimTitle or MatchJobService.RolloverTitle)
            {
                <div class="cx-cta busy"><span><b>@(Jobs.Title == MatchJobService.RolloverTitle ? "Đang sang mùa mới" : "Đang mô phỏng")</b><small>@(Jobs.Log.LastOrDefault() ?? "…")</small></span><i class="cx-spin" aria-hidden="true"></i></div>
            }
            else if (Jobs.Running && Jobs.Title == "Trận của tôi" && Jobs.HumanFixture is { } hf && hf.FixtureId == current?.MineFixture)
            {
                @* PO 20/11: máy đang giữ trận của chính mình → nút vào trận, không báo "máy bận" *@
                @if (Jobs.Preparing)
                {
                    <a class="cx-cta" href="chuan-bi/@hf.FixtureId"><span><b>Trận của bạn đã sẵn sàng</b><small>Game chờ ở màn chọn đội@(Jobs.PrepareUntil is { } pu ? $" · tự huỷ lúc {pu.ToLocalTime():HH:mm}" : "")</small></span><i class="ms fill" aria-hidden="true">sports_esports</i></a>
                }
                else
                {
                    <a class="cx-cta" href="vao-tran"><span><b>Trận của bạn đang diễn ra</b><small>Mở màn hình trận</small></span><i class="ms fill" aria-hidden="true">live_tv</i></a>
                }
            }
            else if (Jobs.Running)
            {
                <div class="cx-cta busy"><span><b>Máy trận đang bận</b><small>@Jobs.Title</small></span><i class="cx-spin" aria-hidden="true"></i></div>
            }
            else if (current is null)
            {
                @if (canNext)
                {
                    <button class="cx-cta" data-confirm="Sang mùa mới? Không quay lại được." @onclick="NextSeason"><span><b>Sang mùa mới</b><small>Cầu thủ lên tuổi, lên/xuống hạng, lịch và ngân sách mới</small></span><i class="ms" aria-hidden="true">event_repeat</i></button>
                }
            }
            else if (current.MineFixture is null)
            {
                <button class="cx-cta" @onclick="() => Simulate(j => j.SimulateCareer())"><span><b>Tiếp tục</b><small>Khung @current.Number: BOT đá @current.BotLeft trận, máy chạy tới trận kế tiếp của bạn</small></span><i class="ms fill" aria-hidden="true">play_arrow</i></button>
            }
            else
            {
                <div class="cx-cta-pair">
                    <a class="cx-cta" href="chuan-bi/@current.MineFixture"><span><b>Vào trận</b><small>@next?.Home – @next?.Away · khung @current.Number</small></span><i class="ms fill" aria-hidden="true">sports_esports</i></a>
                    <button class="cx-cta alt" data-confirm="Mô phỏng trận này (không đá trong game)?" @onclick="() => Simulate(j => j.SimulateCareer(mineNow: true))" title="Mô phỏng trận của bạn"><i class="ms" aria-hidden="true">casino</i><small>Mô phỏng</small></button>
                </div>
            }
        </div>
    return;
}
@if (me is null) { <p class="cx-msg">Cần đăng nhập tài khoản người chơi để bắt đầu sự nghiệp.</p> return; }
@* PO 19/11: tạo hồ sơ HLV trước khi chọn giải / CLB *@
@if (coach is null || coach.Status == CoachStatus.Creating) { <CoachMaker OnDone="CoachDone" />; return; }
@if (seasonId is null || taken)
{
    @* Thất nghiệp giữa mùa (bị sa thải / hết hạn / từ chức): đi tìm việc, chờ vòng sau *@
    <div class="cx-wiz">
        <h1>@(coach.Status == CoachStatus.Unemployed ? "Đang tìm việc" : "Chưa có CLB")</h1>
        <p class="lead">@(activeSeason ? "Mùa giải vẫn diễn ra. CLB có tin cậy ban lãnh đạo dưới 30 sẽ tìm HLV mới; lời mời gửi vào thư HLV." : "Chưa có mùa nào chờ bắt đầu sự nghiệp.")</p>
        <a class="hlv-bar" href="hlv" style="color:inherit;text-decoration:none">
            @if (CoachUi.FaceUrl(coach) is { } fu2) { <img src="@fu2" alt="" /> } else { <span class="av"><i class="ms" aria-hidden="true">person</i></span> }
            <div><b>@coach.Name</b>Danh tiếng @coach.Reputation · @CoachUi.License(coach.License)</div>
            <i class="ms" aria-hidden="true" style="color:var(--muted)">chevron_right</i>
        </a>
        <div class="hlv-acts">
            <a class="cx-btn gold" href="hlv/viec-lam"><i class="ms" aria-hidden="true">work</i>Tìm việc</a>
            <a class="cx-btn ghost" href="thu-hlv"><i class="ms" aria-hidden="true">mail</i>Thư HLV</a>
        </div>
        @if (activeSeason)
        {
            <button class="cx-cta solo" disabled="@Jobs.Running" @onclick="() => Simulate(j => j.SimulateCareer(includeMine: true, maxSlots: 1))">
                <span><b>@(Jobs.Running ? "Đang mô phỏng" : "Chờ 1 vòng")</b><small>Máy mô phỏng khung kế tiếp của cả thế giới career</small></span>
                <i class="ms fill" aria-hidden="true">hourglass_top</i>
            </button>
        }
        else if (canNext)
        {
            <button class="cx-cta solo" disabled="@Jobs.Running" @onclick="NextSeason"><span><b>Sang mùa mới</b><small>Mùa mới mở, mọi CLB chưa có người cầm đều tìm HLV</small></span><i class="ms fill" aria-hidden="true">calendar_month</i></button>
        }
    </div>
    return;
}

@* Hướng dẫn bắt đầu 3 bước *@
<div class="cx-wiz">
    <div class="cx-steps" aria-label="Bước @step/3">@for (var k = 1; k <= 3; k++) { <i class="@(k <= step ? "on" : "")"></i> }</div>
    @if (step == 1)
    {
        <h1>Chọn giải bạn muốn chinh phục</h1>
        <p class="lead">Mùa 1 có @Leagues.Count() giải quốc nội cùng cúp quốc gia, Champions League và Europa League. Trận nào bạn không đá, máy sẽ mô phỏng.</p>
        <div class="cx-picks">
            @foreach (var (g, i) in Leagues.Select((g, i) => (g, i)))
            {
                <button class="cx-pick league" style="--i:@i" @onclick="() => OpenLeague(g.Name)" aria-haspopup="dialog">
                    <LeagueLogo Name="@g.Name" Logo="@leagueLogos.GetValueOrDefault(g.Name)" />
                    <span><b>@g.Name</b><small>@Fmt.Country(g.Country) · hạng @g.Tier</small><small>@g.Count CLB · OVR TB @g.Ovr.ToString("0.0")</small></span>
                    <span class="stars" aria-label="@Stars(g.Ovr) sao">@(new string('★', Stars(g.Ovr)))<em>@(new string('★', 5 - Stars(g.Ovr)))</em></span>
                    <i class="ms more" aria-hidden="true">chevron_right</i>
                </button>
            }
        </div>
        @if (detail is { } d)
        {
            var lc = choices.Where(c => c.League == d.Name).OrderByDescending(c => c.Ovr).ToList();
            var avg = lc.Average(c => c.Ovr);
            var r = d.Rules;
            <div class="cx-ov cx-ldet-ov" @onclick="() => detail = null">
                <section class="cx-ldet" role="dialog" aria-modal="true" aria-label="@d.Name" @onclick:stopPropagation="true">
                    <button class="x" @onclick="() => detail = null" aria-label="Đóng"><i class="ms" aria-hidden="true">close</i></button>
                    <div class="lhead">
                        <LeagueLogo Name="@d.Name" Logo="@d.Logo" Big="true" />
                        <div>
                            <small>@Fmt.Country(d.Country) · hạng @(lc.FirstOrDefault()?.Tier ?? 1)</small>
                            <h2>@d.Name</h2>
                            <span class="stars" aria-label="@Stars(avg) sao">@(new string('★', Stars(avg)))<em>@(new string('★', 5 - Stars(avg)))</em></span>
                        </div>
                    </div>
                    <div class="nums">
                        <div class="cx-stat"><span>CLB</span><b data-count="@d.Clubs">@d.Clubs</b></div>
                        <div class="cx-stat"><span>OVR TB</span><b>@avg.ToString("0.0")</b></div>
                        <div class="cx-stat"><span>Trận/đội</span><b data-count="@d.Matches">@d.Matches</b></div>
                    </div>

                    <h3>Thể thức</h3>
                    <ul class="rules">
                        <li><i class="ms" aria-hidden="true">sports_soccer</i><span>Vòng tròn @(r.Legs == 2 ? "lượt đi – lượt về" : $"{r.Legs} lượt"), mỗi đội @d.Matches trận. Thắng @r.PointsWin, hoà @r.PointsDraw, thua @r.PointsLoss điểm.</span></li>
                        @if (r.ContinentalPlaces > 0 && d.C1 is { } c1)
                        {
                            <li><LeagueLogo Name="@c1.Name" Logo="@c1.Logo" Small="true" /><span>Hạng @Range(1, r.ContinentalPlaces) dự <b>@c1.Name</b> mùa sau</span></li>
                        }
                        @if (r.SecondaryContinentalPlaces > 0 && d.C2 is { } c2)
                        {
                            <li><LeagueLogo Name="@c2.Name" Logo="@c2.Logo" Small="true" /><span>Hạng @Range(r.ContinentalPlaces + 1, r.SecondaryContinentalPlaces) dự <b>@c2.Name</b> mùa sau</span></li>
                        }
                        @if (r.PromotionPlaces > 0 && d.Up is { } up)
                        {
                            <li><LeagueLogo Name="@up.Name" Logo="@up.Logo" Small="true" /><span class="cx-up">@r.PromotionPlaces đội đầu bảng lên <b>@up.Name</b></span></li>
                        }
                        @if (r.RelegationPlaces > 0 && d.Down is { } down)
                        {
                            <li><LeagueLogo Name="@down.Name" Logo="@down.Logo" Small="true" /><span class="cx-down">@r.RelegationPlaces đội cuối bảng xuống <b>@down.Name</b></span></li>
                        }
                        @if (r.PromotionPlaces == 0 && r.RelegationPlaces == 0)
                        {
                            <li><i class="ms" aria-hidden="true">lock</i><span>Không lên, xuống hạng</span></li>
                        }
                    </ul>
                    @if (r.ContinentalPlaces + r.SecondaryContinentalPlaces > 0)
                    {
                        <p class="note">Suất cúp châu Âu mùa 1 chia theo OVR đội hình; từ mùa 2 theo bảng xếp hạng.</p>
                    }

                    @if (d.Cups.Count > 0)
                    {
                        <h3>Cúp mùa này</h3>
                        <ul class="cups">
                            @foreach (var c in d.Cups)
                            {
                                <li>
                                    <LeagueLogo Name="@c.Name" Logo="@c.Logo" />
                                    <span>
                                        <b>@c.Name</b>
                                        @if (c.Type == CompetitionType.DomesticCup)
                                        {
                                            <small>@c.Teams CLB @Fmt.Country(d.Country), loại trực tiếp @(c.Rules.Legs == 1 ? "1 trận" : $"{c.Rules.Legs} lượt")</small>
                                        }
                                        else
                                        {
                                            <small>@c.Teams đội, league phase @c.Rules.LeaguePhaseMatches trận/đội; top @c.Rules.DirectKnockoutPlaces vào thẳng vòng 1/8</small>
                                            <span class="from">@c.Entrants.Count CLB của giải:
                                                @foreach (var e in c.Entrants) { <Crest Name="@e.Name" Logo="@e.Logo" /> }
                                            </span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }

                    <h3>CLB mạnh nhất</h3>
                    <ol class="top">
                        @foreach (var (c, k) in lc.Take(3).Select((c, k) => (c, k)))
                        {
                            <li><em>@(k + 1)</em><Crest Name="@c.Name" Logo="@c.LogoPath" Large="true" /><span><b>@c.Name</b><small><span>Đội hình @Fmt.Money(c.SquadValue)</span> · <span>ngân sách @Fmt.Money(c.Budget)</span></small></span><span class="cx-ovr">@c.Ovr.ToString("0.0")</span></li>
                        }
                    </ol>

                    @if (d.Players.Count > 0)
                    {
                        <h3>Ngôi sao</h3>
                        <div class="stars-row">
                            @foreach (var p in d.Players)
                            {
                                <div class="pl tier-@(CardTier(p.Ovr))">
                                    <span class="o">@p.Ovr</span><span class="ps">@p.Position</span>
                                    <Face Id="p.Id" Name="@p.Name" Size="md" />
                                    <b>@p.Name</b>
                                    <small><Crest Name="@p.Club.Name" Logo="@p.Club.Logo" />@p.Club.Name</small>
                                    <small class="price">@Fmt.Money(p.Price)</small>
                                </div>
                            }
                        </div>
                    }

                    <h3>Tiền</h3>
                    <div class="nums money">
                        <div class="cx-stat"><span>Tổng giá trị đội hình</span><b>@Fmt.Money(lc.Sum(c => c.SquadValue))</b></div>
                        <div class="cx-stat"><span>Ngân sách cao nhất</span><b>@Fmt.Money(lc.Max(c => c.Budget))</b><small>@lc.MaxBy(c => c.Budget)!.Name</small></div>
                        <div class="cx-stat"><span>Ngân sách TB</span><b>@Fmt.Money((long)lc.Average(c => c.Budget))</b></div>
                        <div class="cx-stat"><span>Ngân sách thấp nhất</span><b>@Fmt.Money(lc.Min(c => c.Budget))</b><small>@lc.MinBy(c => c.Budget)!.Name</small></div>
                    </div>

                    <h3>Lịch sử</h3>
                    @if (d.History.Count == 0)
                    {
                        <div class="empty"><i class="ms" aria-hidden="true">emoji_events</i><span><b>Chưa có nhà vô địch</b><small>@(firstSeason ? $"{Fmt.Season(seasonName ?? "1")} là mùa đầu tiên của sự nghiệp." : "Giải chưa đá mùa nào trong sự nghiệp.") Nhà vô địch, vua phá lưới và đội xuống hạng sẽ được ghi ở đây.</small></span></div>
                    }
                    else
                    {
                        <ul class="hist">
                            @foreach (var h in d.History)
                            {
                                <li>
                                    <em>@Fmt.Season(h.Season)</em>
                                    @if (h.Champion is { } ch) { <span class="champ"><i class="ms fill" aria-hidden="true">emoji_events</i><Crest Name="@ch.Name" Logo="@ch.Logo" /><b>@ch.Name</b></span> }
                                    @if (h.Scorer is not null) { <small><i class="ms" aria-hidden="true">sports_soccer</i>@h.Scorer@(h.ScorerClub is { } sc ? $" ({sc.Name})" : "") · @h.Goals bàn</small> }
                                    @if (h.Relegated.Count > 0) { <small class="cx-down"><i class="ms" aria-hidden="true">south</i>Xuống hạng: @string.Join(", ", h.Relegated.Select(x => x.Name))</small> }
                                </li>
                            }
                        </ul>
                    }

                    <div class="foot">
                        <button class="cx-cta" @onclick="() => Pick(d.Name)"><span><b>Chọn giải này</b><small>Xem @d.Clubs CLB để chọn đội</small></span><i class="ms fill" aria-hidden="true">arrow_forward</i></button>
                    </div>
                </section>
            </div>
        }
    }
    else if (step == 2 && league is not null)
    {
        <button class="cx-back" @onclick="() => step = 1"><i class="ms" aria-hidden="true">arrow_back</i>Đổi giải</button>
        <h1>Chọn CLB bạn sẽ dẫn dắt</h1>
        <p class="lead">@league. Đội mạnh thì mục tiêu cao, đội yếu cho bạn nhiều chỗ để xây dựng.</p>
        <div class="cx-picks">
            @foreach (var (c, i) in LeagueClubs.Select((c, i) => (c, i)))
            {
                var d = Difficulty(c); var jr = jobRows.GetValueOrDefault(c.ClubId);
                <button class="cx-pick club" style="--i:@i;@(jr?.Lock is not null ? "opacity:.55" : null)" @onclick="() => OpenClub(c)" aria-haspopup="dialog">
                    <Crest Name="@c.Name" Logo="@c.LogoPath" Large="true" />
                    <span><b>@c.Name</b><small>OVR @c.Ovr.ToString("0.0") · đội hình @Fmt.Money(c.SquadValue) · quỹ @Fmt.Money(c.Budget)</small>
                        <small class="goal"><i class="ms" aria-hidden="true">flag</i>Mục tiêu: @Objective(c)<span class="dif @d.Css">@d.Label</span></small>
                        @if (c.Cups.Count > 0) { <small class="cups">@string.Join(" · ", c.Cups)</small> }
                        @if (jr?.Lock is { } why) { <small style="color:var(--crimson)"><i class="ms fill" aria-hidden="true" style="font-size:14px;vertical-align:-2px">lock</i> @why</small> }
                        else if (jr is not null) { <small>CLB @CoachRules.Tier(jr.Tier).Name.ToLowerInvariant() · lương đề nghị @CoachUi.Cash(jr.Wage)/vòng</small> }</span>
                    <span class="cx-chip @(jr?.Lock is not null ? "bad" : d.Css)">@(jr?.Lock is not null ? "Khoá" : jr?.Refused == true ? "Đã từ chối" : d.Label)</span>
                    <i class="ms more" aria-hidden="true">chevron_right</i>
                </button>
            }
        </div>
        @if (clubDetail is { } cd && choices.FirstOrDefault(x => x.ClubId == cd.Id) is { } cc)
        {
            var dif = Difficulty(cc);
            var expected = ExpectedPos(cc);
            var youth = cd.Players.Where(p => p.Age is <= 21).MaxBy(p => (p.Ovr, p.Price));
            var stars = cd.Players.GroupBy(p => p.Position.Group()).Select(g => g.MaxBy(p => (p.Ovr, p.Price))!).OrderByDescending(p => p.Ovr).ThenByDescending(p => p.Price).Take(3).ToList();
            <div class="cx-ov cx-ldet-ov" @onclick="() => clubDetail = null">
                <section class="cx-ldet cx-cdet" role="dialog" aria-modal="true" aria-label="@cd.Name" @onclick:stopPropagation="true">
                    <button class="x" @onclick="() => clubDetail = null" aria-label="Đóng"><i class="ms" aria-hidden="true">close</i></button>
                    <div class="lhead">
                        <Crest Name="@cd.Name" Logo="@cd.Logo" Large="true" />
                        <div>
                            <small>@cc.League · @Fmt.Country(cc.Country)</small>
                            <h2>@cd.Name</h2>
                            <span class="tags"><span class="cx-chip @dif.Css">@dif.Label</span></span>
                        </div>
                    </div>
                    <div class="nums">
                        <div class="cx-stat"><span>OVR đá chính</span><b>@cd.XiOvr.ToString("0.0")</b><small>Hạng @cd.XiRank/@cd.Teams giải</small></div>
                        <div class="cx-stat"><span>Giá trị đội hình</span><b>@Fmt.Money(cc.SquadValue)</b><small>OVR cả đội @cc.Ovr.ToString("0.0")</small></div>
                        <div class="cx-stat"><span>Quỹ chuyển nhượng</span><b class="gold">@Fmt.Money(cc.Budget)</b><small>khi bắt đầu</small></div>
                        <div class="cx-stat"><span>Cầu thủ</span><b data-count="@cd.Players.Count">@cd.Players.Count</b></div>
                        <div class="cx-stat"><span>Tuổi TB</span><b>@cd.AvgAge.ToString("0.0")</b></div>
                        <div class="cx-stat"><span>Lương/trận</span><b>@Fmt.Money(cd.WageBill)</b><small>cả đội</small></div>
                    </div>

                    <KitStrip ClubId="cd.Id" Name="@cd.Name"><h3>Áo đấu</h3></KitStrip>

                    <h3>Ban lãnh đạo</h3>
                    <ul class="rules">
                        <li><i class="ms" aria-hidden="true">flag</i><span>Mục tiêu mùa: <b>@Objective(cc)</b></span></li>
                        <li><i class="ms" aria-hidden="true">leaderboard</i><span>Kỳ vọng xếp hạng <b>@expected/@cd.Teams</b> (theo giá trị đội hình trong giải)</span></li>
                        <li><i class="ms" aria-hidden="true">handshake</i><span>Độ tin cậy khởi đầu <b>@BoardRules.StartConfidence</b>/100; xuống dưới @BoardRules.ReviewBelow thì ban lãnh đạo xem xét</span></li>
                    </ul>

                    <h3>Thi đấu mùa này</h3>
                    <ul class="comps">
                        @foreach (var c in cd.Competitions)
                        {
                            <li><LeagueLogo Name="@c.Name" Logo="@c.Logo" Small="true" /><b>@c.Name</b></li>
                        }
                    </ul>

                    <h3>Sức mạnh từng tuyến</h3>
                    <ul class="lines">
                        @foreach (var l in cd.Lines)
                        {
                            var diff = l.Club - l.League;
                            <li>
                                <span class="lab">@LineName(l.Group) <small>@l.Count đá chính</small></span>
                                <span class="bar" style="--v:@Pct(l.Club);--m:@Pct(l.League)"><i></i><em title="TB giải @l.League.ToString("0.0")"></em></span>
                                <b>@l.Club.ToString("0.0")</b>
                                <small class="@(diff >= 0 ? "cx-up" : "cx-down")">@(diff >= 0 ? "+" : "−")@Math.Abs(diff).ToString("0.0")</small>
                            </li>
                        }
                    </ul>
                    <p class="note">OVR trung bình 11 người đá chính (đội hình gốc) theo tuyến; vạch trắng = trung bình các CLB cùng giải. Mô phỏng tính sức mạnh bằng 11 người này.</p>

                    <h3>Ngôi sao</h3>
                    <div class="stars-row">
                        @foreach (var p in stars)
                        {
                            <div class="pl tier-@(CardTier(p.Ovr))">
                                <span class="o">@p.Ovr</span><span class="ps">@p.Position</span>
                                <Face Id="p.Id" Name="@p.Name" Size="md" />
                                <b>@p.Name</b>
                                <small>@(p.Age is { } a ? $"{a} tuổi" : "")</small>
                                <small class="price">@Fmt.Money(p.Price)</small>
                            </div>
                        }
                    </div>
                    @if (youth is not null)
                    {
                        <div class="youth"><i class="ms fill" aria-hidden="true">auto_awesome</i><span><small>Trẻ đáng chú ý</small><b>@youth.Name</b></span>
                            <span class="meta">@youth.Position · @youth.Age tuổi</span><span class="cx-ovr">@youth.Ovr</span></div>
                    }

                    <h3>Đội hình (@cd.Players.Count)</h3>
                    <p class="note legend"><i></i>Đá chính (11 ô đầu đội hình) · lương tính mỗi trận</p>
                    @foreach (var g in cd.Players.GroupBy(p => p.Position.Group()).OrderBy(g => g.Key))
                    {
                        <h4>@LineName(g.Key) <small>@g.Count()</small></h4>
                        <ul class="squad" style="contain-intrinsic-size:auto @(g.Count() * 58)px">
                            @foreach (var p in g.OrderByDescending(p => p.Starter).ThenByDescending(p => p.Ovr))
                            {
                                <li class="@(p.Starter ? "st" : "")">
                                    <span class="ps">@p.Position</span>
                                    <span class="who"><b>@p.Name</b><small>@(p.Age is { } a ? $"{a} tuổi · " : "")số @p.Shirt@(p.ContractLeft is { } cl ? $" · HĐ {cl} trận" : "")</small></span>
                                    <span class="cx-ovr tier-@(CardTier(p.Ovr))">@p.Ovr</span>
                                    <span class="money"><b>@Fmt.Money(p.Price)</b><small>lương @Fmt.Money(p.Wage)</small></span>
                                </li>
                            }
                        </ul>
                    }

                    <h3>Tài chính</h3>
                    <div class="nums money">
                        <div class="cx-stat"><span>Vé / trận sân nhà</span><b>@Fmt.Money(cd.TicketIncome)</b><small>@cd.Capacity.ToString("N0") chỗ · @cd.Fans.ToString("N0") fan · vé @Fmt.Money(cd.TicketPrice)</small></div>
                        <div class="cx-stat"><span>Tài trợ / trận</span><b>@Fmt.Money(cd.Sponsor)</b><small>theo uy tín CLB</small></div>
                        <div class="cx-stat"><span>Bản quyền TV / trận</span><b>@Fmt.Money(FinanceRules.TvPerRound)</b><small>thưởng thắng +@Fmt.Money(FinanceRules.WinPrize) · hoà +@Fmt.Money(FinanceRules.DrawPrize)</small></div>
                        <div class="cx-stat"><span>Chi / trận</span><b class="cx-down">−@Fmt.Money(cd.WageBill + cd.Capacity * FinanceRules.UpkeepPerSeat)</b><small>lương @Fmt.Money(cd.WageBill) · bảo trì sân @Fmt.Money(cd.Capacity * FinanceRules.UpkeepPerSeat)</small></div>
                    </div>

                    <h3>Lịch sử</h3>
                    @if (cd.History.Count == 0)
                    {
                        <div class="empty"><i class="ms" aria-hidden="true">history</i><span><b>Chưa có mùa nào</b><small>@(firstSeason ? $"{Fmt.Season(seasonName ?? "1")} là mùa đầu tiên của sự nghiệp." : "CLB chưa đá xong mùa nào trong sự nghiệp.")</small></span></div>
                    }
                    else
                    {
                        <ul class="hist">
                            @foreach (var h in cd.History)
                            {
                                <li>
                                    <em>@Fmt.Season(h.Season)</em>
                                    <span class="champ"><LeagueLogo Name="@h.League.Name" Logo="@h.League.Logo" Small="true" /><b>@(h.Position is { } ps ? $"Hạng {ps}/{h.Teams}" : "–")</b></span>
                                    @foreach (var t in h.Titles) { <small class="cx-up"><i class="ms fill" aria-hidden="true">emoji_events</i>@t.Name</small> }
                                </li>
                            }
                        </ul>
                    }

                    <div class="foot">
                        @if (jobRows.GetValueOrDefault(cc.ClubId) is { Lock: { } lk })
                        {
                            <p class="cx-msg neg" style="margin:0"><i class="ms fill" aria-hidden="true" style="font-size:16px;vertical-align:-3px">lock</i> @lk. Leo dần từ CLB nhỏ hơn, học bằng ở hồ sơ HLV.</p>
                        }
                        else if (jobRows.GetValueOrDefault(cc.ClubId) is { Refused: true })
                        {
                            <p class="cx-msg neg" style="margin:0">@cd.Name đã từ chối bạn mùa này.</p>
                        }
                        else
                        {
                            <button class="cx-cta" disabled="@applying" @onclick="() => Apply(cc)"><span><b>Ứng tuyển</b><small>Thương lượng hợp đồng với chủ tịch @cd.Name</small></span><i class="ms fill" aria-hidden="true">arrow_forward</i></button>
                        }
                    </div>
                </section>
            </div>
        }
    }
    else if (step == 3 && pick is { } pk)
    {
        @* PO duyệt mockup 19/11: chủ tịch (SVG) chào trong phòng họp nhìn ra sân; bấm Bắt đầu → cảnh ra mắt HLV trong lúc dựng mùa. *@
        @if (!starting) { <button class="cx-back" @onclick="() => step = 2"><i class="ms" aria-hidden="true">arrow_back</i>Đổi CLB</button> }
        <h1>@(starting ? "Chào mừng HLV mới" : "Ban lãnh đạo chào bạn")</h1>
        <section class="cx-board @(starting ? "unveil" : "greet")" data-logo="@pk.LogoPath" aria-label="Phòng họp ban lãnh đạo @pk.Name">
            <BoardRoom />
            @if (!starting)
            {
                <div class="fig"><Chairman Club="@pk.Name" /></div>
                <div class="note">
                    <i class="tail" aria-hidden="true"></i>
                    <div class="from"><Crest Name="@pk.Name" Logo="@pk.LogoPath" Large="true" /><span>Thư từ chủ tịch<b>@pk.Name</b></span></div>
                    <p class="l1">Chào HLV mới. Chúng tôi giao cho bạn đội hình trị giá <b>@Fmt.Money(pk.SquadValue)</b> và ngân sách <b>@Fmt.Money(pk.Budget)</b>.</p>
                    <p class="l2">Mục tiêu mùa này ở bên dưới. Chúc may mắn, khán đài đang chờ bạn.</p>
                    <div class="sig"><svg viewBox="0 0 120 34" aria-hidden="true"><path d="M4 24 C14 6 20 6 18 20 C16 30 26 12 34 14 C40 16 34 28 42 24 C50 20 52 8 58 10 C64 12 56 26 64 24 C74 22 80 14 90 16 C98 18 104 22 116 12" /></svg><span>Chủ tịch @pk.Name</span></div>
                </div>
            }
            else
            {
                <div class="fig"><Chairman Club="@pk.Name" Scarf="true" /></div>
                <div class="flashes" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                <div class="shade" aria-hidden="true"></div>
                <div class="ban">
                    <span class="chip"><i class="ms fill" aria-hidden="true">photo_camera</i>Họp báo ra mắt</span>
                    <b><small>HLV mới của</small>@pk.Name</b>
                    <span>Chủ tịch giới thiệu bạn trước báo giới.</span>
                </div>
                <div class="flash-all" aria-hidden="true"></div>
            }
        </section>
        @if (!starting)
        {
            <h2 class="cx-goals-h">Mục tiêu @(seasonName ?? "mùa này")</h2>
            <ul class="cx-goals">
                <li><i class="ms fill" aria-hidden="true">flag</i><span>@pk.League: <b>@Objective(pk)</b></span></li>
                @foreach (var cup in pk.Cups) { <li><i class="ms fill" aria-hidden="true">emoji_events</i><span>@cup: <b>đi càng xa càng tốt</b></span></li> }
                <li><i class="ms fill" aria-hidden="true">savings</i><span>Tài chính: <b>không để quỹ âm</b></span></li>
            </ul>
        }
        @* Giữ CoachDeal sống suốt lúc ký (nó tự hiện tiến trình dựng mùa) *@
        @if (appId is { } aid && coach is not null)
        {
            <CoachDeal AppId="aid" C="coach" Club="@pk.Name" Objective="@Objective(pk)" Starting="true" OnSigning="() => starting = true" OnSigned="Signed" OnClosed="() => { appId = null; step = 2; }" />
        }
        else if (starting)
        {
            <div class="cx-board-prog" role="status">
                <div><b>Đang dựng mùa giải</b><span>Ghi lịch cả mùa, mở chợ hè (khoảng nửa phút)</span></div>
                <i aria-hidden="true"></i>
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] public CareerLayout? Shell { get; set; }

    Guid? me, seasonId, clubId, appId;
    bool loaded, taken, starting, canNext, activeSeason, applying;
    Coach? coach;
