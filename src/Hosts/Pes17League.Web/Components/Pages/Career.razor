@page "/su-nghiep"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject IOptionFileStore Store
@inject CurrentUser Me
@inject TimeProvider Clock
@inject NavigationManager Nav
@inject MatchJobService Jobs
@inject LeagueQueries Q
@implements IDisposable

<PageTitle>Sự nghiệp HLV</PageTitle>

@* Career PES17 (PO 19/11/2026: "chế độ tự chọn, gói gọn thành game"). UI đợt 1 (Stitch "Nocturnal Apex", PO duyệt 19/11):
   chưa cầm CLB → hướng dẫn 3 bước (giải → CLB → thư ban lãnh đạo); đang cầm CLB → phòng điều hành: thẻ mùa, ngôi sao của đội,
   trận tiếp theo, việc cần làm (≤3), nút lớn Tiếp tục. Khung (đầu trang, menu, thẻ mở khoá, màn kết quả) ở CareerLayout. *@
@if (!loaded) { <div class="cx-loading"><i></i><i></i><i></i></div>; return; }
@if (error is not null) { <p class="cx-msg neg">@error</p> }

@if (club is not null)
{
    <div class="cx-home">
        @* Thẻ mùa *@
        <section class="cx-card cx-season" style="--i:0">
            <div class="row">
                <span class="cx-label"><i class="ms fill" aria-hidden="true">workspace_premium</i>@seasonName · @(leagueName ?? "Sự nghiệp")</span>
                <span class="cx-chip live">@(current is { } c0 ? $"Khung {c0.Number}/{slots}" : "Hết mùa")</span>
            </div>
            @{ var pct = slots > 0 ? 100.0 * ((current?.Number ?? slots + 1) - 1) / slots : 100; }
            <div class="cx-track"><div style="width:@pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
            <div class="row small">
                <span>@MarketLine</span>
                <span>@(myPos is { } mp ? $"Hạng {mp}/{table.Count} · " : "")@tally.W T · @tally.D H · @tally.L B</span>
            </div>
        </section>

        @if (current is null)
        {
            @* Hết mùa *@
            <section class="cx-card cx-finale" style="--i:1">
                <div class="cx-eyebrow">@seasonName đã khép lại</div>
                <div class="big">@(myPos is { } fp ? $"Hạng {fp}" : "Hết mùa")</div>
                <p>@leagueName · @tally.W thắng · @tally.D hoà · @tally.L thua</p>
                <div class="cx-facts">
                    <div><b>@(champion.Count > 0 ? champion.Count.ToString() : "0")</b><span>Danh hiệu</span></div>
                    <div><b>@(board?.Verdict ?? "–")</b><span>Ban lãnh đạo</span></div>
                    <div><b class="@(budget >= 0 ? "cx-up" : "cx-down")">@Fmt.Money(budget)</b><span>Quỹ CLB</span></div>
                </div>
                @if (champion.Count > 0) { <p class="cx-trophies">@foreach (var t in champion) { <span><i class="ms fill" aria-hidden="true">emoji_events</i>@t</span> }</p> }
            </section>
        }
        else if (star is { } s)
        {
            @* Ngôi sao của đội *@
            <a class="cx-card cx-star tier-@s.Tier" href="cau-thu/@s.Id" style="--i:1">
                <div class="cx-star-head">
                    <div>
                        <span class="cx-ovr" data-count="@s.Ovr">@s.Ovr</span><span class="ps">@s.Position</span>
                        <h2>@s.Name</h2>
                        <p><span class="cx-chip">@s.Why</span></p>
                    </div>
                    <span class="cx-tier">@TierLabel(s.Tier)</span>
                </div>
                <div class="cx-portrait"><Face Id="s.Id" Name="@s.Name" Size="lg" /><i class="halo" aria-hidden="true"></i></div>
                <div class="cx-attrs">
                    @foreach (var (label, v, cyan) in s.Attrs)
                    {
                        <div><span>@label</span><b data-count="@v">@v</b><i class="@(cyan ? "c" : "")" style="--v:@v"></i></div>
                    }
                </div>
                <div class="cx-crowd" aria-hidden="true"><i class="ms">volume_up</i>Khán đài đang chờ<span>@for (var k = 0; k < 6; k++) { <i style="--k:@k"></i> }</span></div>
            </a>
        }

        @if (current is not null && next is { } n)
        {
            <h3 class="cx-h3">Lộ trình tiếp theo <small>@(tasks.Count + (newFeature is null ? 0 : 1)) việc</small></h3>
            <a class="cx-card cx-next" href="@(current.MineFixture is { } mf ? $"chuan-bi/{mf}" : $"tran/{n.Id}")" style="--i:2">
                <div class="row">
                    <span class="cx-label cyan"><i class="cx-pulse" aria-hidden="true"></i>Trận tiếp theo · khung @n.Slot</span>
                    <span class="cx-chip">@n.Competition</span>
                </div>
                <div class="cx-vs">
                    <span class="t"><Crest Name="@n.Home" Logo="@n.HomeLogo" Large="true" /><b>@n.Home</b><small>OVR @n.HomeOvr</small><FormDots Form="@n.HomeForm" /></span>
                    <span class="x">VS</span>
                    <span class="t"><Crest Name="@n.Away" Logo="@n.AwayLogo" Large="true" /><b>@n.Away</b><small>OVR @n.AwayOvr</small><FormDots Form="@n.AwayForm" /></span>
                </div>
            </a>
        }

        @if (newFeature is { } nf && CareerLayout.Intros.TryGetValue(nf, out var nfo))
        {
            <a class="cx-card cx-task new" href="@nfo.Href" style="--i:3">
                <div><span class="cx-label">Mới mở khoá</span><b>@nfo.Title</b><small>@nfo.Text</small></div>
                <span class="cx-ic gold"><i class="ms fill" aria-hidden="true">lock_open</i></span>
            </a>
        }
        @foreach (var (t, i) in tasks.Select((t, i) => (t, i)))
        {
            <a class="cx-card cx-task @(t.Kind == InboxKind.Warning ? "warn" : "")" href="@(t.Link ?? "hop-thu")" style="--i:@(4 + i)">
                <div><span class="cx-label">@(t.Kind == InboxKind.Warning ? "Cần chú ý" : "Việc cần làm")</span><b>@t.Title</b><small>@t.Body</small></div>
                <span class="cx-ic"><i class="ms" aria-hidden="true">chevron_right</i></span>
            </a>
        }

        @if (board is { } b && current is not null)
        {
            <section class="cx-card cx-goal" style="--i:7">
                <div class="row"><span class="cx-label">Mục tiêu ban lãnh đạo</span><span class="cx-chip @(b.Confidence >= 60 ? "ok" : b.Confidence >= 40 ? "" : "bad")">@b.Verdict</span></div>
                <b>@b.League: @b.Objective</b>
                <small>@(b.Position is { } bp ? $"Đang hạng {bp} · kỳ vọng hạng {b.ExpectedPosition}" : $"Kỳ vọng hạng {b.ExpectedPosition}")</small>
                <div class="cx-track thin"><div style="width:@b.Confidence%"></div></div>
            </section>
        }

        @if (table.Count > 0)
        {
            <h3 class="cx-h3">@leagueName <a href="bxh">Cả bảng</a></h3>
            <section class="cx-card cx-table" style="--i:8">
                @{ var prev = 0; }
                @foreach (var r in TableSnippet)
                {
                    if (r.Pos > prev + 1) { <div class="gap">…</div> }
                    prev = r.Pos;
                    <div class="tr @(r.Mine ? "mine" : "")"><span class="p">@r.Pos</span><span class="c"><Crest Name="@r.Club" Logo="@r.Logo" />@r.Club</span><span>@r.P</span><span>@(r.GD > 0 ? "+" : "")@r.GD</span><b>@r.Pts</b></div>
                }
            </section>
        }

        @if (recent.Count > 0)
        {
            <h3 class="cx-h3">Phong độ</h3>
            <div class="cx-form" style="--i:9">
                @foreach (var x in recent)
                {
                    <a class="res @x.Result" href="tran/@x.Id" title="@x.Competition"><b>@x.Score</b><small>@(x.Home ? "vs" : "@") @x.Opponent</small></a>
                }
            </div>
        }

        @if (cups.Count > 0)
        {
            <h3 class="cx-h3">Cúp</h3>
            <div class="cx-cups" style="--i:10">
                @foreach (var c in cups) { <span class="@(c.State.Contains("Vô địch") ? "gold" : c.State.StartsWith("Bị loại") ? "out" : "")"><b>@c.Name</b>@c.State</span> }
            </div>
        }

        <details class="cx-card cx-settings" style="--i:11">
            <summary><i class="ms" aria-hidden="true">tune</i>Cài đặt mô phỏng</summary>
            <label title="Khi mô phỏng trận của bạn: cầu thủ đá chính mệt (≥ @ConditionRules.TiredAt) được cho nghỉ nếu có dự bị cùng tuyến khoẻ. Không sửa đội hình bạn đã lưu.">
                <input type="checkbox" checked="@autoLineup" @onchange="ToggleAuto" /> Trợ lý xoay vòng đội hình khi mô phỏng (người mệt nghỉ)
            </label>
            @if (!Jobs.Running && Jobs.Title is MatchJobService.SimTitle or MatchJobService.RolloverTitle && Jobs.Log.Count > 0)
            {
                <pre>@string.Join("\n", Jobs.Log.TakeLast(12))</pre>
            }
        </details>

        @* Nút lớn: luôn nói người chơi làm gì tiếp *@
        <div class="cx-cta-dock">
            @if (Jobs.Running && Jobs.Title is MatchJobService.SimTitle or MatchJobService.RolloverTitle)
            {
                <div class="cx-cta busy"><span><b>@(Jobs.Title == MatchJobService.RolloverTitle ? "Đang sang mùa mới" : "Đang mô phỏng")</b><small>@(Jobs.Log.LastOrDefault() ?? "…")</small></span><i class="cx-spin" aria-hidden="true"></i></div>
            }
            else if (Jobs.Running)
            {
                <div class="cx-cta busy"><span><b>Máy trận đang bận</b><small>@Jobs.Title</small></span><i class="cx-spin" aria-hidden="true"></i></div>
            }
            else if (current is null)
            {
                @if (canNext)
                {
                    <button class="cx-cta" data-confirm="Sang mùa mới? Không quay lại được." @onclick="NextSeason"><span><b>Sang mùa mới</b><small>Cầu thủ lên tuổi, lên/xuống hạng, lịch và ngân sách mới</small></span><i class="ms" aria-hidden="true">event_repeat</i></button>
                }
            }
            else if (current.BotLeft > 0 || current.MineFixture is null)
            {
                <button class="cx-cta" @onclick="() => Simulate(false)"><span><b>Tiếp tục</b><small>@(current.MineFixture is null ? $"Khung {current.Number}: BOT đá {current.BotLeft} trận" : $"Mô phỏng {current.BotLeft} trận khác rồi vào trận của bạn")</small></span><i class="ms fill" aria-hidden="true">play_arrow</i></button>
            }
            else
            {
                <div class="cx-cta-pair">
                    <a class="cx-cta" href="chuan-bi/@current.MineFixture"><span><b>Vào trận</b><small>@next?.Home – @next?.Away · khung @current.Number</small></span><i class="ms fill" aria-hidden="true">sports_esports</i></a>
                    <button class="cx-cta alt" data-confirm="Mô phỏng trận này (không đá trong game)?" @onclick="() => Simulate(true)" title="Mô phỏng trận của bạn"><i class="ms" aria-hidden="true">casino</i><small>Mô phỏng</small></button>
                </div>
            }
        </div>
    </div>
    return;
}
@if (me is null) { <p class="cx-msg">Cần đăng nhập tài khoản người chơi để bắt đầu sự nghiệp.</p> return; }
@if (seasonId is null) { <p class="cx-msg">Chưa có mùa nào chờ bắt đầu sự nghiệp.</p> return; }
@if (taken) { <p class="cx-msg">Sự nghiệp mùa này đã có người cầm CLB.</p> return; }

@* Hướng dẫn bắt đầu 3 bước *@
<div class="cx-wiz">
    <div class="cx-steps" aria-label="Bước @step/3">@for (var k = 1; k <= 3; k++) { <i class="@(k <= step ? "on" : "")"></i> }</div>
    @if (step == 1)
    {
        <h1>Chọn giải bạn muốn chinh phục</h1>
        <p class="lead">Mùa 1 có @Leagues.Count() giải quốc nội cùng cúp quốc gia, Champions League và Europa League. Trận nào bạn không đá, máy sẽ mô phỏng.</p>
        <div class="cx-picks">
            @foreach (var (g, i) in Leagues.Select((g, i) => (g, i)))
            {
                <button class="cx-pick league" style="--i:@i" @onclick="() => OpenLeague(g.Name)" aria-haspopup="dialog">
                    <LeagueLogo Name="@g.Name" Logo="@leagueLogos.GetValueOrDefault(g.Name)" />
                    <span><b>@g.Name</b><small>@Fmt.Country(g.Country) · hạng @g.Tier</small><small>@g.Count CLB · OVR TB @g.Ovr.ToString("0.0")</small></span>
                    <span class="stars" aria-label="@Stars(g.Ovr) sao">@(new string('★', Stars(g.Ovr)))<em>@(new string('★', 5 - Stars(g.Ovr)))</em></span>
                    <i class="ms more" aria-hidden="true">chevron_right</i>
                </button>
            }
        </div>
        @if (detail is { } d)
        {
            var lc = choices.Where(c => c.League == d.Name).OrderByDescending(c => c.Ovr).ToList();
            var avg = lc.Average(c => c.Ovr);
            var r = d.Rules;
            <div class="cx-ov cx-ldet-ov" @onclick="() => detail = null">
                <section class="cx-ldet" role="dialog" aria-modal="true" aria-label="@d.Name" @onclick:stopPropagation="true">
                    <button class="x" @onclick="() => detail = null" aria-label="Đóng"><i class="ms" aria-hidden="true">close</i></button>
                    <div class="lhead">
                        <LeagueLogo Name="@d.Name" Logo="@d.Logo" Big="true" />
                        <div>
                            <small>@Fmt.Country(d.Country) · hạng @(lc.FirstOrDefault()?.Tier ?? 1)</small>
                            <h2>@d.Name</h2>
                            <span class="stars" aria-label="@Stars(avg) sao">@(new string('★', Stars(avg)))<em>@(new string('★', 5 - Stars(avg)))</em></span>
                        </div>
                    </div>
                    <div class="nums">
                        <div class="cx-stat"><span>CLB</span><b data-count="@d.Clubs">@d.Clubs</b></div>
                        <div class="cx-stat"><span>OVR TB</span><b>@avg.ToString("0.0")</b></div>
                        <div class="cx-stat"><span>Trận/đội</span><b data-count="@d.Matches">@d.Matches</b></div>
                    </div>

                    <h3>Thể thức</h3>
                    <ul class="rules">
                        <li><i class="ms" aria-hidden="true">sports_soccer</i><span>Vòng tròn @(r.Legs == 2 ? "lượt đi – lượt về" : $"{r.Legs} lượt"), mỗi đội @d.Matches trận. Thắng @r.PointsWin, hoà @r.PointsDraw, thua @r.PointsLoss điểm.</span></li>
                        @if (r.ContinentalPlaces > 0 && d.C1 is { } c1)
                        {
                            <li><LeagueLogo Name="@c1.Name" Logo="@c1.Logo" Small="true" /><span>Hạng @Range(1, r.ContinentalPlaces) dự <b>@c1.Name</b> mùa sau</span></li>
                        }
                        @if (r.SecondaryContinentalPlaces > 0 && d.C2 is { } c2)
                        {
                            <li><LeagueLogo Name="@c2.Name" Logo="@c2.Logo" Small="true" /><span>Hạng @Range(r.ContinentalPlaces + 1, r.SecondaryContinentalPlaces) dự <b>@c2.Name</b> mùa sau</span></li>
                        }
                        @if (r.PromotionPlaces > 0 && d.Up is { } up)
                        {
                            <li><LeagueLogo Name="@up.Name" Logo="@up.Logo" Small="true" /><span class="cx-up">@r.PromotionPlaces đội đầu bảng lên <b>@up.Name</b></span></li>
                        }
                        @if (r.RelegationPlaces > 0 && d.Down is { } down)
                        {
                            <li><LeagueLogo Name="@down.Name" Logo="@down.Logo" Small="true" /><span class="cx-down">@r.RelegationPlaces đội cuối bảng xuống <b>@down.Name</b></span></li>
                        }
                        @if (r.PromotionPlaces == 0 && r.RelegationPlaces == 0)
                        {
                            <li><i class="ms" aria-hidden="true">lock</i><span>Không lên, xuống hạng</span></li>
                        }
                    </ul>
                    @if (r.ContinentalPlaces + r.SecondaryContinentalPlaces > 0)
                    {
                        <p class="note">Suất cúp châu Âu mùa 1 chia theo OVR đội hình; từ mùa 2 theo bảng xếp hạng.</p>
                    }

                    @if (d.Cups.Count > 0)
                    {
                        <h3>Cúp mùa này</h3>
                        <ul class="cups">
                            @foreach (var c in d.Cups)
                            {
                                <li>
                                    <LeagueLogo Name="@c.Name" Logo="@c.Logo" />
                                    <span>
                                        <b>@c.Name</b>
                                        @if (c.Type == CompetitionType.DomesticCup)
                                        {
                                            <small>@c.Teams CLB @Fmt.Country(d.Country), loại trực tiếp @(c.Rules.Legs == 1 ? "1 trận" : $"{c.Rules.Legs} lượt")</small>
                                        }
                                        else
                                        {
                                            <small>@c.Teams đội, league phase @c.Rules.LeaguePhaseMatches trận/đội; top @c.Rules.DirectKnockoutPlaces vào thẳng vòng 1/8</small>
                                            <span class="from">@c.Entrants.Count CLB của giải:
                                                @foreach (var e in c.Entrants) { <Crest Name="@e.Name" Logo="@e.Logo" /> }
                                            </span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }

                    <h3>CLB mạnh nhất</h3>
                    <ol class="top">
                        @foreach (var (c, k) in lc.Take(3).Select((c, k) => (c, k)))
                        {
                            <li><em>@(k + 1)</em><Crest Name="@c.Name" Logo="@c.LogoPath" Large="true" /><span><b>@c.Name</b><small><span>Đội hình @Fmt.Money(c.SquadValue)</span> · <span>ngân sách @Fmt.Money(c.Budget)</span></small></span><span class="cx-ovr">@c.Ovr.ToString("0.0")</span></li>
                        }
                    </ol>

                    @if (d.Players.Count > 0)
                    {
                        <h3>Ngôi sao</h3>
                        <div class="stars-row">
                            @foreach (var p in d.Players)
                            {
                                <div class="pl tier-@(CardTier(p.Ovr))">
                                    <span class="o">@p.Ovr</span><span class="ps">@p.Position</span>
                                    <Face Id="p.Id" Name="@p.Name" Size="md" />
                                    <b>@p.Name</b>
                                    <small><Crest Name="@p.Club.Name" Logo="@p.Club.Logo" />@p.Club.Name</small>
                                    <small class="price">@Fmt.Money(p.Price)</small>
                                </div>
                            }
                        </div>
                    }

                    <h3>Tiền</h3>
                    <div class="nums money">
                        <div class="cx-stat"><span>Tổng giá trị đội hình</span><b>@Fmt.Money(lc.Sum(c => c.SquadValue))</b></div>
                        <div class="cx-stat"><span>Ngân sách cao nhất</span><b>@Fmt.Money(lc.Max(c => c.Budget))</b><small>@lc.MaxBy(c => c.Budget)!.Name</small></div>
                        <div class="cx-stat"><span>Ngân sách TB</span><b>@Fmt.Money((long)lc.Average(c => c.Budget))</b></div>
                        <div class="cx-stat"><span>Ngân sách thấp nhất</span><b>@Fmt.Money(lc.Min(c => c.Budget))</b><small>@lc.MinBy(c => c.Budget)!.Name</small></div>
                    </div>

                    <h3>Lịch sử</h3>
                    @if (d.History.Count == 0)
                    {
                        <div class="empty"><i class="ms" aria-hidden="true">emoji_events</i><span><b>Chưa có nhà vô địch</b><small>@(firstSeason ? $"{Fmt.Season(seasonName ?? "1")} là mùa đầu tiên của sự nghiệp." : "Giải chưa đá mùa nào trong sự nghiệp.") Nhà vô địch, vua phá lưới và đội xuống hạng sẽ được ghi ở đây.</small></span></div>
                    }
                    else
                    {
                        <ul class="hist">
                            @foreach (var h in d.History)
                            {
                                <li>
                                    <em>@Fmt.Season(h.Season)</em>
                                    @if (h.Champion is { } ch) { <span class="champ"><i class="ms fill" aria-hidden="true">emoji_events</i><Crest Name="@ch.Name" Logo="@ch.Logo" /><b>@ch.Name</b></span> }
                                    @if (h.Scorer is not null) { <small><i class="ms" aria-hidden="true">sports_soccer</i>@h.Scorer@(h.ScorerClub is { } sc ? $" ({sc.Name})" : "") · @h.Goals bàn</small> }
                                    @if (h.Relegated.Count > 0) { <small class="cx-down"><i class="ms" aria-hidden="true">south</i>Xuống hạng: @string.Join(", ", h.Relegated.Select(x => x.Name))</small> }
                                </li>
                            }
                        </ul>
                    }

                    <div class="foot">
                        <button class="cx-cta" @onclick="() => Pick(d.Name)"><span><b>Chọn giải này</b><small>Xem @d.Clubs CLB để chọn đội</small></span><i class="ms fill" aria-hidden="true">arrow_forward</i></button>
                    </div>
                </section>
            </div>
        }
    }
    else if (step == 2 && league is not null)
    {
        <button class="cx-back" @onclick="() => step = 1"><i class="ms" aria-hidden="true">arrow_back</i>Đổi giải</button>
        <h1>Chọn CLB bạn sẽ dẫn dắt</h1>
        <p class="lead">@league. Đội mạnh thì mục tiêu cao, đội yếu cho bạn nhiều chỗ để xây dựng.</p>
        <div class="cx-picks">
            @foreach (var (c, i) in LeagueClubs.Select((c, i) => (c, i)))
            {
                var d = Difficulty(c);
                <button class="cx-pick club" style="--i:@i" @onclick="() => OpenClub(c)" aria-haspopup="dialog">
                    <Crest Name="@c.Name" Logo="@c.LogoPath" Large="true" />
                    <span><b>@c.Name</b><small>OVR @c.Ovr.ToString("0.0") · đội hình @Fmt.Money(c.SquadValue) · quỹ @Fmt.Money(c.Budget)</small>
                        <small class="goal"><i class="ms" aria-hidden="true">flag</i>Mục tiêu: @Objective(c)<span class="dif @d.Css">@d.Label</span></small>
                        @if (c.Cups.Count > 0) { <small class="cups">@string.Join(" · ", c.Cups)</small> }</span>
                    <span class="cx-chip @d.Css">@d.Label</span>
                    <i class="ms more" aria-hidden="true">chevron_right</i>
                </button>
            }
        </div>
        @if (clubDetail is { } cd && choices.FirstOrDefault(x => x.ClubId == cd.Id) is { } cc)
        {
            var dif = Difficulty(cc);
            var expected = ExpectedPos(cc);
            var youth = cd.Players.Where(p => p.Age is <= 21).MaxBy(p => (p.Ovr, p.Price));
            var stars = cd.Players.GroupBy(p => p.Position.Group()).Select(g => g.MaxBy(p => (p.Ovr, p.Price))!).OrderByDescending(p => p.Ovr).ThenByDescending(p => p.Price).Take(3).ToList();
            <div class="cx-ov cx-ldet-ov" @onclick="() => clubDetail = null">
                <section class="cx-ldet cx-cdet" role="dialog" aria-modal="true" aria-label="@cd.Name" @onclick:stopPropagation="true">
                    <button class="x" @onclick="() => clubDetail = null" aria-label="Đóng"><i class="ms" aria-hidden="true">close</i></button>
                    <div class="lhead">
                        <Crest Name="@cd.Name" Logo="@cd.Logo" Large="true" />
                        <div>
                            <small>@cc.League · @Fmt.Country(cc.Country)</small>
                            <h2>@cd.Name</h2>
                            <span class="tags"><span class="cx-chip @dif.Css">@dif.Label</span></span>
                        </div>
                    </div>
                    <div class="nums">
                        <div class="cx-stat"><span>OVR đá chính</span><b>@cd.XiOvr.ToString("0.0")</b><small>Hạng @cd.XiRank/@cd.Teams giải</small></div>
                        <div class="cx-stat"><span>Giá trị đội hình</span><b>@Fmt.Money(cc.SquadValue)</b><small>OVR cả đội @cc.Ovr.ToString("0.0")</small></div>
                        <div class="cx-stat"><span>Quỹ chuyển nhượng</span><b class="gold">@Fmt.Money(cc.Budget)</b><small>khi bắt đầu</small></div>
                        <div class="cx-stat"><span>Cầu thủ</span><b data-count="@cd.Players.Count">@cd.Players.Count</b></div>
                        <div class="cx-stat"><span>Tuổi TB</span><b>@cd.AvgAge.ToString("0.0")</b></div>
                        <div class="cx-stat"><span>Lương/trận</span><b>@K(cd.WageBill)</b><small>cả đội</small></div>
                    </div>

                    <h3>Ban lãnh đạo</h3>
                    <ul class="rules">
                        <li><i class="ms" aria-hidden="true">flag</i><span>Mục tiêu mùa: <b>@Objective(cc)</b></span></li>
                        <li><i class="ms" aria-hidden="true">leaderboard</i><span>Kỳ vọng xếp hạng <b>@expected/@cd.Teams</b> (theo giá trị đội hình trong giải)</span></li>
                        <li><i class="ms" aria-hidden="true">handshake</i><span>Độ tin cậy khởi đầu <b>@BoardRules.StartConfidence</b>/100; xuống dưới @BoardRules.ReviewBelow thì ban lãnh đạo xem xét</span></li>
                    </ul>

                    <h3>Thi đấu mùa này</h3>
                    <ul class="comps">
                        @foreach (var c in cd.Competitions)
                        {
                            <li><LeagueLogo Name="@c.Name" Logo="@c.Logo" Small="true" /><b>@c.Name</b></li>
                        }
                    </ul>

                    <h3>Sức mạnh từng tuyến</h3>
                    <ul class="lines">
                        @foreach (var l in cd.Lines)
                        {
                            var diff = l.Club - l.League;
                            <li>
                                <span class="lab">@LineName(l.Group) <small>@l.Count đá chính</small></span>
                                <span class="bar" style="--v:@Pct(l.Club);--m:@Pct(l.League)"><i></i><em title="TB giải @l.League.ToString("0.0")"></em></span>
                                <b>@l.Club.ToString("0.0")</b>
                                <small class="@(diff >= 0 ? "cx-up" : "cx-down")">@(diff >= 0 ? "+" : "−")@Math.Abs(diff).ToString("0.0")</small>
                            </li>
                        }
                    </ul>
                    <p class="note">OVR trung bình 11 người đá chính (đội hình gốc) theo tuyến; vạch trắng = trung bình các CLB cùng giải. Mô phỏng tính sức mạnh bằng 11 người này.</p>

                    <h3>Ngôi sao</h3>
                    <div class="stars-row">
                        @foreach (var p in stars)
                        {
                            <div class="pl tier-@(CardTier(p.Ovr))">
                                <span class="o">@p.Ovr</span><span class="ps">@p.Position</span>
                                <Face Id="p.Id" Name="@p.Name" Size="md" />
                                <b>@p.Name</b>
                                <small>@(p.Age is { } a ? $"{a} tuổi" : "")</small>
                                <small class="price">@Fmt.Money(p.Price)</small>
                            </div>
                        }
                    </div>
                    @if (youth is not null)
                    {
                        <div class="youth"><i class="ms fill" aria-hidden="true">auto_awesome</i><span><small>Trẻ đáng chú ý</small><b>@youth.Name</b></span>
                            <span class="meta">@youth.Position · @youth.Age tuổi</span><span class="cx-ovr">@youth.Ovr</span></div>
                    }

                    <h3>Đội hình (@cd.Players.Count)</h3>
                    <p class="note legend"><i></i>Đá chính (11 ô đầu đội hình) · lương tính mỗi trận</p>
                    @foreach (var g in cd.Players.GroupBy(p => p.Position.Group()).OrderBy(g => g.Key))
                    {
                        <h4>@LineName(g.Key) <small>@g.Count()</small></h4>
                        <ul class="squad">
                            @foreach (var p in g.OrderByDescending(p => p.Starter).ThenByDescending(p => p.Ovr))
                            {
                                <li class="@(p.Starter ? "st" : "")">
                                    <span class="ps">@p.Position</span>
                                    <span class="who"><b>@p.Name</b><small>@(p.Age is { } a ? $"{a} tuổi · " : "")số @p.Shirt@(p.ContractLeft is { } cl ? $" · HĐ {cl} trận" : "")</small></span>
                                    <span class="cx-ovr tier-@(CardTier(p.Ovr))">@p.Ovr</span>
                                    <span class="money"><b>@Fmt.Money(p.Price)</b><small>lương @K(p.Wage)</small></span>
                                </li>
                            }
                        </ul>
                    }

                    <h3>Tài chính</h3>
                    <div class="nums money">
                        <div class="cx-stat"><span>Vé / trận sân nhà</span><b>@K(cd.TicketIncome)</b><small>@cd.Capacity.ToString("N0") chỗ · @cd.Fans.ToString("N0") fan · vé @cd.TicketPrice</small></div>
                        <div class="cx-stat"><span>Tài trợ / trận</span><b>@K(cd.Sponsor)</b><small>theo uy tín CLB</small></div>
                        <div class="cx-stat"><span>Bản quyền TV / trận</span><b>@K(FinanceRules.TvPerRound)</b><small>thưởng thắng +@K(FinanceRules.WinPrize) · hoà +@K(FinanceRules.DrawPrize)</small></div>
                        <div class="cx-stat"><span>Chi / trận</span><b class="cx-down">−@K(cd.WageBill + cd.Capacity * FinanceRules.UpkeepPerSeat)</b><small>lương @K(cd.WageBill) · bảo trì sân @K(cd.Capacity * FinanceRules.UpkeepPerSeat)</small></div>
                    </div>

                    <h3>Lịch sử</h3>
                    @if (cd.History.Count == 0)
                    {
                        <div class="empty"><i class="ms" aria-hidden="true">history</i><span><b>Chưa có mùa nào</b><small>@(firstSeason ? $"{Fmt.Season(seasonName ?? "1")} là mùa đầu tiên của sự nghiệp." : "CLB chưa đá xong mùa nào trong sự nghiệp.")</small></span></div>
                    }
                    else
                    {
                        <ul class="hist">
                            @foreach (var h in cd.History)
                            {
                                <li>
                                    <em>@Fmt.Season(h.Season)</em>
                                    <span class="champ"><LeagueLogo Name="@h.League.Name" Logo="@h.League.Logo" Small="true" /><b>@(h.Position is { } ps ? $"Hạng {ps}/{h.Teams}" : "–")</b></span>
                                    @foreach (var t in h.Titles) { <small class="cx-up"><i class="ms fill" aria-hidden="true">emoji_events</i>@t.Name</small> }
                                </li>
                            }
                        </ul>
                    }

                    <div class="foot">
                        <button class="cx-cta" @onclick="() => { pick = cc; clubDetail = null; step = 3; }"><span><b>Chọn CLB này</b><small>Xem thư của chủ tịch @cd.Name</small></span><i class="ms fill" aria-hidden="true">arrow_forward</i></button>
                    </div>
                </section>
            </div>
        }
    }
    else if (step == 3 && pick is { } pk)
    {
        @* PO duyệt mockup 19/11: chủ tịch (SVG) chào trong phòng họp nhìn ra sân; bấm Bắt đầu → cảnh ra mắt HLV trong lúc dựng mùa. *@
        @if (!starting) { <button class="cx-back" @onclick="() => step = 2"><i class="ms" aria-hidden="true">arrow_back</i>Đổi CLB</button> }
        <h1>@(starting ? "Chào mừng HLV mới" : "Ban lãnh đạo chào bạn")</h1>
        <section class="cx-board @(starting ? "unveil" : "greet")" data-logo="@pk.LogoPath" aria-label="Phòng họp ban lãnh đạo @pk.Name">
            <BoardRoom />
            @if (!starting)
            {
                <div class="fig"><Chairman Club="@pk.Name" /></div>
                <div class="note">
                    <i class="tail" aria-hidden="true"></i>
                    <div class="from"><Crest Name="@pk.Name" Logo="@pk.LogoPath" Large="true" /><span>Thư từ chủ tịch<b>@pk.Name</b></span></div>
                    <p class="l1">Chào HLV mới. Chúng tôi giao cho bạn đội hình trị giá <b>@Fmt.Money(pk.SquadValue)</b> và ngân sách <b>@Fmt.Money(pk.Budget)</b>.</p>
                    <p class="l2">Mục tiêu mùa này ở bên dưới. Chúc may mắn, khán đài đang chờ bạn.</p>
                    <div class="sig"><svg viewBox="0 0 120 34" aria-hidden="true"><path d="M4 24 C14 6 20 6 18 20 C16 30 26 12 34 14 C40 16 34 28 42 24 C50 20 52 8 58 10 C64 12 56 26 64 24 C74 22 80 14 90 16 C98 18 104 22 116 12" /></svg><span>Chủ tịch @pk.Name</span></div>
                </div>
            }
            else
            {
                <div class="fig"><Chairman Club="@pk.Name" Scarf="true" /></div>
                <div class="flashes" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
                <div class="shade" aria-hidden="true"></div>
                <div class="ban">
                    <span class="chip"><i class="ms fill" aria-hidden="true">photo_camera</i>Họp báo ra mắt</span>
                    <b><small>HLV mới của</small>@pk.Name</b>
                    <span>Chủ tịch giới thiệu bạn trước báo giới.</span>
                </div>
                <div class="flash-all" aria-hidden="true"></div>
            }
        </section>
        @if (!starting)
        {
            <h2 class="cx-goals-h">Mục tiêu @(seasonName ?? "mùa này")</h2>
            <ul class="cx-goals">
                <li><i class="ms fill" aria-hidden="true">flag</i><span>@pk.League: <b>@Objective(pk)</b></span></li>
                @foreach (var cup in pk.Cups) { <li><i class="ms fill" aria-hidden="true">emoji_events</i><span>@cup: <b>đi càng xa càng tốt</b></span></li> }
                <li><i class="ms fill" aria-hidden="true">savings</i><span>Tài chính: <b>không để quỹ âm</b></span></li>
            </ul>
            <button class="cx-cta solo" data-confirm="Bắt đầu sự nghiệp với @pk.Name?" @onclick="Start">
                <span><b>Bắt đầu mùa giải</b><small>@pk.Name · @pk.League</small></span>
                <i class="ms fill" aria-hidden="true">rocket_launch</i>
            </button>
        }
        else
        {
            <div class="cx-board-prog" role="status">
                <div><b>Đang dựng mùa giải</b><span>Ghi lịch cả mùa, mở chợ hè (khoảng nửa phút)</span></div>
                <i aria-hidden="true"></i>
            </div>
        }
    }
</div>

@code {
    [CascadingParameter] public CareerLayout? Shell { get; set; }

    Guid? me, seasonId, clubId;
    bool loaded, taken, starting, autoLineup = true, canNext;
    List<string> champion = [];
    string? club, seasonName, league, error;
    CareerClubChoice? pick;
    IReadOnlyList<CareerClubChoice> choices = [];
    NextMatch? next;
    int step = 1;

    sealed record NextMatch(Guid Id, string Home, string? HomeLogo, Guid HomeId, string Away, string? AwayLogo, Guid AwayId, string Competition, int Slot)
    {
        public string HomeOvr { get; set; } = "–";
        public string AwayOvr { get; set; } = "–";
        public string HomeForm { get; set; } = "";
        public string AwayForm { get; set; } = "";
    }
    sealed record Current(Guid Id, int Number, int BotLeft, Guid? MineFixture);
    sealed record ResultRow(Guid Id, string Competition, string Opponent, string? OppLogo, bool Home, string Score, string Result);
    sealed record TableRow(int Pos, string Club, string? Logo, int P, int GD, int Pts, bool Mine);
    sealed record CupRow(string Name, string State);
    sealed record Star(Guid Id, string Name, string Position, int Ovr, int Tier, string Why, IReadOnlyList<(string Label, int Value, bool Cyan)> Attrs);
    Current? current;
    int slots;
    string? leagueName;
    long budget;
    int? myPos;
    (int W, int D, int L) tally;
    List<ResultRow> recent = [];
    List<TableRow> table = [];
    List<CupRow> cups = [];
    List<InboxItem> tasks = [];
    BoardStatus? board;
    Star? star;
    string? newFeature;
    int? marketLeft, marketNext;
    bool marketOpen;

    /// <summary>Top 3 + 2 đội quanh CLB mình.</summary>
    IEnumerable<TableRow> TableSnippet => table.Where(r => r.Pos <= 3 || (myPos is { } p && Math.Abs(r.Pos - p) <= 2));

    IEnumerable<(string Name, int Count, double Ovr, string Country, int Tier)> Leagues => choices.GroupBy(c => (c.League, c.Tier, c.Country))
        .OrderBy(g => g.Key.Tier).ThenByDescending(g => g.Average(c => c.Ovr)).Select(g => (g.Key.League, g.Count(), g.Average(c => c.Ovr), g.Key.Country, g.Key.Tier));

    /// <summary>Bước 1: logo giải quốc nội (lấy từ game); bảng chi tiết giải đang mở.</summary>
    Dictionary<string, string?> leagueLogos = [];
    CareerLeagueInfo? detail;
    bool firstSeason;
    static string Range(int from, int count) => count == 1 ? $"{from}" : $"{from}–{from + count - 1}";
    static int CardTier(int ovr) => ovr >= 88 ? 3 : ovr >= 82 ? 2 : ovr >= 75 ? 1 : 0;

    IEnumerable<CareerClubChoice> LeagueClubs => choices.Where(c => c.League == league).OrderByDescending(c => c.Ovr);

    string MarketLine => current is null ? "Mùa giải đã xong"
        : marketOpen ? $"Chợ chuyển nhượng mở · còn {marketLeft} khung"
        : marketNext is { } mn ? $"Chợ mở lại ở khung {mn}" : "Chợ đã đóng tới hết mùa";

    static int Stars(double ovr) => Math.Clamp((int)Math.Round((ovr - 64) / 3), 1, 5);
    static string TierLabel(int tier) => tier switch { 3 => "Huyền thoại", 2 => "Thẻ vàng", 1 => "Thẻ bạc", _ => "Thẻ đồng" };

    (string Label, string Css) Difficulty(CareerClubChoice c)
    {
        var list = LeagueClubs.ToList();
        var rank = list.IndexOf(c);
        return rank < Math.Max(1, list.Count / 5) ? ("Ứng viên vô địch", "ok") : rank < list.Count / 2 ? ("Tầm trung", "") : ("Thử thách", "bad");
    }

    string Objective(CareerClubChoice c) => BoardRules.Objective(ExpectedPos(c), choices.Count(x => x.League == c.League));

    /// <summary>Hạng kỳ vọng = hạng giá trị đội hình trong giải (như BoardService).</summary>
    int ExpectedPos(CareerClubChoice c) => choices.Where(x => x.League == c.League).OrderByDescending(x => x.SquadValue).ToList().IndexOf(c) + 1;

    /// <summary>Bước 2: bảng chi tiết CLB đang mở (PO 19/11).</summary>
    CareerClubInfo? clubDetail;
    /// <summary>Tiền nhỏ (lương, thu chi mỗi trận): dưới 1 tr ghi theo nghìn ("3.5k") cho khỏi thành "0 tr".</summary>
    static string K(long v) => Math.Abs(v) >= 1_000_000 ? Fmt.Money(v) : (v / 1000.0).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "k";
    static string LineName(PositionGroup g) => g switch { PositionGroup.Goalkeeper => "Thủ môn", PositionGroup.Defender => "Hậu vệ", PositionGroup.Midfielder => "Tiền vệ", _ => "Tiền đạo" };
    /// <summary>Thanh OVR: 50 → 0%, 95 → 100%.</summary>
    static string Pct(double ovr) => Math.Clamp((ovr - 50) / 45 * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "%";

    async Task OpenClub(CareerClubChoice c)
    {
        if (seasonId is not { } sid) return;
        try { clubDetail = await Q.CareerClubAsync(sid, c.ClubId, Store, Clock); }
        catch (Exception ex) { error = $"Không mở được chi tiết {c.Name}: {ex.Message}"; }
        if (clubDetail is null) { pick = c; step = 3; }
    }

    protected override async Task OnInitializedAsync()
    {
        Jobs.Changed += OnJob;
        me = await Me.ManagerIdAsync();
        await LoadAsync();
        loaded = true;
    }

    async Task LoadAsync()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        if (me is { } id)
        {
            var mine = await (from a in db.TeamAssignments join c in db.Clubs on a.ClubId equals c.Id
                              where a.ParticipantId == id && a.To == null && a.ControllerType == ControllerType.Human select new { c.Id, c.Name, c.LogoPath, c.AutoLineup }).FirstOrDefaultAsync();
            if (mine is not null)
            {
                club = mine.Name;
                clubId = mine.Id;
                autoLineup = mine.AutoLineup;
                budget = await db.Ledger.Where(e => e.ClubId == mine.Id).SumAsync(e => e.Amount);
                await new TransferOfferService(db, Clock).ExpireStaleAsync();
                var season = await db.Seasons.Where(s => s.Status == SeasonStatus.Active).OrderBy(s => s.Number).FirstOrDefaultAsync()
                    ?? await db.Seasons.Where(s => s.Status == SeasonStatus.Finished).OrderByDescending(s => s.Number).FirstOrDefaultAsync();
                seasonName = season?.Name;
                if (season is not null) await LoadClubAsync(db, season.Id, mine.Id);
                champion = [.. cups.Where(c => c.State.Contains("Vô địch")).Select(c => c.Name)];
                canNext = false;
                if (season?.Status == SeasonStatus.Finished && myPos == 1 && leagueName is not null) champion.Insert(0, leagueName);
                if (season?.Status == SeasonStatus.Finished)
                    canNext = await new SeasonRolloverService(db, Store, Clock).ReadyAsync() is not null
                        || await new Pes17CareerService(db, Store, Clock).PendingSeasonAsync() is { Number: > 1 };
                return;
            }
        }
        club = null;
        var career = new Pes17CareerService(db, Store, Clock);
        var pending = await career.PendingSeasonAsync();
        seasonId = pending?.Id;
        if (pending is null) return;
        seasonName = pending.Name;
        firstSeason = pending.Number == 1;
        taken = await career.HasCoachAsync();
        if (taken) return;
        choices = await career.ChoicesAsync(pending.Id);
        leagueLogos = (await Q.EditionsAsync(pending.Id)).Where(e => e.Type == CompetitionType.DomesticLeague).GroupBy(e => e.Name).ToDictionary(g => g.Key, g => g.First().Logo);
    }

    async Task LoadClubAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        var fixtures = await (from f in db.Fixtures join m in db.Matchdays on f.MatchdayId equals m.Id
                              join e in db.Editions on f.CompetitionEditionId equals (Guid?)e.Id join comp in db.Competitions on e.CompetitionId equals comp.Id
                              join h in db.Clubs on f.HomeClubId equals h.Id join w in db.Clubs on f.AwayClubId equals w.Id
                              where m.SeasonId == seasonId && (f.HomeClubId == mineId || f.AwayClubId == mineId)
                              orderby m.Number
                              select new { F = f, Slot = m.Number, EditionId = e.Id, Comp = comp.Name, comp.Type, Home = h.Name, HomeLogo = h.LogoPath, Away = w.Name, AwayLogo = w.LogoPath })
            .AsNoTracking().ToListAsync();
        string Label(string comp, FixtureStage stage, int? leg) => stage == FixtureStage.League ? comp : $"{comp} · {AdminText.SlotKind(stage, leg)}";

        next = fixtures.Where(x => x.F.Status != FixtureStatus.Played)
            .Select(x => new NextMatch(x.F.Id, x.Home, x.HomeLogo, x.F.HomeClubId, x.Away, x.AwayLogo, x.F.AwayClubId, Label(x.Comp, x.F.Stage, x.F.Leg), x.Slot)).FirstOrDefault();

        var played = fixtures.Where(x => x.F.Status == FixtureStatus.Played && x.F.HomeGoals is not null).ToList();
        string Result(Fixture f) => f.WinnerClubId() is { } w ? (w == mineId ? "W" : "L") : f.HomeGoals == f.AwayGoals ? "D" : (f.HomeGoals > f.AwayGoals) == (f.HomeClubId == mineId) ? "W" : "L";
        tally = (played.Count(x => Result(x.F) == "W"), played.Count(x => Result(x.F) == "D"), played.Count(x => Result(x.F) == "L"));
        recent = [.. played.TakeLast(6).Select(x =>
        {
            var home = x.F.HomeClubId == mineId;
            return new ResultRow(x.F.Id, Label(x.Comp, x.F.Stage, x.F.Leg), home ? x.Away : x.Home, home ? x.AwayLogo : x.HomeLogo, home,
                home ? Fmt.Score(x.F.HomeGoals, x.F.AwayGoals, x.F.HomePenalties, x.F.AwayPenalties) : Fmt.Score(x.F.AwayGoals, x.F.HomeGoals, x.F.AwayPenalties, x.F.HomePenalties),
                Result(x.F));
        })];

        // Giải quốc nội: vị trí + bảng
        var league = await (from x in db.EditionClubs join e in db.Editions on x.EditionId equals e.Id join c in db.Competitions on e.CompetitionId equals c.Id
                            where e.SeasonId == seasonId && x.ClubId == mineId && c.Type == CompetitionType.DomesticLeague select new { e.Id, c.Name }).FirstOrDefaultAsync();
        if (league is not null)
        {
            leagueName = league.Name;
            var rows = await new CompetitionService(db, Store, Clock).GetEditionStandingsAsync(league.Id);
            var ids = rows.Select(r => r.Club).ToList();
            var names = await db.Clubs.Where(c => ids.Contains(c.Id)).ToDictionaryAsync(c => c.Id, c => new { c.Name, c.LogoPath });
            table = [.. rows.Select((r, i) => new TableRow(i + 1, names[r.Club].Name, names[r.Club].LogoPath, r.Played, r.GoalDifference, r.Points, r.Club == mineId))];
            myPos = table.FirstOrDefault(r => r.Mine)?.Pos;
        }

        // Cúp: đang dự / bị loại / vô địch
        var cupEditions = fixtures.Where(x => x.Type != CompetitionType.DomesticLeague).GroupBy(x => (x.EditionId, x.Comp)).ToList();
        var editionIds = cupEditions.Select(g => g.Key.EditionId).ToList();
        var stages = (await db.Fixtures.Where(f => f.CompetitionEditionId != null && editionIds.Contains(f.CompetitionEditionId.Value))
                .Select(f => new { Edition = f.CompetitionEditionId!.Value, f.Stage }).Distinct().ToListAsync())   // Stage lưu dạng chuỗi → so thứ tự ở client
            .GroupBy(x => x.Edition).ToDictionary(g => g.Key, g => g.Max(x => x.Stage));
        cups = [.. cupEditions.Select(g =>
        {
            var open = g.FirstOrDefault(x => x.F.Status != FixtureStatus.Played);
            if (open is not null) return new CupRow(g.Key.Comp, $"Đang dự · {AdminText.SlotKind(open.F.Stage, open.F.Leg)}");
            var last = g.Last().F;
            if (last.Stage == FixtureStage.Final) return new CupRow(g.Key.Comp, last.WinnerClubId() == mineId ? "Vô địch" : "Á quân");
            return stages.GetValueOrDefault(g.Key.EditionId) > last.Stage
                ? new CupRow(g.Key.Comp, $"Bị loại · {AdminText.Stage(last.Stage)}")
                : new CupRow(g.Key.Comp, $"Chờ vòng sau (đã đá {AdminText.Stage(last.Stage)})");
        })];

        slots = await db.Matchdays.CountAsync(m => m.SeasonId == seasonId);
        var md = await new Pes17CareerService(db, Store, Clock).OpenMatchdayAsync(seasonId);
        current = null;
        if (md is not null)
        {
            var left = await db.Fixtures.Where(f => f.MatchdayId == md.Id && f.Status != FixtureStatus.Played)
                .Select(f => new { f.Id, Mine = (f.HomeClubId == mineId || f.AwayClubId == mineId) && !f.AssistantPlays }).ToListAsync();
            current = new Current(md.Id, md.Number, left.Count(x => !x.Mine), left.FirstOrDefault(x => x.Mine)?.Id);
        }

        // Chợ chuyển nhượng
        var window = await new FreeMarketService(db, Clock).WindowAsync(seasonId);
        marketOpen = window is not null && window.IsOpenAt(Clock.GetUtcNow());
        var at = Math.Max(current?.Number ?? slots, 1);
        marketLeft = marketOpen ? CareerUnlocks.MarketSlotsLeft(at, slots) : null;
        marketNext = marketOpen ? null : CareerUnlocks.NextMarketSlot(at, slots);

        board = await new BoardService(db, Clock).StatusAsync(seasonId, mineId);
        await LoadNextAsync(db, seasonId);
        await LoadStarAsync(db, seasonId, mineId);
        await LoadTasksAsync(db, seasonId, mineId);
    }

    /// <summary>OVR (TB 11 người cao nhất) và phong độ 5 trận của 2 đội trận tới.</summary>
    async Task LoadNextAsync(ClubsDbContext db, Guid seasonId)
    {
        if (next is not { } n) return;
        Guid[] both = [n.HomeId, n.AwayId];
        var ovrs = (await (from m in db.SquadMemberships join p in db.PlayerPrices on m.PlayerId equals p.PlayerId
                           where m.LeftAt == null && p.SeasonId == seasonId && both.Contains(m.ClubId) select new { m.ClubId, p.Overall }).ToListAsync())
            .GroupBy(x => x.ClubId).ToDictionary(g => g.Key, g => g.Select(x => x.Overall).OrderDescending().Take(11).DefaultIfEmpty(0).Average());
        var games = await (from f in db.Fixtures join m in db.Matchdays on f.MatchdayId equals m.Id
                           where m.SeasonId == seasonId && f.Status == FixtureStatus.Played && f.HomeGoals != null
                                 && (both.Contains(f.HomeClubId) || both.Contains(f.AwayClubId))
                           orderby m.Number descending
                           select f).AsNoTracking().ToListAsync();
        string Form(Guid club) => string.Concat(games.Where(f => f.HomeClubId == club || f.AwayClubId == club).Take(5).Reverse().Select(f =>
            f.WinnerClubId() is { } w ? (w == club ? 'W' : 'L') : f.HomeGoals == f.AwayGoals ? 'D' : (f.HomeGoals > f.AwayGoals) == (f.HomeClubId == club) ? 'W' : 'L'));
        n.HomeOvr = ovrs.TryGetValue(n.HomeId, out var ho) ? ho.ToString("0") : "–";
        n.AwayOvr = ovrs.TryGetValue(n.AwayId, out var ao) ? ao.ToString("0") : "–";
        n.HomeForm = Form(n.HomeId);
        n.AwayForm = Form(n.AwayId);
    }

    /// <summary>Ngôi sao của đội: ghi nhiều bàn nhất mùa này, chưa ai ghi bàn thì OVR cao nhất.</summary>
    async Task LoadStarAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        var squad = await (from m in db.SquadMemberships join p in db.Players on m.PlayerId equals p.Id join pr in db.PlayerPrices on p.Id equals pr.PlayerId
                           where m.ClubId == mineId && m.LeftAt == null && pr.SeasonId == seasonId
                           select new { p.Id, p.Name, p.Position, pr.Overall }).ToListAsync();
        if (squad.Count == 0) { star = null; return; }
        var ids = squad.Select(s => s.Id).ToList();
        var goals = await (from g in db.Goals join f in db.Fixtures on g.FixtureId equals f.Id join m in db.Matchdays on f.MatchdayId equals m.Id
                           where m.SeasonId == seasonId && g.ClubId == mineId && g.ScorerPlayerId != null && ids.Contains(g.ScorerPlayerId.Value)
                           group g by g.ScorerPlayerId into k select new { Id = k.Key!.Value, N = k.Count() }).ToDictionaryAsync(x => x.Id, x => x.N);
        var top = goals.Count > 0
            ? squad.OrderByDescending(s => goals.GetValueOrDefault(s.Id)).ThenByDescending(s => s.Overall).First()
            : squad.OrderByDescending(s => s.Overall).First();
        var values = await db.PlayerAttributes.Where(a => a.PlayerId == top.Id && a.SeasonId == seasonId).Select(a => a.Values).FirstOrDefaultAsync() ?? [];
        int V(string k) => values.GetValueOrDefault(k);
        IReadOnlyList<(string, int, bool)> attrs = top.Position == Position.GK
            ? [("Bắt bóng", V("GOAL KEEPING"), false), ("Phản xạ", V("PES17_REFLEXES"), true), ("Giữ bóng", V("PES17_CATCHING"), false), ("Phá bóng", V("PES17_CLEARING"), true), ("Bật nhảy", V("JUMP"), false)]
            : [("Tốc", V("TOP SPEED"), true), ("Sút", V("SHOT ACCURACY"), false), ("Chuyền", V("SHORT PASS ACCURACY"), true), ("Rê", V("DRIBBLE ACCURACY"), false), ("Thể lực", V("STAMINA"), true)];
        var n = goals.GetValueOrDefault(top.Id);
        star = new Star(top.Id, top.Name, top.Position.ToString(), top.Overall, top.Overall >= 88 ? 3 : top.Overall >= 82 ? 2 : top.Overall >= 75 ? 1 : 0,
            n > 0 ? $"Ghi {n} bàn mùa này" : "OVR cao nhất đội", attrs);
    }

    /// <summary>Việc cần làm (≤3) từ hộp thư HLV; mục đã có thẻ riêng hoặc trỏ tới tính năng chưa mở thì đưa về hộp thư.</summary>
    async Task LoadTasksAsync(ClubsDbContext db, Guid seasonId, Guid mineId)
    {
        var p = Shell?.P;
        string? Gate(string? link) => link switch
        {
            null => null,
            "tap-luyen" when p is not null && !p.Has(CareerUnlocks.Training) => null,
            "tai-chinh" when p is not null && !p.Has(CareerUnlocks.Finance) => null,
            "chuyen-nhuong" when p is not null && !p.Has(CareerUnlocks.Transfer) => "clb",
            _ => link,
        };
        var desk = await new MediaService(db, Clock).DeskAsync(seasonId, mineId);
        tasks = [.. desk.Inbox.Where(i => i.Kind != InboxKind.Info && !(i.Link ?? "").StartsWith("chuan-bi"))
            .OrderBy(i => i.Kind == InboxKind.Task ? 0 : 1).Take(3).Select(i => i with { Link = Gate(i.Link) })];
        newFeature = p?.Unlocked.Where(p.IsNew).OrderBy(f => CareerUnlocks.Introduced.ToList().IndexOf(f)).LastOrDefault();
    }

