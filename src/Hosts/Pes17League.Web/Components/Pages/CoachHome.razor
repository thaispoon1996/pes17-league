@page "/hlv"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject CurrentUser Me
@inject TimeProvider Clock
@inject NavigationManager Nav

<PageTitle>Hồ sơ HLV</PageTitle>

@* Hồ sơ HLV career (PO 19/11): thẻ, hợp đồng, danh tiếng, bằng + khoá học, năng lực (điểm tự do), căng thẳng. Ví, mức sống, tài sản, sổ ví, album → /cuoc-song (PO 20/11).
   Chưa có / đang tạo hồ sơ → các bước tạo HLV. *@
@if (!loaded) { <div class="cx-loading"><i></i><i></i><i></i></div>; return; }
@if (me == Guid.Empty) { <p class="cx-msg neg">Cần đăng nhập bằng tài khoản người chơi.</p>; return; }
@if (pf is null || pf.Coach.Status == CoachStatus.Creating)
{
    <CoachMaker OnDone="Done" />
    return;
}
@{
    var c = pf.Coach; var k = pf.Contract; var face = CoachUi.FaceUrl(c); var card = CoachRules.RepCard(c.Reputation);
    var origin = CoachRules.Origin(c.Origin); var trait = CoachRules.Trait(c.Trait);
    var nextRep = c.Reputation < 25 ? 25 : c.Reputation < 50 ? 50 : c.Reputation < 75 ? 75 : 0;
    var sel = Math.Clamp(skill, 0, CoachRules.SkillCount - 1); var sd = CoachRules.SkillDefs[sel];
    var sv = c.Skills[sel]; var se = CoachRules.Effective(c, sd.Skill);
}

@* Trang hồ sơ HLV kiểu trang hero (PO ok mockup 20/11): sân khấu chân dung + tên lớn, 3 thước, năng lực chọn-xem-chi tiết + radar, tab. *@
<div class="hx" data-t="@card">
    @if (msg is not null) { <p class="cx-msg @(ok ? null : "neg")" role="status">@msg</p> }

    @if (editFace)
    {
        <section class="hlv-panel hx-facepanel" id="doi-anh" aria-labelledby="hx-fp">
            <h2 id="hx-fp"><i class="ms" aria-hidden="true">photo_camera</i>Đổi ảnh HLV</h2>
            <p class="hlv-note">Tải ảnh chân dung nhìn thẳng, kéo và phóng cho mặt nằm gọn trong khung rồi bấm Lưu ảnh. Ảnh mới dùng ngay trên thẻ HLV, họp báo, ảnh lưu niệm và tin tức.</p>
            <div class="hlv-facegrid">
                <CoachFacePicker C="c" ManagerId="me" Changed="FaceChanged">
                    <button class="cx-btn ghost" @onclick="() => editFace = false"><i class="ms" aria-hidden="true">close</i>Xong</button>
                </CoachFacePicker>
                <div class="hlv-cardwrap"><CoachCard C="c" /></div>
            </div>
        </section>
    }

    <header class="hx-hero">
        @if (!editFace) { <button class="cx-btn ghost sm hx-photo" @onclick="OpenFace"><i class="ms" aria-hidden="true">photo_camera</i>Đổi ảnh</button> }
        <div class="hx-stage" aria-hidden="true">
            <b class="hx-num">@c.Reputation</b>
            <i class="hx-beam"></i><i class="hx-pitch"></i><i class="hx-ring"></i>
            <div class="hx-face @(face is null ? "none" : CoachUi.FaceCut(c) ? "cut" : "flat")">
                @if (face is not null) { <img src="@face" alt="" /> }
                else { <i class="ms fill">person</i> }
            </div>
            <span class="hx-tier">@CoachRules.RepTier(c.Reputation)</span>
        </div>

        <div class="hx-who">
            <div class="hx-chips">
                <span class="hx-chip"><i class="ms" aria-hidden="true">@origin.Icon</i>@origin.Name</span>
                <span class="hx-chip" title="@trait.Effect"><i class="ms" aria-hidden="true">auto_awesome</i>@trait.Name</span>
                <span class="hx-chip tier"><i class="ms fill" aria-hidden="true">shield</i>Thẻ @CoachUi.TierName(card).ToLowerInvariant()</span>
                @if (k is not null)
                {
                    <span class="hx-chip club"><Crest Name="@(pf.ClubName ?? "")" Logo="@pf.ClubLogo" />@pf.ClubName</span>
                }
            </div>
            <h1 class="hx-name">@c.Name</h1>
            <div class="hx-meta">
                @if (!string.IsNullOrWhiteSpace(c.Nickname)) { <span><i class="ms" aria-hidden="true">format_quote</i><b>@c.Nickname</b></span> }
                <span><i class="ms" aria-hidden="true">cake</i><b>@c.Age</b> tuổi</span>
                <span><i class="ms" aria-hidden="true">flag</i>@c.Nationality</span>
                <span><i class="ms" aria-hidden="true">grid_view</i>Sơ đồ <b>@c.Formation</b></span>
                <span><i class="ms" aria-hidden="true">tune</i>Lối chơi <b>@c.Style</b></span>
            </div>

            <div class="hx-gauges">
                <div class="hx-g rep">
                    <h2>Danh tiếng</h2>
                    <b class="v"><span data-count="@c.Reputation">@c.Reputation</span><small>/100</small></b>
                    <div class="hx-track"><i style="--w:@Math.Clamp(c.Reputation, 0, 100)%"></i><u style="left:25%"></u><u style="left:50%"></u><u style="left:75%"></u></div>
                    <p>@CoachRules.RepTier(c.Reputation)@(nextRep > 0 ? $" · thêm {nextRep - c.Reputation} để lên {CoachRules.RepTier(nextRep)} ({nextRep})" : " · bậc cao nhất")</p>
                </div>
                <div class="hx-g lic">
                    <h2>Bằng huấn luyện</h2>
                    <b class="v sm">@(c.License > 0 ? "Bằng " + CoachRules.Licenses[c.License] : "Chưa có")</b>
                    <div class="hx-lic">
                        @for (var l = 1; l < CoachRules.Licenses.Length; l++)
                        {
                            <span class="@(l <= c.License ? "on" : l == (c.CourseLicense > 0 ? c.CourseLicense : c.License + 1) ? "next" : null)">@CoachRules.Licenses[l]</span>
                        }
                    </div>
                    @if (c.CourseLicense > 0)
                    {
                        <p>Đang học bằng <b>@CoachRules.Licenses[c.CourseLicense]</b>, còn <b>@c.CourseRoundsLeft</b> vòng. Học xong được thêm 1 điểm năng lực.</p>
                    }
                    else if (c.License < CoachRules.Courses.Length)
                    {
                        var course = CoachRules.Courses[c.License]; var fee = CoachRules.CourseFee(course, c.Trait);
                        <p>Khoá bằng @CoachRules.Licenses[course.License]: @course.Rounds vòng, học phí @CoachUi.Cash(fee).</p>
                        <button class="cx-btn ghost sm" disabled="@(busy || pf.Wallet < fee)" data-confirm="Ghi danh khoá bằng @CoachRules.Licenses[course.License], học phí @CoachUi.Cash(fee)?" @onclick="Course">
                            <i class="ms" aria-hidden="true">school</i>@(pf.Wallet < fee ? "Ví chưa đủ học phí" : "Ghi danh")
                        </button>
                    }
                    else { <p>Đã có bằng cao nhất.</p> }
                </div>
                <div class="hx-g st @(c.Stress >= 70 ? "hot" : null)">
                    <h2>Căng thẳng</h2>
                    <b class="v"><span data-count="@c.Stress">@c.Stress</span><small>/100</small></b>
                    <div class="hx-track"><i style="--w:@Math.Clamp(c.Stress, 0, 100)%"></i><u style="left:70%"></u><u style="left:@(CoachRules.BurnoutAt)%"></u></div>
                    <p>@(c.Stress >= CoachRules.BurnoutAt ? "Nguy cơ kiệt sức" : c.Stress >= 70 ? "Cao · đang giảm năng lực" : "Ổn · từ 70 bắt đầu giảm năng lực")</p>
                </div>
            </div>

            <p class="hx-bio">
                @c.Name, @c.Age tuổi, người @c.Nationality. @origin.Description
                @if (bio)
                {
                    <span> Tính cách @trait.Name.ToLowerInvariant(): @trait.Effect.ToLowerInvariant(). @(k is not null ? $"Đang dẫn {pf.ClubName}, hợp đồng hết hạn cuối mùa {k.EndSeasonNumber}." : "Hiện chưa dẫn CLB nào.")</span>
                }
            </p>
            <button class="hx-more" aria-expanded="@(bio ? "true" : "false")" @onclick="() => bio = !bio">@(bio ? "Thu gọn" : "Đọc tiếp")<i class="ms" aria-hidden="true">@(bio ? "expand_less" : "expand_more")</i></button>

            <div class="hx-acts">
                @if (k is not null && !k.Launched)
                {
                    <button class="cx-btn gold" @onclick="() => press = true"><i class="ms" aria-hidden="true">photo_camera</i>Họp báo ra mắt</button>
                }
                else if (k is null)
                {
                    <a class="cx-btn gold" href="hlv/viec-lam"><i class="ms" aria-hidden="true">work</i>Tìm việc</a>
                }
                <a class="cx-btn ghost" href="thu-hlv"><i class="ms" aria-hidden="true">mail</i>Thư HLV@(pf.Unread > 0 ? $" ({pf.Unread})" : "")</a>
            </div>
        </div>
    </header>

    <details class="hx-how">
        <summary>Danh tiếng và căng thẳng thay đổi thế nào</summary>
        <p>CLB vừa cần danh tiếng 30 + bằng C, CLB lớn 55 + bằng B, ông lớn 75 + bằng A. Thắng đội mạnh hơn, đạt mục tiêu mùa và họp báo tốt sẽ tăng danh tiếng; bị sa thải trừ 8.</p>
        <p>Thua trận tăng căng thẳng, thắng giảm. Mức sống và tài sản giúp hạ mỗi vòng. Từ 70 giảm Con người, Truyền thông; từ 85 giảm Huấn luyện; từ @CoachRules.BurnoutAt dễ kiệt sức.</p>
    </details>

    <section class="hx-sec" aria-labelledby="hx-nl">
        <div class="hx-sh">
            <h2 id="hx-nl">Năng lực</h2>
            <span>@if (c.FreePoints > 0) { <b>@c.FreePoints điểm tự do</b> } else { <text>Kinh nghiệm @c.Xp/@CoachRules.XpPerPoint tới điểm kế tiếp</text> } · tối đa @CoachRules.SkillMax mỗi năng lực</span>
        </div>
        @if (c.FreePoints == 0) { <div class="hx-xp" aria-hidden="true"><i style="width:@(c.Xp * 100 / CoachRules.XpPerPoint)%"></i></div> }
        <div class="hx-abil">
            <div class="hx-abl">
                <div class="hx-sks" role="group" aria-label="Chọn năng lực">
                    @for (var i = 0; i < CoachRules.SkillCount; i++)
                    {
                        var ix = i; var d = CoachRules.SkillDefs[i]; var e = CoachRules.Effective(c, d.Skill);
                        <button class="hx-sk @(e < 10 ? "lo" : e > 10 ? "hi" : null)" aria-pressed="@(ix == sel ? "true" : "false")" @onclick="() => skill = ix">
                            <i class="ms" aria-hidden="true">@d.Icon</i><b>@e</b><small>@d.Short</small>
                        </button>
                    }
                </div>
                <div class="hx-det" aria-live="polite">
                    <i class="ms hx-bg" aria-hidden="true">@sd.Icon</i>
                    <h3>@sd.Name</h3>
                    <div class="hx-lv"><b>@se</b><span>/ @CoachRules.SkillMax · mức chuẩn 10@(se < sv ? $" · căng thẳng: {sv} → {se}" : "")</span></div>
                    <div class="hx-pips" aria-hidden="true">
                        @for (var j = 1; j <= CoachRules.SkillMax; j++)
                        {
                            <i class="@(j <= se ? "f" : null) @(j == 10 ? "mid" : null) @(j <= c.BaseSkills.ElementAtOrDefault(sel) ? "b" : null)"></i>
                        }
                    </div>
                    <div class="hx-eff @(se < 10 ? "neg" : se > 10 ? "pos" : null)">
                        <i class="ms" aria-hidden="true">bolt</i>
                        <div>
                            <p>@CoachRules.Describe(sd.Skill, se)</p>
                            @if (sv < CoachRules.SkillMax)
                            {
                                var up = (int[])c.Skills.Clone(); up[sel]++;
                                <small>Lên @(sv + 1): @CoachRules.Describe(sd.Skill, CoachRules.Effective(up, c.Stress, sd.Skill))</small>
                            }
                        </div>
                    </div>
                    @if (c.FreePoints > 0)
                    {
                        <button class="cx-btn gold" disabled="@(busy || sv >= CoachRules.SkillMax)" @onclick="() => Spend(sd.Skill)"><i class="ms" aria-hidden="true">add</i>Cộng 1 điểm</button>
                    }
                </div>
            </div>
            <div class="hx-radar">@CoachUi.Radar(c.Skills, c.BaseSkills)</div>
        </div>
    </section>

    <section class="hx-sec" id="hop-dong">
        <div class="hx-sh"><h2>Hợp đồng</h2></div>
        @if (k is not null)
        {
            <div class="hlv-panel">
                <div class="hlv-bar" style="margin:-4px -4px 12px">
                    <Crest Name="@(pf.ClubName ?? "")" Logo="@pf.ClubLogo" Large="true" />
                    <div><b>@pf.ClubName</b>HLV trưởng · hết hạn cuối mùa @k.EndSeasonNumber</div>
                    <span class="cx-chip ok">Đang làm việc</span>
                </div>
                <dl class="hlv-dl">
                    <dt>Lương mỗi vòng</dt><dd>@CoachUi.Cash(k.Wage)</dd>
                    <dt>Thưởng đạt mục tiêu</dt><dd>@CoachUi.Cash(k.Bonus)</dd>
                    <dt>Mục tiêu</dt><dd>@k.Objective</dd>
                    <dt>Đã nhận lương</dt><dd>@k.RoundsPaid/@k.TotalRounds vòng</dd>
                    <dt>Bồi thường nếu bị sa thải</dt><dd>@CoachUi.Cash(CoachRules.Severance(k)) (@k.SeverancePct%)</dd>
                </dl>
                <a class="cx-btn ghost sm" href="hlv/viec-lam"><i class="ms" aria-hidden="true">work</i>Việc làm</a>
            </div>
        }
        else
        {
            <div class="hx-empty"><i class="ms" aria-hidden="true">work_off</i><div><b>Đang thất nghiệp.</b> Ứng tuyển CLB đang tìm HLV, hoặc chờ lời mời trong thư.</div>
                <a class="cx-btn gold sm" href="hlv/viec-lam">Tìm việc</a></div>
        }
        <a class="hx-life" href="cuoc-song">
            <i class="ms" aria-hidden="true">home</i>
            <span><b>Cuộc sống cá nhân</b>Ví @CoachUi.Cash(pf.Wallet) · mức sống, tài sản, sổ ví, album</span>
            <i class="ms" aria-hidden="true">chevron_right</i>
        </a>
    </section>
</div>

@if (press && k is not null && !k.Launched)
{
    <div class="cx-ov hlv-ov" role="dialog" aria-modal="true" aria-label="Họp báo ra mắt">
        <div class="box">
            <button class="x" aria-label="Đóng" @onclick="() => press = false"><i class="ms" aria-hidden="true">close</i></button>
            <h1 class="hlv-h" style="font-size:30px;margin-top:4px">Họp báo ra mắt</h1>
            <CoachPress C="c" ClubName="@(pf.ClubName ?? "")" ClubLogo="@pf.ClubLogo" Objective="@k.Objective" OnDone="PressDone" />
        </div>
    </div>
}

@code {
    [CascadingParameter] public CareerLayout? Shell { get; set; }
    [SupplyParameterFromQuery(Name = "ra-mat")] public int? Launch { get; set; }
    [SupplyParameterFromQuery(Name = "doi-anh")] public int? EditFace { get; set; }

    bool loaded, busy, ok, press, bio, editFace;
    int skill;
    Guid me;
    CoachProfile? pf;
    string? msg;

    protected override async Task OnInitializedAsync()
    {
        me = await Me.ManagerIdAsync() ?? Guid.Empty;
        if (me != Guid.Empty) await Load();
        press = Launch == 1 && pf?.Contract is { Launched: false };
        loaded = true;
    }

    async Task Load()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        pf = await new CoachService(db, Clock).ProfileAsync(me);
    }

    async Task Done()
    {
        await Load();
        if (Shell is not null) { await Shell.RefreshAsync(); await Shell.RefreshMailAsync(); }
        msg = pf?.Contract is not null ? $"Hồ sơ hoàn tất. Bạn nhận hợp đồng mặc định với {pf.ClubName}." : "Hồ sơ hoàn tất. Giờ đi tìm CLB.";
        ok = true;
    }

    async Task Run(Func<CoachService, Task<string?>> f, string done)
    {
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var err = await f(new CoachService(db, Clock));
            (msg, ok) = (err ?? done, err is null);
            await Load();
        }
        finally { busy = false; }
    }

    Task Spend(CoachSkill s) => Run(x => x.SpendPointAsync(me, s), $"Đã cộng 1 điểm {CoachRules.SkillDefs[(int)s].Name}.");
    Task Course() => Run(x => x.StartCourseAsync(me), "Đã ghi danh khoá học.");

    protected override void OnParametersSet() { if (EditFace == 1) editFace = true; }

    // Đổi ảnh HLV sau khi đã tạo hồ sơ (PO 22/11)
    void OpenFace() { editFace = true; msg = null; }

    async Task FaceChanged(Coach _)
    {
        await Load();
        if (Shell is not null) await Shell.RefreshAsync();
    }

    async Task PressDone() { press = false; await Load(); Nav.NavigateTo("su-nghiep"); }
}
