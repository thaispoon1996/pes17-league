@page "/hlv"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject CurrentUser Me
@inject TimeProvider Clock
@inject NavigationManager Nav

<PageTitle>Hồ sơ HLV</PageTitle>

@* Hồ sơ HLV career (PO 19/11): thẻ, hợp đồng, danh tiếng, bằng + khoá học, năng lực (điểm tự do), căng thẳng, ví riêng, mức sống, tài sản, sổ ví, album.
   Chưa có / đang tạo hồ sơ → các bước tạo HLV. *@
@if (!loaded) { <div class="cx-loading"><i></i><i></i><i></i></div>; return; }
@if (me == Guid.Empty) { <p class="cx-msg neg">Cần đăng nhập bằng tài khoản người chơi.</p>; return; }
@if (pf is null || pf.Coach.Status == CoachStatus.Creating)
{
    <CoachMaker OnDone="Done" />
    return;
}
@{ var c = pf.Coach; var k = pf.Contract; }

<h1 class="hlv-h" style="font-size:34px;margin-top:4px">Hồ sơ HLV</h1>
@if (msg is not null) { <p class="cx-msg @(ok ? null : "neg")" role="status">@msg</p> }

<div class="hlv-cardwrap" style="margin-bottom:14px">
    <CoachCard C="c" ClubName="@pf.ClubName" ClubLogo="@pf.ClubLogo" />
</div>

@if (k is not null && !k.Launched)
{
    <button class="cx-cta solo" @onclick="() => press = true">
        <span><b>Họp báo ra mắt</b><small>Báo giới đang chờ ở @pf.ClubName</small></span>
        <i class="ms fill" aria-hidden="true">photo_camera</i>
    </button>
}

<h2 class="cx-h3">Hợp đồng <a href="hlv/viec-lam">Việc làm</a></h2>
<div class="hlv-panel">
    @if (k is not null)
    {
        <div class="hlv-bar" style="margin:-4px -4px 12px">
            <Crest Name="@(pf.ClubName ?? "")" Logo="@pf.ClubLogo" Large="true" />
            <div><b>@pf.ClubName</b>HLV trưởng · hết hạn cuối mùa @k.EndSeasonNumber</div>
            <span class="cx-chip ok">Đang làm việc</span>
        </div>
        <dl class="hlv-dl">
            <dt>Lương mỗi vòng</dt><dd>@CoachUi.Cash(k.Wage)</dd>
            <dt>Thưởng đạt mục tiêu</dt><dd>@CoachUi.Cash(k.Bonus)</dd>
            <dt>Mục tiêu</dt><dd>@k.Objective</dd>
            <dt>Đã nhận lương</dt><dd>@k.RoundsPaid/@k.TotalRounds vòng</dd>
            <dt>Bồi thường nếu bị sa thải</dt><dd>@CoachUi.Cash(CoachRules.Severance(k)) (@k.SeverancePct%)</dd>
        </dl>
    }
    else
    {
        <p style="margin:0 0 12px">Bạn đang thất nghiệp. Ứng tuyển CLB đang tìm HLV, hoặc chờ lời mời trong thư.</p>
        <a class="cx-btn gold" href="hlv/viec-lam"><i class="ms" aria-hidden="true">work</i>Tìm việc</a>
    }
</div>

<h2 class="cx-h3">Danh tiếng <small>@CoachRules.RepTier(c.Reputation)</small></h2>
<div class="hlv-panel">
    <b class="hlv-big">@c.Reputation</b><span style="color:var(--muted)"> / 100 · thẻ @CoachUi.TierName(CoachRules.RepCard(c.Reputation))</span>
    <div class="hlv-repbar" aria-hidden="true">
        <i style="left:calc(@Math.Clamp(c.Reputation, 0, 100)% - 3px)"></i>
        <span style="left:25%">Quốc gia</span><span style="left:50%">Châu lục</span><span style="left:75%">Thế giới</span>
    </div>
    <p class="hlv-note">CLB vừa cần danh tiếng 30 + bằng C, CLB lớn 55 + bằng B, ông lớn 75 + bằng A. Thắng đội mạnh hơn, đạt mục tiêu mùa và họp báo tốt sẽ tăng danh tiếng; bị sa thải trừ 8.</p>
</div>

<h2 class="cx-h3">Bằng huấn luyện</h2>
<div class="hlv-panel">
    <div class="hlv-lic">
        @for (var l = 1; l < CoachRules.Licenses.Length; l++)
        {
            <span class="@(l == c.License ? "cur" : l < c.License ? "have" : null)">@CoachRules.Licenses[l]</span>
        }
    </div>
    @if (c.CourseLicense > 0)
    {
        <p style="margin:0">Đang học bằng <b>@CoachRules.Licenses[c.CourseLicense]</b>, còn <b>@c.CourseRoundsLeft</b> vòng. Học xong được thêm 1 điểm năng lực.</p>
    }
    else if (c.License < CoachRules.Courses.Length)
    {
        var course = CoachRules.Courses[c.License]; var fee = CoachRules.CourseFee(course, c.Trait);
        <p style="margin:0 0 10px">Khoá kế tiếp: bằng <b>@CoachRules.Licenses[course.License]</b>, học @course.Rounds vòng, học phí @CoachUi.Cash(fee) trừ vào ví.</p>
        <button class="cx-btn ghost sm" disabled="@(busy || pf.Wallet < fee)" data-confirm="Ghi danh khoá bằng @CoachRules.Licenses[course.License], học phí @CoachUi.Cash(fee)?" @onclick="Course">
            <i class="ms" aria-hidden="true">school</i>@(pf.Wallet < fee ? "Ví chưa đủ học phí" : "Ghi danh khoá học")
        </button>
    }
    else { <p style="margin:0">Đã có bằng cao nhất.</p> }
</div>

<h2 class="cx-h3">Năng lực <small>@(c.FreePoints > 0 ? $"{c.FreePoints} điểm tự do" : $"Kinh nghiệm {c.Xp}/{CoachRules.XpPerPoint}")</small></h2>
<div class="hlv-panel">
    <div class="hlv-meterbar" title="Kinh nghiệm tới điểm kế tiếp"><i style="width:@(c.Xp * 100 / CoachRules.XpPerPoint)%;background:var(--cyan)"></i></div>
    @for (var i = 0; i < CoachRules.SkillCount; i++)
    {
        var d = CoachRules.SkillDefs[i]; var v = c.Skills[i]; var eff = CoachRules.Effective(c, d.Skill);
        <div class="hlv-sk">
            <h3><i class="ms" aria-hidden="true">@d.Icon</i>@d.Name</h3>
            <p>@CoachRules.Describe(d.Skill, eff)@(eff < v ? $" (căng thẳng: {v} → {eff})" : "")</p>
            <div class="hlv-stp">
                <output>@v</output>
                @if (c.FreePoints > 0) { <button aria-label="Cộng @d.Name" disabled="@(busy || v >= CoachRules.SkillMax)" @onclick="() => Spend(d.Skill)">+</button> }
            </div>
            <div class="bar" aria-hidden="true"><u style="width:@(v * 5)%"></u></div>
        </div>
    }
</div>

<h2 class="cx-h3">Căng thẳng <small>@c.Stress/100</small></h2>
<div class="hlv-panel">
    <div class="hlv-meterbar"><i style="width:@c.Stress%"></i></div>
    <p class="hlv-note">Thua trận tăng căng thẳng, thắng giảm. Mức sống và tài sản giúp hạ mỗi vòng. Từ 70 giảm Con người, Truyền thông; từ 85 giảm Huấn luyện; từ @CoachRules.BurnoutAt dễ kiệt sức.</p>
</div>

<h2 class="cx-h3">Ví HLV <small>Tách riêng quỹ CLB</small></h2>
<div class="hlv-panel">
    <b class="hlv-big @(pf.Wallet >= 0 ? "cx-up" : "cx-down")">@CoachUi.Cash(pf.Wallet)</b>
    <p class="hlv-note">Lương vào ví sau mỗi vòng; chi tiêu sinh hoạt và bảo trì tài sản trừ mỗi vòng.</p>
    <h3 style="margin:14px 0 8px;font-size:15px">Mức sống</h3>
    <div class="hlv-chips">
        @for (var i = 0; i < CoachRules.Living.Length; i++)
        {
            var lv = i; var L = CoachRules.Living[lv];
            <button class="hlv-chip @(c.Lifestyle == lv ? "on" : null)" disabled="@busy" @onclick="() => Living(lv)">@L.Name · @CoachUi.Cash(CoachRules.LivingCost(lv, c.Trait))/vòng</button>
        }
    </div>
    <p class="hlv-note">Mức sống cao hơn giảm căng thẳng nhiều hơn mỗi vòng.</p>
</div>

<h2 class="cx-h3">Tài sản</h2>
<div class="hlv-panel">
    <ul class="hlv-list">
        @foreach (var a in pf.Assets)
        {
            var def = CoachRules.Assets.FirstOrDefault(x => x.Key == a.Key); var aid = a.Id;
            <li>
                <i class="ms" aria-hidden="true">@(def?.Icon ?? "savings")</i>
                @if (a.MaturesTick is { } m)
                {
                    <span>Khoản đầu tư<small>Đáo hạn @CoachUi.Tick(m)</small></span><b class="amt">@CoachUi.Cash(a.Price)</b>
                }
                else
                {
                    <span>@(def?.Name ?? a.Key)<small>Mua @CoachUi.Cash(a.Price) · bảo trì @CoachUi.Cash(def?.Upkeep ?? 0)/vòng</small></span>
                    <button class="cx-btn ghost sm" disabled="@busy" data-confirm="Bán @(def?.Name ?? a.Key) được @CoachUi.Cash((long)(a.Price * CoachRules.AssetResale))?" @onclick="() => Sell(aid)">Bán</button>
                }
            </li>
        }
        @foreach (var def in CoachRules.Assets.Where(x => pf.Assets.All(a => a.Key != x.Key)))
        {
            var key = def.Key;
            <li>
                <i class="ms" aria-hidden="true">@def.Icon</i>
                <span>@def.Name<small>@CoachUi.Cash(def.Price) · bảo trì @CoachUi.Cash(def.Upkeep)/vòng · giảm căng thẳng</small></span>
                <button class="cx-btn gold sm" disabled="@(busy || pf.Wallet < def.Price)" data-confirm="Mua @def.Name giá @CoachUi.Cash(def.Price)?" @onclick="() => Buy(key)">Mua</button>
            </li>
        }
    </ul>
    <p class="hlv-note">Bán lại được @((int)(CoachRules.AssetResale * 100))% giá mua.</p>
</div>

<h2 class="cx-h3">Sổ ví <small>30 dòng gần nhất</small></h2>
<div class="hlv-panel">
    @if (pf.Ledger.Count == 0) { <p style="margin:0;color:var(--muted)">Chưa có khoản thu chi nào. Lương vào ví sau vòng đầu tiên có hợp đồng.</p> }
    <ul class="hlv-list">
        @foreach (var e in pf.Ledger)
        {
            <li><span>@e.Note<small>@CoachUi.Money(e.Kind) · @CoachUi.Tick(e.Tick)</small></span><b class="amt @(e.Amount >= 0 ? "cx-up" : "cx-down")">@CoachUi.Signed(e.Amount)</b></li>
        }
    </ul>
</div>

@if (pf.Photos.Count > 0)
{
    <h2 class="cx-h3">Album</h2>
    <div class="hlv-album">
        @foreach (var p in pf.Photos) { <figure class="hlv-pol"><img src="hlv/anh/@p.Id" alt="@p.Caption" loading="lazy" />@p.Caption</figure> }
    </div>
}

@if (press && k is not null && !k.Launched)
{
    <div class="cx-ov hlv-ov" role="dialog" aria-modal="true" aria-label="Họp báo ra mắt">
        <div class="box">
            <button class="x" aria-label="Đóng" @onclick="() => press = false"><i class="ms" aria-hidden="true">close</i></button>
            <h1 class="hlv-h" style="font-size:30px;margin-top:4px">Họp báo ra mắt</h1>
            <CoachPress C="c" ClubName="@(pf.ClubName ?? "")" ClubLogo="@pf.ClubLogo" Objective="@k.Objective" OnDone="PressDone" />
        </div>
    </div>
}

@code {
    [CascadingParameter] public CareerLayout? Shell { get; set; }
    [SupplyParameterFromQuery(Name = "ra-mat")] public int? Launch { get; set; }

    bool loaded, busy, ok, press;
    Guid me;
    CoachProfile? pf;
    string? msg;

    protected override async Task OnInitializedAsync()
    {
        me = await Me.ManagerIdAsync() ?? Guid.Empty;
        if (me != Guid.Empty) await Load();
        press = Launch == 1 && pf?.Contract is { Launched: false };
        loaded = true;
    }

    async Task Load()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        pf = await new CoachService(db, Clock).ProfileAsync(me);
    }

    async Task Done()
    {
        await Load();
        if (Shell is not null) { await Shell.RefreshAsync(); await Shell.RefreshMailAsync(); }
        msg = pf?.Contract is not null ? $"Hồ sơ hoàn tất. Bạn nhận hợp đồng mặc định với {pf.ClubName}." : "Hồ sơ hoàn tất. Giờ đi tìm CLB.";
        ok = true;
    }

    async Task Run(Func<CoachService, Task<string?>> f, string done)
    {
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var err = await f(new CoachService(db, Clock));
            (msg, ok) = (err ?? done, err is null);
            await Load();
        }
        finally { busy = false; }
    }

    Task Spend(CoachSkill s) => Run(x => x.SpendPointAsync(me, s), $"Đã cộng 1 điểm {CoachRules.SkillDefs[(int)s].Name}.");
    Task Living(int lv) => Run(x => x.SetLifestyleAsync(me, lv), $"Mức sống: {CoachRules.Living[lv].Name}.");
    Task Buy(string key) => Run(x => x.BuyAssetAsync(me, key), "Đã mua.");
    Task Sell(Guid id) => Run(x => x.SellAssetAsync(me, id), "Đã bán.");
    Task Course() => Run(x => x.StartCourseAsync(me), "Đã ghi danh khoá học.");

    async Task PressDone() { press = false; await Load(); Nav.NavigateTo("su-nghiep"); }
}
