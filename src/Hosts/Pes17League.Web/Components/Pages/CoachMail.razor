@page "/thu-hlv"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject CurrentUser Me
@inject TimeProvider Clock
@inject IJSRuntime JS

<PageTitle>Thư HLV</PageTitle>

@* Hòm thư riêng của HLV career (PO 19/11): mọi sự kiện, quyết định chính thức đi qua đây; thư quyết định có hạn (quá hạn = phương án mặc định).
   HLV gửi yêu cầu cho BLĐ / cầu thủ; hồi âm tới vòng sau. Phương án chỉ hiện chiều tác động (lên/xuống), không hiện số.
   PO 20/11 (làm lại UI): danh sách + khung đọc (máy tính 2 cột; điện thoại bấm thư → màn đọc riêng, nút quay lại), biểu tượng màu theo người gửi,
   dòng xem trước, thư "Mục: giá trị" thành bảng, nút đi kèm ghi rõ trang đích. *@
@if (!loaded) { <div class="cx-loading"><i></i><i></i><i></i></div>; return; }
@if (coach is null || coach.Status == CoachStatus.Creating)
{
    <div class="hlv-empty"><i class="ms" aria-hidden="true">mail</i>Hòm thư mở khi hoàn tất hồ sơ HLV.<div class="hlv-acts" style="justify-content:center"><a class="cx-btn gold" href="hlv">Tạo hồ sơ HLV</a></div></div>
    return;
}

@{
    var cur = open is { } oid ? letters.FirstOrDefault(r => r.Letter.Id == oid) : null;
    var summary = string.Join(" · ", new[] { unread > 0 ? $"{unread} chưa đọc" : null, pending > 0 ? $"{pending} cần quyết định" : null }.OfType<string>());
}
<div class="ml @(cur is not null ? "reading" : null) @(compose ? "composing" : null)">
    <header class="ml-head">
        <div>
            <h1>Thư HLV</h1>
            <p>@(summary.Length > 0 ? summary : "Không có thư mới")</p>
        </div>
        <button class="cx-btn gold sm" @onclick="Compose"><i class="ms" aria-hidden="true">edit</i>Viết thư</button>
    </header>
    <nav class="ml-folders" aria-label="Thư mục">
        @foreach (var (f, label, icon) in Folders)
        {
            var v = f; var n = v == CoachFolder.Inbox ? unread : v == CoachFolder.Decisions ? pending : 0;
            <button class="@(folder == v && !compose ? "on" : null) @(v == CoachFolder.Decisions && n > 0 ? "hot" : null)" aria-pressed="@(folder == v && !compose ? "true" : "false")" @onclick="() => Folder(v)">
                <i class="ms" aria-hidden="true">@icon</i>@label@if (n > 0) { <em>@n</em> }
            </button>
        }
    </nav>
    @if (msg is not null) { <p class="cx-msg @(ok ? null : "neg")" role="status">@msg</p> }

    @if (compose)
    {
        var r = CoachEvents.Request(req);
        <section class="ml-compose" aria-labelledby="ml-new">
            <div class="ml-bar"><button class="ml-back" @onclick="() => Folder(folder)"><i class="ms" aria-hidden="true">arrow_back</i>Hộp thư</button></div>
            <h2 id="ml-new" class="ml-subject">Viết thư</h2>
            @if (coach.Status != CoachStatus.Employed) { <p class="cx-msg">Chỉ gửi yêu cầu được khi đang dẫn dắt một CLB.</p> }
            <h3 class="ml-k">Gửi ban lãnh đạo</h3>
            <div class="hlv-req">@foreach (var x in CoachEvents.Requests.Where(x => !x.ToPlayer)) { var k = x.Key; <button class="@(req == k ? "on" : null)" @onclick="() => req = k"><i class="ms" aria-hidden="true">@x.Icon</i><b>@x.Name</b><small>@x.Help</small></button> }</div>
            <h3 class="ml-k">Gửi cầu thủ</h3>
            <div class="hlv-req">@foreach (var x in CoachEvents.Requests.Where(x => x.ToPlayer)) { var k = x.Key; <button class="@(req == k ? "on" : null)" @onclick="() => req = k"><i class="ms" aria-hidden="true">@x.Icon</i><b>@x.Name</b><small>@x.Help</small></button> }</div>
            @if (r is not null)
            {
                <div class="hlv-panel">
                    @if (r.ToPlayer)
                    {
                        <label class="hlv-field"><span>Cầu thủ</span>
                            <select @bind="player"><option value="">Chọn cầu thủ</option>@foreach (var p in squad) { <option value="@p.Id">@p.Name</option> }</select>
                        </label>
                    }
                    @if (r.Key == "nhan-su")
                    {
                        <div class="hlv-field"><span>Vị trí</span>
                            <div class="hlv-chips">@foreach (var role in Roles) { var v = role; <button class="hlv-chip @(staff == v ? "on" : null)" @onclick="() => staff = v">@Cap(CoachLetterService.StaffName(v))</button> }</div>
                        </div>
                    }
                    <label class="hlv-field"><span>Lời nhắn (để trống = thư mẫu)</span><textarea @bind="note" maxlength="1500"></textarea></label>
                    <p class="hlv-note">Hồi âm tới sau vòng kế tiếp. Mỗi loại yêu cầu gửi 1 lần mỗi @CoachEvents.RequestCooldown vòng.</p>
                    <div class="hlv-acts"><button class="cx-btn gold" disabled="@(busy || coach.Status != CoachStatus.Employed)" data-confirm="@(r.Key == "tu-chuc" ? "Nộp đơn từ chức? Ban lãnh đạo trả lời vòng sau." : null)" @onclick="Send"><i class="ms" aria-hidden="true">send</i>Gửi: @r.Name</button></div>
                </div>
            }
        </section>
    }
    else
    {
        <div class="ml-split">
            <div class="ml-list">
                @if (letters.Count == 0)
                {
                    <div class="ml-empty"><i class="ms" aria-hidden="true">@(folder == CoachFolder.Decisions ? "task_alt" : "drafts")</i>
                        @(folder switch { CoachFolder.Decisions => "Không có việc chờ quyết định.", CoachFolder.Sent => "Chưa gửi thư nào. Bấm Viết thư để gửi yêu cầu cho ban lãnh đạo hoặc cầu thủ.", CoachFolder.Archived => "Chưa lưu trữ thư nào.", _ => "Hòm thư trống." })</div>
                }
                @foreach (var g in letters.GroupBy(r => r.Letter.Tick))
                {
                    <h2 class="ml-day">@(CoachUi.Tick(g.Key) is { Length: > 0 } t ? t : "Trước khi nhận việc")</h2>
                    @foreach (var row in g)
                    {
                        var l = row.Letter; var waiting = Waiting(l); var sel = cur?.Letter.Id == l.Id;
                        <button class="ml-row t-@CoachUi.Tone(l.From) @(l.Read || l.Outgoing ? null : "new") @(sel ? "sel" : null) @(waiting ? "due" : null)" aria-current="@(sel ? "true" : null)" @onclick="() => Select(row)">
                            <span class="ml-av" aria-hidden="true"><i class="ms fill">@CoachUi.Icon(l.From)</i></span>
                            <span class="ml-main">
                                <span class="ml-from"><b>@(l.Outgoing ? "Tới: " : "")@l.Sender</b>@if (!l.Read && !l.Outgoing) { <i class="ml-dot" aria-label="chưa đọc"></i> }</span>
                                <span class="ml-subj">@l.Subject</span>
                                <span class="ml-prev">@CoachUi.Preview(l.Body)</span>
                                @if (Status(l) is { } st) { <span class="ml-st @st.Tone"><i class="ms" aria-hidden="true">@st.Icon</i>@st.Text</span> }
                            </span>
                        </button>
                    }
                }
            </div>

            <article @key="cur?.Letter.Id" class="ml-read @(cur is null ? "none" : "t-" + CoachUi.Tone(cur.Letter.From))">
                @if (cur is null)
                {
                    <div class="ml-pick"><i class="ms" aria-hidden="true">mark_email_unread</i>Chọn một thư để đọc</div>
                }
                else
                {
                    var l = cur.Letter; var id = l.Id; var waiting = Waiting(l); var link = CoachUi.LetterLink(l);
                    <div class="ml-bar"><button class="ml-back" @onclick="Close"><i class="ms" aria-hidden="true">arrow_back</i>@FolderName</button></div>
                    <header class="ml-rh">
                        <span class="ml-av lg" aria-hidden="true"><i class="ms fill">@CoachUi.Icon(l.From)</i></span>
                        <div>
                            <b>@(l.Outgoing ? "Tới: " : "")@l.Sender</b>
                            <small>@CoachUi.KindName(l.Kind)@(CoachUi.Tick(l.Tick) is { Length: > 0 } t ? " · " + t : "")</small>
                        </div>
                    </header>
                    <h2 class="ml-subject">@l.Subject</h2>
                    @if (cur.PlayerName is not null && !l.Outgoing) { <p class="ml-about"><i class="ms" aria-hidden="true">person</i>Liên quan: @cur.PlayerName</p> }
                    @if (waiting && l.DeadlineTick is { } dl)
                    {
                        <div class="ml-due"><i class="ms" aria-hidden="true">schedule</i><span><b>Cần quyết định@(Left(dl) is { } lf ? $" · còn {lf} vòng" : "")</b>Hạn @CoachUi.Tick(dl). Quá hạn sẽ áp phương án mặc định.</span></div>
                    }
                    <div class="ml-body">
                        @foreach (var blk in CoachUi.Blocks(l.Body))
                        {
                            if (blk.Text is { } txt) { <p>@txt</p> }
                            else
                            {
                                <dl class="ml-facts">@foreach (var (k, v) in blk.Facts) { <div><dt>@k</dt><dd>@v</dd></div> }</dl>
                            }
                        }
                    </div>
                    @if (cur.Choices.Count > 0)
                    {
                        <div class="ml-opts" role="group" aria-label="Phương án">
                            @for (var i = 0; i < cur.Choices.Count; i++)
                            {
                                var k = i; var ch = cur.Choices[k]; var chosen = l.Chosen == k;
                                <button class="@(chosen ? "chosen" : null)" disabled="@(!waiting || busy)" data-confirm="@(waiting ? $"Chọn: {ch.Label}?" : null)" @onclick="() => Choose(id, k)">
                                    <i class="ms" aria-hidden="true">@(chosen ? "check_circle" : "radio_button_unchecked")</i>
                                    <span><b>@ch.Label@if (waiting && k == l.DefaultOption) { <em>Mặc định</em> }</b>@if (!string.IsNullOrEmpty(ch.Hint)) { <small>@ch.Hint</small> }</span>
                                </button>
                            }
                        </div>
                    }
                    @if (Status(l) is { } st && !waiting) { <p class="ml-st @st.Tone"><i class="ms" aria-hidden="true">@st.Icon</i>@st.Text</p> }
                    <footer class="ml-acts">
                        @if (link is { } lk) { <a class="cx-btn gold sm" href="@lk.Href">@lk.Label<i class="ms" aria-hidden="true">arrow_forward</i></a> }
                        @if (!waiting)
                        {
                            <button class="cx-btn ghost sm" disabled="@busy" @onclick="() => Archive(id, !l.Archived)"><i class="ms" aria-hidden="true">@(l.Archived ? "unarchive" : "archive")</i>@(l.Archived ? "Bỏ lưu trữ" : "Lưu trữ")</button>
                        }
                    </footer>
                }
            </article>
        </div>
    }
</div>

@code {
    [CascadingParameter] public CareerLayout? Shell { get; set; }

    static readonly (CoachFolder, string, string)[] Folders =
        [(CoachFolder.Inbox, "Hộp thư", "inbox"), (CoachFolder.Decisions, "Cần quyết định", "gavel"), (CoachFolder.Sent, "Đã gửi", "send"), (CoachFolder.Archived, "Lưu trữ", "archive")];
    static readonly string[] Roles = ["Assistant", "Coach", "Physio", "Scout"];

    sealed record SquadRow(Guid Id, string Name);
    static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];

    bool loaded, busy, ok, compose;
    Guid me;
    Coach? coach;
    CoachFolder folder = CoachFolder.Inbox;
    IReadOnlyList<CoachLetterRow> letters = [];
    List<SquadRow> squad = [];
    Guid? open;
    int unread, pending, now;
    bool? scrollOpen;   // điện thoại: mở thư → lên đầu trang; quay lại → về chỗ cũ trong danh sách (career.js cxMail)

    string FolderName => Folders.First(f => f.Item1 == folder).Item2;
    static bool Waiting(CoachLetter l) => l.Kind == LetterKind.Decision && l.Chosen is null;
    /// <summary>Số vòng còn trước khi tự áp phương án mặc định (cùng mùa); null = khác mùa / chưa biết.</summary>
    int? Left(int deadline) => now > 0 && deadline / 100 == now / 100 && deadline > now ? deadline - now : null;

    /// <summary>Trạng thái thư (chỉ dữ liệu thật): chờ quyết định, đã quyết định, chờ / đã có hồi âm.</summary>
    (string Text, string Icon, string Tone)? Status(CoachLetter l) => l switch
    {
        { Kind: LetterKind.Decision, Chosen: null } => (l.DeadlineTick is { } d && Left(d) is { } n ? $"Cần quyết định · còn {n} vòng" : "Cần quyết định", "error", "bad"),
        { Kind: LetterKind.Decision, Chosen: not null } => ("Đã quyết định" + (l.AnsweredTick is { } a && CoachUi.Tick(a) is { Length: > 0 } t ? " · " + t : ""), "check_circle", "ok"),
        { Outgoing: true, AnsweredTick: null } => ("Chờ hồi âm vòng sau", "hourglass_top", "info"),
        { Outgoing: true } => ("Đã có hồi âm", "mark_email_read", "ok"),
        _ => null,
    };
    string? msg, req, note, staff, player;

    protected override async Task OnInitializedAsync()
    {
        me = await Me.ManagerIdAsync() ?? Guid.Empty;
        await Load();
        if (pending > 0 && unread == 0) { folder = CoachFolder.Decisions; await Load(); }
        loaded = true;
    }

    async Task Load()
    {
        await using var db = await Dbs.CreateDbContextAsync();
        coach = me == Guid.Empty ? null : await db.Coaches.AsNoTracking().SingleOrDefaultAsync(c => c.ManagerId == me);
        if (coach is null || coach.Status == CoachStatus.Creating) return;
        var svc = new CoachLetterService(db, Clock);
        letters = await svc.ListAsync(coach.Id, folder);
        unread = await svc.UnreadAsync(me);
        pending = await db.CoachLetters.CountAsync(l => l.CoachId == coach.Id && l.Kind == LetterKind.Decision && l.Chosen == null && !l.Archived);
        now = await CoachService.NowTickAsync(db);
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (scrollOpen is not { } o) return;
        scrollOpen = null;
        try { await JS.InvokeVoidAsync("cxMail", o); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    async Task Folder(CoachFolder f) { if (compose || open is not null) scrollOpen = false; folder = f; compose = false; open = null; msg = null; await Load(); }

    async Task Select(CoachLetterRow row)
    {
        if (open != row.Letter.Id) scrollOpen = true;
        open = row.Letter.Id;
        if (row.Letter.Read || coach is null) return;
        await using (var db = await Dbs.CreateDbContextAsync())
            await new CoachLetterService(db, Clock).MarkReadAsync(coach.Id, row.Letter.Id);
        await Load();
        if (Shell is not null) await Shell.RefreshMailAsync();
    }

    void Close() { open = null; scrollOpen = false; }

    async Task Choose(Guid id, int option)
    {
        if (coach is null) return;
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var (err, result) = await new CoachLetterService(db, Clock).ChooseAsync(coach.Id, id, option);
            (msg, ok) = (err ?? result ?? "Đã quyết định.", err is null);
            await Load();
            if (Shell is not null) { await Shell.RefreshAsync(); await Shell.RefreshMailAsync(); }
        }
        finally { busy = false; }
    }

    async Task Archive(Guid id, bool archive)
    {
        if (coach is null) return;
        await using (var db = await Dbs.CreateDbContextAsync())
            await new CoachLetterService(db, Clock).ArchiveAsync(coach.Id, id, archive);
        open = null; scrollOpen = false;
        await Load();
    }

    async Task Compose()
    {
        if (!compose) scrollOpen = true; compose = true; open = null; msg = null;
        if (coach is null || squad.Count > 0) return;
        await using var db = await Dbs.CreateDbContextAsync();
        var club = await db.CoachContracts.Where(k => k.CoachId == coach.Id && k.Status == CoachContractStatus.Active).Select(k => (Guid?)k.ClubId).FirstOrDefaultAsync();
        if (club is null) return;
        squad = await (from m in db.SquadMemberships join p in db.Players on m.PlayerId equals p.Id
                       where m.ClubId == club && m.LeftAt == null orderby p.Name select new SquadRow(p.Id, p.Name)).ToListAsync();
    }

    async Task Send()
    {
        if (coach is null || CoachEvents.Request(req) is not { } r) return;
        Guid? pid = Guid.TryParse(player, out var g) ? g : null;
        if (r.ToPlayer && pid is null) { (msg, ok) = ("Chọn cầu thủ nhận thư.", false); return; }
        if (r.Key == "nhan-su" && staff is null) { (msg, ok) = ("Chọn vị trí nhân viên.", false); return; }
        busy = true;
        try
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var err = await new CoachLetterService(db, Clock).SendAsync(coach.Id, r.Key, pid, note, r.Key == "nhan-su" ? $"role={staff}" : null);
            (msg, ok) = (err ?? $"Đã gửi \"{r.Name}\". Hồi âm tới sau vòng kế tiếp.", err is null);
            if (err is null) { note = null; req = null; compose = false; folder = CoachFolder.Sent; await Load(); }
        }
        finally { busy = false; }
    }
}
