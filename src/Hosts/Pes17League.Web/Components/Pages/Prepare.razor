@page "/chuan-bi/{FixtureId:guid}"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@implements IDisposable
@inject LeagueQueries Q
@inject MatchJobService Jobs
@inject NavigationManager Nav
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject CurrentUser Me
@inject FriendlyHub Hub
@inject FriendlyMachineOptions Machine
@inject StreamPass Pass
@inject IOptionFileStore Store
@inject TimeProvider Clock

@* Chuẩn bị trận của PO (PO 05/11): chỉnh đội hình/chiến thuật trên sân → "Sẵn sàng" = chốt đội hình, game tự vào trận
   (màn chờ /vao-tran đếm ngược). Vào trận nhanh (PO 16/11): mở trang lúc máy rảnh → máy dựng sẵn game tới màn Chọn đội, vẫn sửa
   đội hình được; Sẵn sàng → dựng OF đội hình mới nhất, ghi vào bộ nhớ game rồi chọn đội (bớt khởi động + đi menu). *@
@if (season is null || fixture is null)
{
    <section class="panel"><p>@(notMine ? "Đây không phải trận của CLB bạn — chỉ HLV của 2 đội mới chuẩn bị trận được." : "Không tìm thấy trận.")</p><p><a class="btn" href="@(notMine ? $"tran/{FixtureId}" : "lich")">@(notMine ? "Xem trận →" : "Lịch thi đấu →")</a></p></section>
    return;
}
@if (Shell is not null && preview is { } pv && page is { } pg)
{
    @* UI career đợt 2 (Stitch "Ngày thi đấu", PO 19/11): thẻ đối đầu, tâm điểm 2 đội, so sánh số liệu mùa. Số liệu thật (không dự đoán/thời tiết/trọng tài). *@
    <section class="cx-card cx-matchday">
        <div class="cx-comp"><i class="ms fill" aria-hidden="true">emoji_events</i>@(pg.Edition?.Name ?? "Giao hữu")<span>@(fixture.Stage == FixtureStage.League ? $"Khung {fixture.Matchday}" : AdminText.SlotKind(fixture.Stage, fixture.Leg))</span></div>
        <div class="cx-vs big">
            @foreach (var (cid, tf, label) in new[] { (fixture.Home, pv.Home, "Đội chủ nhà"), (fixture.Away, pv.Away, "Đội khách") })
            {
                if (cid == fixture.Away) { <span class="x">VS<small>@(side == MatchSide.Home ? "Sân nhà" : "Sân khách")</small></span> }
                <span class="t @(cid == club ? "me" : "")">
                    <span class="crestbox"><Crest Name="@season.Clubs[cid]" Logo="@season.Logo(cid)" Large="true" /><em>OVR @tf.StarterOvr.ToString("0")</em></span>
                    <b>@season.Clubs[cid]</b><small>@(cid == club ? "Bạn · " : "")@label</small>
                    @if (tf.Rank is { } rk) { <i class="rk">Hạng @rk · @tf.Points đ</i> }
                    <FormDots Form="@string.Concat(tf.Last.Select(x => x.Result))" />
                </span>
            }
        </div>
    </section>
    <h3 class="cx-h3">Tâm điểm đối đầu</h3>
    <div class="cx-duo">
        @foreach (var (cid, tf) in new[] { (fixture.Home, pv.Home), (fixture.Away, pv.Away) })
        {
            var sq = squads.GetValueOrDefault(cid) ?? [];
            var star = tf.TopScorer is { } ts ? sq.FirstOrDefault(x => x.PlayerId == ts.Id) : null;
            star ??= sq.Where(x => x.Slot <= 10).MaxBy(x => x.Overall) ?? sq.MaxBy(x => x.Overall);
            if (star is null) { <section class="cx-card"></section> continue; }
            var tier = star.Overall >= 88 ? 3 : star.Overall >= 82 ? 2 : star.Overall >= 75 ? 1 : 0;
            <a class="cx-card cx-spot @(cid == fixture.Home ? "h" : "a")" href="cau-thu/@star.PlayerId">
                <span class="ps">@star.Position #@star.Shirt</span>
                <div class="cx-pc tier-@tier"><Face Id="@star.PlayerId" Name="@star.Name" Size="md" /><span class="o">@star.Overall</span></div>
                <b>@star.Name</b>
                <small>@Fmt.Body(star.Height, star.Weight)</small>
                <small>@(tf.TopScorer is { } t2 && t2.Id == star.PlayerId ? $"{t2.Value} bàn mùa này" : "OVR cao nhất đội")</small>
            </a>
        }
    </div>
    <section class="cx-card cx-compare">
        @foreach (var (label, hv, av, fmt, more) in new (string, double, double, string, bool)[] {
            ("Bàn thắng mùa này", pv.Home.GoalsFor, pv.Away.GoalsFor, "0", true), ("Thủng lưới", pv.Home.GoalsAgainst, pv.Away.GoalsAgainst, "0", false),
            ("Thắng / trận", pv.Home.Won, pv.Away.Won, "0", true), ("OVR đá chính", pv.Home.StarterOvr, pv.Away.StarterOvr, "0.0", true),
            ("Giá trị đội hình (€M)", pv.Home.SquadValue / 1e6, pv.Away.SquadValue / 1e6, "0.#", true) })
        {
            var tot = hv + av;
            var hp = tot <= 0 ? 50 : 100 * hv / tot;
            <div class="cmp">
                <b class="@((more ? hv > av : hv < av) ? "lead" : "")">@hv.ToString(fmt)</b><span>@label</span><b class="@((more ? av > hv : av < hv) ? "lead" : "")">@av.ToString(fmt)</b>
                <i><s style="width:@hp.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></s></i>
            </div>
        }
        @if (pv.H2H.Count > 0)
        {
            <p class="h2h">Đối đầu gần đây: @string.Join(" · ", pv.H2H.Take(4).Select(h => $"{season.Clubs.GetValueOrDefault(h.Home, "?")} {h.HomeGoals}–{h.AwayGoals}"))</p>
        }
    </section>
}
<section class="hero">
    <span class="pill">Chuẩn bị trận · Vòng @fixture.Matchday</span>
    <h1>@season.Clubs[fixture.Home] – @season.Clubs[fixture.Away]</h1>
    <p>Bạn đá đội @(adminPick ? season.Clubs[club] + " " : "")(@(side == MatchSide.Home ? "nhà" : "khách")). Chỉnh đội hình, chiến thuật rồi bấm Sẵn sàng.</p>
    @if (adminPick && !(Jobs.LineupLocked && Jobs.HumanFixture?.FixtureId == fixture.Id))
    {
        <p><a class="btn" href="chuan-bi/@fixture.Id?ben=@(side == MatchSide.Home ? "khach" : "nha")">⇄ Đổi sang đá @season.Clubs[side == MatchSide.Home ? fixture.Away : fixture.Home]</a></p>
    }
</section>
<div class="grid">
    <section class="panel">
        <LineupBoard Season="season" ClubId="club" Locked="Jobs.LineupLocked" LockedMessage="Đội hình đã chốt cho trận đang vào." />
    </section>
    @* Điện thoại (PO 17/11): khu Vào trận nằm dưới cùng → nút nổi nhảy tới *@
    <button type="button" class="jump-cta no-busy" onclick="document.getElementById('vao-tran').scrollIntoView({behavior:'smooth'})"><span class="ms ic" aria-hidden="true">sports_soccer</span>Vào trận ↓</button>
    <aside class="panel" id="vao-tran">
        <div class="panel-head"><h2>Vào trận</h2></div>
        @if (fixture.Status == FixtureStatus.Played)
        {
            <p>Trận đã đá xong.</p>
        }
        else if (season.IsHuman(fixture.Home) && season.IsHuman(fixture.Away))
        {
            @* PO 17/11: người vs người = 2 HLV cùng đá trên máy 2 người (máy giao hữu). 2 bên bấm Sẵn sàng + mở trang này → máy nhận trận. *@
            var mineReady = side == MatchSide.Home ? fixture.HomeReadyAt is not null : fixture.AwayReadyAt is not null;
            var otherReady = side == MatchSide.Home ? fixture.AwayReadyAt is not null : fixture.HomeReadyAt is not null;
            var other = season.Clubs[side == MatchSide.Home ? fixture.Away : fixture.Home];
            if (Hub.LeagueFixtureId == fixture.Id)
            {
                <p><b>Máy đang chạy trận (@(Hub.Stage(fixture.Id) ?? "khởi động")).</b> Bạn đá đội @(side == MatchSide.Home ? "nhà" : "khách") — dùng bàn phím, cảm ứng hoặc tay cầm tùy ý.</p>
                <p class="muted"><span class="ms ic" aria-hidden="true">warning</span>Đứng 5 phút không ai bấm (chưa giao bóng hoặc tạm dừng) thì bên không thao tác bị xử thua 0-3; giới hạn 45 phút tính từ giao bóng.</p>
                @if (PlayLink is { } link) { <a class="btn primary wide" data-stream href="@link" target="_blank"><span class="ms ic" aria-hidden="true">sports_esports</span>Mở màn hình chơi</a> }
                else { <p class="muted">Máy đang chuẩn bị trận — nút Vào máy mở khi trận bắt đầu tải</p> }
            }
            else if (fixture.AssistantPlays)
            {
                <p>@(banned ? "Bạn đang bị Ban tổ chức cấm chỉ đạo: trợ lý đá thay trận này (xem Kỷ luật)." : "Quá hạn vòng: trợ lý đá thay trận này.")</p>
            }
            else if (!locked)
            {
                <p class="muted">Vòng này chưa mở.</p>
            }
            else
            {
                <p>Trận giữa 2 HLV người: hai bạn cùng đá trực tiếp trên máy 2 người (mỗi người dùng bàn phím, cảm ứng hoặc tay cầm tùy ý).
                   Hẹn giờ với đối thủ qua <a href="thu?soan=1&clb=@(side == MatchSide.Home ? fixture.Away : fixture.Home)&mau=hen-gio"><span class="ms ic" aria-hidden="true">mail</span>thư</a>,
                   cả hai bấm Sẵn sàng và để mở trang này — máy rảnh là vào trận.</p>
                <p>Bạn: @(mineReady ? "✅ Sẵn sàng" : "chưa sẵn sàng") · @other: @(otherReady ? "✅ Sẵn sàng" : "chưa sẵn sàng")
                   @if (otherReady && mineReady && !Hub.IsOnline(otherManager)) { <span class="muted"> (đối thủ chưa mở trang trận)</span> }</p>
                @if (Hub.DuelError(fixture.Id) is { } err) { <p class="msg">Lần trước lỗi: @err. Bấm Sẵn sàng lại để đá lại.</p> }
                @if (mineReady && otherReady && Hub.LeagueFixtureId is not null) { <p class="muted">Máy 2 người đang bận trận khác, chờ chút.</p> }
                <button class="@(mineReady ? "wide" : "primary wide")" @onclick="() => DuelReady(!mineReady)">@(mineReady ? "↩ Bỏ Sẵn sàng" : "✅ Sẵn sàng")</button>
                <p class="muted">Quá hạn vòng mà chưa đá: trợ lý đá thay; bên chưa bấm Sẵn sàng tính vắng (@AbsenceRules.WarnAt vòng liên tiếp cảnh cáo, @AbsenceRules.ReleaseAt vòng về BOT).</p>
            }
        }
        else if (fixture.AssistantPlays)
        {
            @if (banned)
            {
                <p>Bạn đang bị Ban tổ chức <a href="ky-luat">cấm chỉ đạo</a>: trợ lý đá thay trận này (máy đá theo chiến thuật của bạn).</p>
            }
            else
            {
                <p>Trợ lý sẽ đá thay trận này (máy đá theo chiến thuật của bạn).</p>
                <button class="wide" @onclick="() => SetAssistant(false)">↩ Huỷ, tôi tự đá</button>
            }
        }
        else if (!locked)
        {
            <p class="muted">Vòng này chưa mở.</p>
        }
        else if (Jobs.Preparing && Jobs.HumanFixture?.FixtureId == fixture.Id)
        {
            @if (Jobs.Ready)
            {
                <p class="muted">Game đã dựng sẵn với đội hình hiện tại — bấm Sẵn sàng là vào trận (~@(Jobs.SecondsToKickoffEstimateWarm) giây). Sửa đội hình/chiến thuật thì máy tự cài lại vào game (game khởi động lại khoảng 2 phút).</p>
            }
            else
            {
                <p class="muted">Máy đang dựng sẵn game (@(Jobs.Stage ?? "khởi động")) — vẫn chỉnh đội hình được. Bấm Sẵn sàng lúc nào cũng được, game tự đi tiếp.</p>
            }
            <button class="primary wide" @onclick="Go"><span class="ms ic" aria-hidden="true">check_circle</span>Sẵn sàng — chốt đội hình & vào trận</button>
            <button class="wide" data-confirm="Huỷ dựng sẵn và trả máy?" @onclick="Jobs.Cancel"><span class="ms ic" aria-hidden="true">close</span>Huỷ dựng sẵn (trả máy)</button>
        }
        else if (Jobs.LineupLocked && Jobs.HumanFixture?.FixtureId == fixture.Id)
        {
            <p>Đội hình đã chốt, game đang vào trận.</p>
            <a class="btn primary wide" href="vao-tran"><span class="ms ic" aria-hidden="true">live_tv</span>Màn hình chờ vào trận</a>
        }
        else if (Jobs.Running)
        {
            <p class="muted">Máy trận đang bận: @Jobs.Title@(Jobs.BotMinutesLeft is { } m ? $" (trận đang đá còn khoảng {m} phút)" : ""). Chờ xong rồi bấm Sẵn sàng.</p>
            @if (!admin && Jobs.CanPreemptBots && fixture.Status == FixtureStatus.Scheduled && !season.BothHuman(fixture))
            {
                @* PO 19/11 (Career): trận của tôi được ưu tiên — ngắt trận BOT đang đá (về lịch, đá lại sau), đá xong tự đá tiếp BOT. *@
                <button class="primary wide" disabled="@starting" @onclick="PlayNow"><span class="ms ic" aria-hidden="true">bolt</span>Đá ngay — ngắt trận BOT đang đá (đá lại sau)</button>
            }
            else if (admin && Jobs.CanStopAfterCurrent)
            {
                <button class="wide" @onclick="Jobs.StopAfterCurrent"><span class="ms ic" aria-hidden="true">pause</span>Dừng BOT sau trận đang đá</button>
            }
            else if (Jobs.StopPending)
            {
                <p class="muted">BOT sẽ dừng sau trận đang đá, nút Sẵn sàng tự mở khi máy rảnh. Đá xong trận của bạn thì bấm lại "Đá các trận BOT" ở trang Vòng đấu.</p>
            }
            <button class="primary wide" disabled><span class="ms ic" aria-hidden="true">check_circle</span>Sẵn sàng</button>
        }
        else
        {
            <p class="muted">Bấm Sẵn sàng: đội hình được chốt, game khởi động và tự vào trận (~@(Jobs.SecondsToKickoffEstimate) giây, có đếm ngược).</p>
            <button class="primary wide" @onclick="Ready"><span class="ms ic" aria-hidden="true">check_circle</span>Sẵn sàng — chốt đội hình & vào trận</button>
        }
        @if (fixture.Status == FixtureStatus.Scheduled && season.NeedsHuman(fixture) && !season.BothHuman(fixture) && !(Jobs.LineupLocked && Jobs.HumanFixture?.FixtureId == fixture.Id))
        {
            <button class="wide" title="Không đá được: máy đá thay theo đội hình, chiến thuật hiện tại" data-confirm="Để trợ lý đá trận này theo đội hình, chiến thuật hiện tại?" @onclick="() => SetAssistant(true)">🧑‍💼 Để trợ lý đá trận này</button>
        }
        <p><a href="">← Trang chủ</a></p>
    </aside>
</div>

@code {
    [CascadingParameter] public CareerLayout? Shell { get; set; }
    MatchPreview? preview;
    MatchPage? page;
    Dictionary<Guid, List<SquadRow>> squads = [];
    bool notMine;   // trận có thật nhưng không phải CLB của người xem
    [Parameter] public Guid FixtureId { get; set; }
    [SupplyParameterFromQuery(Name = "ben")] public string? Ben { get; set; }
    Guid club;
    bool adminPick;
    SeasonInfo? season;
    FixtureView? fixture;
    MatchSide side;
    bool locked, admin, banned;
    Timer? tick, touch;
    Guid? me;
    Guid otherManager;
    string? myName;
    string? PlayLink => Pass.Link(fixture!.Id, side == MatchSide.Home);   // vé riêng từng trận (PO 17/11)

    protected override async Task OnInitializedAsync()
    {
        Jobs.Changed += OnJob;
        tick = new Timer(_ => { if (Jobs.BotMinutesLeft is not null) InvokeAsync(StateHasChanged); }, null, 30000, 30000);   // phút còn lại của trận BOT
        admin = await Me.IsAdminAsync();
        season = await Q.SeasonAsync();
        if (season is null) return;
        await using var db = await Dbs.CreateDbContextAsync();
        var md = await (from f in db.Fixtures join m in db.Matchdays on f.MatchdayId equals m.Id where f.Id == FixtureId select m).SingleOrDefaultAsync();
        if (md is null) return;
        locked = md.Status is MatchdayStatus.WindowOpen or MatchdayStatus.Locked or MatchdayStatus.Playing;   // PO 17/11: bỏ khoá vòng
        fixture = (await Q.FixturesAsync(season.Id, md.Id)).FirstOrDefault(f => f.Id == FixtureId);
        if (fixture is null) return;
        if (fixture.Home == season.HumanClubId || fixture.Away == season.HumanClubId)
            side = fixture.Home == season.HumanClubId ? MatchSide.Home : MatchSide.Away;
        else { fixture = null; notMine = true; return; }   // PO 17/11: admin = Ban tổ chức, không đá trận (bỏ "admin đá trận BOT" 16/11)
        club = side == MatchSide.Home ? fixture.Home : fixture.Away;
        banned = await SanctionService.IsBannedAsync(db, FixtureId);   // Ban tổ chức cấm chỉ đạo (PO 17/11)
        if (season.BothHuman(fixture))
        {
            me = await Me.ManagerIdAsync();
            var otherClub = side == MatchSide.Home ? fixture.Away : fixture.Home;
            otherManager = await new MailService(db, TimeProvider.System).ManagerOfClubAsync(otherClub) ?? Guid.Empty;
            myName = season.Clubs[club];
            Hub.Changed += OnHub;
            touch = new Timer(_ => { if (me is { } id) Hub.Touch(id, myName!); }, null, 0, 5000);   // máy chỉ nhận trận khi 2 HLV đang mở trang
        }
        Warm();
        if (Shell is not null)
        {
            page = await Q.MatchAsync(FixtureId);
            if (page is not null) preview = await Q.PreviewAsync(page, Store, Clock);
            foreach (var c in new[] { fixture.Home, fixture.Away }) squads[c] = await Q.SquadAsync(season.Id, c);
        }
    }

    async Task DuelReady(bool on)
    {
        if (me is not { } id) return;
        await using (var db = await Dbs.CreateDbContextAsync())
        {
            try { await new LeagueDuelService(db, TimeProvider.System).ReadyAsync(FixtureId, id, on); }
            catch (AdminRuleException e) { Hub.SetDuelError(FixtureId, e.Message); }
        }
        Hub.Notify();
    }

    async Task ReloadAsync()
    {
        if (season is null || fixture is null) return;
        await using var db = await Dbs.CreateDbContextAsync();
        var md = await db.Fixtures.Where(f => f.Id == FixtureId).Select(f => f.MatchdayId).SingleAsync();
        fixture = (await Q.FixturesAsync(season.Id, md)).FirstOrDefault(f => f.Id == FixtureId) ?? fixture;
        StateHasChanged();
    }

    void OnHub() => InvokeAsync(ReloadAsync);

    /// <summary>Máy rảnh + trận của HLV (không phải admin chọn trận BOT) → dựng sẵn game ngay khi mở trang (PO 16/11).</summary>
    void Warm()
    {
        if (adminPick || !locked || Jobs.Running || Jobs.Declined(fixture!.Id) || fixture.Status != FixtureStatus.Scheduled
            || fixture.AssistantPlays || (season!.IsHuman(fixture.Home) && season.IsHuman(fixture.Away))) return;
        Jobs.PlayHuman(fixture.Id, side, prepare: true, career: Shell is not null);   // career: đá xong tự mô phỏng tiếp (PO 20/11)
    }

    void Go()
    {
        Jobs.Go();
        Nav.NavigateTo("vao-tran");
    }

    protected override void OnParametersSet()
    {
        if (adminPick && fixture is not null)
        {
            side = Ben == "khach" ? MatchSide.Away : MatchSide.Home;
            club = side == MatchSide.Home ? fixture.Home : fixture.Away;
        }
    }

    async Task SetAssistant(bool on)
    {
        if (!on && banned) return;
        await using (var db = await Dbs.CreateDbContextAsync())
            await db.Fixtures.Where(f => f.Id == FixtureId && f.Status == FixtureStatus.Scheduled).ExecuteUpdateAsync(x => x.SetProperty(f => f.AssistantPlays, on));
        fixture = fixture! with { AssistantPlays = on };
    }

    bool starting;

    async Task Ready()
    {
        starting = true;
        try
        {
            if (Jobs.PlayHuman(fixture!.Id, side, career: Shell is not null)) Nav.NavigateTo("vao-tran");
        }
        finally { starting = false; }
    }

    async Task PlayNow()
    {
        starting = true;
        try
        {
            if (await Jobs.PlayHumanNowAsync(fixture!.Id, side)) Nav.NavigateTo("vao-tran");
        }
        finally { starting = false; }
    }

    void OnJob() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Jobs.Changed -= OnJob;
        Hub.Changed -= OnHub;
        tick?.Dispose();
        touch?.Dispose();
    }
}
