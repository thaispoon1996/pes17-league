@page "/"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@implements IDisposable
@inject NightBotOptions Night
@inject LeagueQueries Q
@inject MatchJobService Jobs
@inject NavigationManager Nav
@inject IOptionFileStore Store
@inject TimeProvider Clock
@inject CurrentUser Me
@inject RoundReelStore Reels
@inject IDbContextFactory<ClubsDbContext> Dbs

@* Trang chủ theo thiết kế Stitch (PO ok 17/11): 3 bản — khách (giới thiệu + đăng ký), HLV có CLB (trận của tôi + vị trí),
   chung (có tài khoản chưa có CLB / Ban tổ chức). Dữ liệu thật; tên/số trong ảnh thiết kế chỉ là mẫu. Nút vào trận giữ luồng cũ. *@
<PageTitle>PES 17 League</PageTitle>
<div class="bg-stadium" aria-hidden="true"><i></i><i></i><i></i></div>

@if (season is null)
{
    <div class="h"><section class="h-card"><h2>Chưa có mùa đang chạy</h2><p><a href="mua">Xem lại các mùa đã đá →</a></p></section></div>
    return;
}

<div class="h">
    @if (guest)
    {
        <section class="h-hero">
            <span class="h-chip ok">@season.Name@(md is not null ? $" · {Word} {md.Number}" : "")</span>
            <h1>Làm HLV một CLB — <em>đá ngay trên trình duyệt</em>, không cần tải game</h1>
            <p>Dẫn dắt một CLB trong giải PES 17 trực tuyến: chọn đội hình, chiến thuật, chuyển nhượng — rồi tự vào sân thi đấu ngay trên trình duyệt.</p>
            <div class="ctas">
                <a class="h-cta" href="dang-ky"><span class="ms">sports</span>Đăng ký làm HLV</a>
                <a class="h-cta ghost" href="truc-tiep"><span class="ms">sensors</span>Xem các trận đang đá</a>
            </div>
        </section>
    }
    else if (myClub is { } mc)
    {
        <section class="h-me">
            <span class="avatar"><Crest Name="@season.Clubs[mc]" Logo="@season.Logo(mc)" /></span>
            <span><b>HLV @who</b><small>@season.Clubs[mc] · @season.Name</small></span>
            <span class="icons">
                <a href="thu" aria-label="Hòm thư"><span class="ms">mail</span></a>
                <a href="clb" aria-label="CLB của tôi"><span class="ms">shield</span></a>
            </span>
        </section>
    }

    <div class="h-cols">
        <div>
            @* ---- Trận chính: trận của tôi (HLV) / trận đang đá hoặc trận đầu vòng (chung) ---- *@
            @if (!guest && md is not null && feature is { } f)
            {
                var playing = f.Status == FixtureStatus.Playing;
                <section class="h-card @(open ? "h-window" : "")">
                    <div class="h-window__top">
                        <span>
                            @if (playing) { <span class="h-chip live">Đang đá</span> }
                            else if (f.Status == FixtureStatus.Played) { <span class="h-chip dim">Đã đá</span> }
                            else if (open) { <span class="h-chip ok">Cửa sổ trận đang mở</span> }
                            else { <span class="h-chip dim">@Fmt.Status(md.Status, md.TransferWindowId is not null)</span> }
                        </span>
                        @if (open && deadline is { } dl && f.Status == FixtureStatus.Scheduled)
                        {
                            <span class="h-clock" title="Hạn đá vòng: @NightBotOptions.Format(dl)"><span class="ms">timer</span><span data-countdown="@dl.ToUnixTimeMilliseconds()">@Left(dl)</span><small>còn lại</small></span>
                        }
                    </div>
                    <div class="h-match__head">
                        <b><span class="ms" style="color:var(--secondary);vertical-align:-5px">emoji_events</span> @Word @md.Number@(EditionName(f) is { } en ? $" · {en}" : "")</b>
                    </div>
                    <a class="h-match__vs" href="tran/@f.Id">
                        @TeamBlock(f.Home, homeForm, false)
                        <span class="h-mid">
                            @if (f.HomeGoals is not null && f.AwayGoals is not null)
                            {
                                <span class="score">@Fmt.Score(f.HomeGoals.Value, f.AwayGoals.Value, f.HomePenalties, f.AwayPenalties)</span>
                            }
                            else { <span class="vs">VS</span> }
                        </span>
                        @TeamBlock(f.Away, awayForm, true)
                    </a>

                    @if (myClub is not null && (f.Home == myClub || f.Away == myClub))
                    {
                        <div style="margin-top:16px">
                            @if (Jobs.Running && Jobs.Title == "Trận của tôi")
                            {
                                <a class="h-cta" href="vao-tran"><span class="ms">sports_esports</span>Vào trận ngay</a>
                                <p class="h-note">Trận của bạn đang chạy — vào màn hình trận để thi đấu.</p>
                            }
                            else if (CanPlay(f))
                            {
                                <a class="h-cta" href="chuan-bi/@f.Id"><span class="ms">sports_esports</span>Vào trận ngay</a>
                                <p class="h-note">Chơi ngay trên trình duyệt · chọn đội hình, chiến thuật trước khi vào sân</p>
                                @if (deadline is { } dl2) { <p class="h-note bot"><span class="ms" style="font-size:16px;vertical-align:-3px">smart_toy</span> Quá hạn @NightBotOptions.Format(dl2), trợ lý (BOT) đá thay theo chiến thuật của bạn — kết quả vẫn tính.</p> }
                            }
                            else if (f.Status == FixtureStatus.Scheduled && f.AssistantPlays)
                            {
                                <a class="h-cta ghost" href="chuan-bi/@f.Id"><span class="ms">smart_toy</span>Trợ lý đá thay trận này</a>
                            }
                            else if (f.Status == FixtureStatus.Played)
                            {
                                <a class="h-cta ghost" href="tran/@f.Id"><span class="ms">scoreboard</span>Xem kết quả trận</a>
                            }
                            else
                            {
                                <a class="h-cta ghost" href="clb"><span class="ms">groups</span>Chuẩn bị đội hình</a>
                                <p class="h-note">Vòng chưa mở — mở vòng là đá được.</p>
                            }
                        </div>
                    }
                    else if (playing)
                    {
                        <div style="margin-top:16px"><a class="h-cta ghost" href="truc-tiep"><span class="ms">live_tv</span>Xem trực tiếp</a></div>
                    }
                    else if (!admin && myClub is null)
                    {
                        <div style="margin-top:16px"><a class="h-cta ghost" href="dang-ky-giai"><span class="ms">how_to_reg</span>Nộp đơn nhận CLB</a></div>
                    }
                </section>
            }

            @* ---- Khách: trận đang diễn ra / các trận của vòng ---- *@
            @if (guest && md is not null && fixtures.Count > 0)
            {
                var live = fixtures.Where(x => x.Status == FixtureStatus.Playing).ToList();
                var list = live.Count > 0 ? live : fixtures.Take(4).ToList();
                <section>
                    <div class="h-sec">
                        <h2>@if (live.Count > 0) { <span class="h-chip live">Live</span> <text>Trận đang diễn ra</text> } else { <span class="ms">calendar_month</span> <text>@Word @md.Number</text> }</h2>
                        <a href="lich">Lịch →</a>
                    </div>
                    <div class="h-live-list">
                        @foreach (var x in list)
                        {
                            <a class="h-mini" href="tran/@x.Id">
                                <b>@season.Clubs[x.Home]</b>
                                <span class="sc">@if (x.HomeGoals is not null && x.AwayGoals is not null) { @Fmt.Score(x.HomeGoals.Value, x.AwayGoals.Value, x.HomePenalties, x.AwayPenalties) } else { <text>vs</text> }@if (x.Status == FixtureStatus.Playing) { <small>Đang đá</small> }</span>
                                <b>@season.Clubs[x.Away]</b>
                            </a>
                        }
                    </div>
                </section>
            }

            @* ---- HLV: vị trí hiện tại ---- *@
            @if (myForm is { } mf && myClub is not null)
            {
                <section class="h-card">
                    <div class="h-sec">
                        <h2><span class="ms">leaderboard</span>Vị trí hiện tại</h2>
                        @if (mf.Last.Count > 0)
                        {
                            <span class="h-form round">@foreach (var x in mf.Last.TakeLast(5)) { <i class="@x.Result" title="@x.Score">@ResultVi(x.Result)</i> }</span>
                        }
                    </div>
                    <div class="h-stats">
                        <div class="h-stat"><small>Thứ hạng</small><b class="rank">#@(mf.Rank?.ToString() ?? "–")<sub>/@standingsCount</sub></b></div>
                        <div class="h-stat"><small>Điểm</small><b>@(mf.Points ?? 0)</b></div>
                        <div class="h-stat"><small>Hiệu số</small><b class="pos">@Signed(mf.GoalsFor - mf.GoalsAgainst)</b></div>
                        <div class="h-stat"><small>T-H-B</small><b style="font-size:22px">@mf.Won-@mf.Drawn-@mf.Lost</b></div>
                    </div>
                    <a class="h-link" href="bxh"><span class="ms">format_list_numbered</span>Xem toàn bộ bảng xếp hạng<span class="ms">chevron_right</span></a>
                </section>
            }

            @* ---- Clip bàn thắng vòng gần nhất ---- *@
            <section>
                <div class="h-sec"><h2><span class="ms">movie</span>Khoảnh khắc nổi bật</h2><a href="ban-thang">Tất cả →</a></div>
                @if (reel is { } r)
                {
                    <a class="h-reel" href="@season.Url($"ban-thang?vong={r.Info.Round}")">
                        <img src="@r.Info.PosterUrl" alt="" loading="lazy" />
                        <span class="play"><span class="ms fill">play_arrow</span></span>
                        <span class="dur">@Clip(r.Info.Seconds)</span>
                    </a>
                    <p class="h-reel-cap"><b>Bàn thắng @Word.ToLowerInvariant() @r.Info.Round@(r.Edition is { } re ? $" · {re}" : "")</b><small>@r.Info.Items.Count bàn thắng · cập nhật @r.Info.BuiltAt.ToLocalTime().ToString("HH:mm dd/MM")</small></p>
                }
                else { <p class="h-empty">Chưa có clip bàn thắng — đá xong vòng sẽ có.</p> }
            </section>

            @* ---- Các trận của vòng (giữ chức năng cũ: nút đá trận của tôi, việc của Ban tổ chức) ---- *@
            @if (md is not null && !guest)
            {
                <section class="panel h-round">
                    <div class="panel-head"><h2>Các trận @Word.ToLowerInvariant() @md.Number</h2><a href="lich">Toàn bộ lịch →</a></div>
                    @foreach (var g in fixtures.GroupBy(x => x.EditionId).OrderBy(g => editions.FindIndex(e => e.Id == g.Key)))
                    {
                        @if (editions.FirstOrDefault(x => x.Id == g.Key) is { } e)
                        {
                            <div class="round-title"><a class="comp" href="giai/@e.CompetitionId"><Crest Name="@e.Name" Logo="@e.Logo" /><b>@e.Name</b></a></div>
                        }
                        <ul class="fixtures stagger">
                            @foreach (var x in g)
                            {
                                var mine = x.Home == season.HumanClubId || x.Away == season.HumanClubId;
                                <FixtureCard Season="season" F="x">
                                    @if (mine && CanPlay(x))
                                    {
                                        <a class="btn primary wide" href="chuan-bi/@x.Id">🎮 Đá trận của tôi</a>
                                    }
                                </FixtureCard>
                            }
                        </ul>
                    }
                    <div class="actions">
                        @if (!admin && myClub is not null) { <a class="btn" href="chuyen-nhuong">Chuyển nhượng</a> }
                        @if (admin && open && fixtures.Any(x => x.Status == FixtureStatus.Scheduled && !season.NeedsHuman(x)))
                        {
                            <button disabled="@Jobs.Running" @onclick="() => Jobs.PlayBots(md.Id)">🤖 Đá các trận BOT</button>
                        }
                        @if (admin && open && fixtures.Any(x => x.Status == FixtureStatus.Scheduled && season.NeedsHuman(x)))
                        {
                            @* Đợt 2 (PO ok 12/11): hết hạn mà HLV chưa đá → trợ lý đá thay (COM vs COM, giữ chiến thuật HLV) *@
                            <button disabled="@Jobs.Running" title="Như hạn chót: các trận HLV người chưa đá → trợ lý đá thay theo chiến thuật của HLV, HLV chưa đá/chưa giao trợ lý tính vắng" data-confirm="Trợ lý đá thay mọi trận người còn lại của vòng? HLV chưa đá, chưa giao trợ lý sẽ bị tính vắng." @onclick="() => DelegateAll(md.Id)">🧑‍💼 Trợ lý đá thay trận còn lại</button>
                        }
                        @if (admin && !Jobs.Running && fixtures.Any(x => x.Status == FixtureStatus.Playing))
                        {
                            @* Không việc nào chạy mà trận vẫn "Đang đá" = web khởi động lại giữa trận (PO uỷ quyền 06/11). *@
                            <button title="Trận bị ngắt giữa chừng (web khởi động lại?) → về lịch để đá lại" data-confirm="Đưa các trận đang kẹt về lịch để đá lại?" @onclick="() => Jobs.ReleaseStale(md.Id)">↺ Đặt lại trận kẹt</button>
                        }
                    </div>
                </section>
            }
            @if (Jobs.Title is not null && !guest)
            {
                <section class="job">
                    <h2>@Jobs.Title @(Jobs.Running ? "⏳" : "")</h2>
                    @if (BotLeft() is { } left)
                    {
                        <p>Còn @left.Matches trận BOT ≈ @Duration(left.Minutes), xong khoảng @Clock.GetLocalNow().AddMinutes(left.Minutes).ToString("HH:mm")</p>
                    }
                    @if (Jobs.Running && Jobs.Title == "Trận của tôi") { <a class="btn primary wide" href="vao-tran">📺 Vào màn hình trận</a> }
                    else if (Jobs.Running) { <a class="btn" href="truc-tiep">📺 Xem trực tiếp</a> }
                    <pre>@string.Join("\n", Jobs.Log.Reverse())</pre>
                    @if (admin && Jobs.CanStopAfterCurrent) { <button title="Đá xong trận đang đá thì dừng, nhường máy cho trận của tôi" @onclick="Jobs.StopAfterCurrent">⏸ Dừng sau trận này</button> }
                    @if (admin && Jobs.Running) { <button class="danger" title="Bỏ ngang ngay, kể cả trận đang đá" data-confirm="Bỏ ngang ngay, kể cả trận đang đá?" data-confirm-ok="Bỏ ngang" @onclick="Jobs.Cancel">Huỷ</button> }
                </section>
            }
        </div>

        <div>
            @* ---- BXH thu gọn ---- *@
            @if (table.Count > 0)
            {
                <section class="h-card">
                    <div class="h-sec"><h2><span class="ms">bar_chart</span>Bảng xếp hạng</h2><a href="@(tableComp is { } tc ? $"giai/{tc}" : "bxh")">Toàn bộ →</a></div>
                    @if (tableName is not null) { <p class="h-empty" style="margin:-6px 0 8px">@tableName</p> }
                    <table class="h-table">
                        <thead><tr><th>#</th><th>Câu lạc bộ</th><th class="n">Tr</th><th class="n">HS</th><th class="n">Điểm</th></tr></thead>
                        <tbody>
                            @foreach (var (row, i) in TableRows())
                            {
                                var meRow = row.Club == myClub;
                                var opp = feature is { } ff && myClub is { } mcl && (ff.Home == mcl || ff.Away == mcl) && (row.Club == ff.Home || row.Club == ff.Away) && !meRow;
                                <tr class="@(meRow ? "me" : "")">
                                    <td class="rk"><b>@(i + 1)</b></td>
                                    <td><a class="club" href="clb/@row.Club"><Crest Name="@season.Clubs[row.Club]" Logo="@season.Logo(row.Club)" /><span>@season.Clubs[row.Club]</span>@if (meRow) { <em class="h-tag">Bạn</em> } else if (opp) { <em class="h-tag opp">Đối thủ</em> }</a></td>
                                    <td class="n">@row.Played</td>
                                    <td class="n gd">@Signed(row.GoalDifference)</td>
                                    <td class="pts">@row.Points</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }

            @* ---- Tin ---- *@
            <section>
                <div class="h-sec"><h2><span class="ms">campaign</span>Tin giải đấu</h2><a href="tin">Tất cả →</a></div>
                @if (news.Count == 0) { <p class="h-empty">Chưa có tin — đá xong trận sẽ có bài báo.</p> }
                <div class="h-news">
                    @foreach (var n in news)
                    {
                        <a href="tin/@n.Id">
                            <span class="thumb">@if (n.Image is { } img) { <img src="/tin-anh/@img" alt="" loading="lazy" /> } else { <NewsPh N="n" Class="pl-hero__ph sm" /> }</span>
                            <span><small><em>@(n.Competition ?? "Tin")</em>@Word @n.Round · @Ago(n.PublishedAt)</small><b>@n.Title</b></span>
                        </a>
                    }
                </div>
            </section>

            @if (editions.Count > 1 && !guest)
            {
                <section class="panel">
                    <div class="panel-head"><h2>Các giải</h2><a href="giai">Tất cả →</a></div>
                    <CompetitionList Season="season" Items="summaries" Compact="true" />
                </section>
            }
        </div>
    </div>

    @if (guest)
    {
        <section>
            <div class="h-sec"><h2>Chơi thế nào?</h2></div>
            <div class="h-why">
                <article><span class="ico"><span class="ms">devices</span></span><h3>Không cần cài game</h3><p>Mở trình duyệt là vào sân: game chạy trên máy chủ, hình ảnh truyền thẳng về máy bạn.</p></article>
                <article><span class="ico"><span class="ms">smart_toy</span></span><h3>Trợ lý đá thay khi bận</h3><p>Đến hạn vòng mà bạn chưa đá, trợ lý (BOT) đá thay theo chiến thuật bạn đã chọn — kết quả vẫn tính.</p></article>
                <article><span class="ico"><span class="ms">currency_exchange</span></span><h3>Chuyển nhượng &amp; tài chính</h3><p>Mua bán cầu thủ, gia hạn hợp đồng, quản lý quỹ lương và ngân sách CLB của bạn.</p></article>
            </div>
        </section>
        <section class="h-final">
            <span class="ms" style="font-size:40px;color:var(--primary)">emoji_events</span>
            <h2>Sẵn sàng dẫn dắt một CLB?</h2>
            <p>Tạo tài khoản, rồi nộp đơn nhận CLB cho mùa giải.</p>
            <a class="h-cta" href="dang-ky"><span class="ms">sports</span>Tạo tài khoản HLV</a>
            <p class="h-note">Đã có tài khoản? <a href="login">Đăng nhập</a></p>
        </section>
    }
</div>

@code {
    SeasonInfo? season;
    Matchday? md;
    List<FixtureView> fixtures = [];
    List<EditionView> editions = [];
    List<CompetitionSummary> summaries = [];
    List<NewsCard> news = [];
    IReadOnlyList<StandingRow<Guid>> table = [];
    Guid? tableComp;
    string? tableName;
    int standingsCount;
    FixtureView? feature;
    TeamForm? homeForm, awayForm, myForm;
    (RoundReelInfo Info, string? Edition)? reel;
    DateTimeOffset? deadline;
    Guid? myClub;
    bool admin, guest;
    string? who;
    const string Word = "Vòng";
    bool wasRunning;
    Guid? loadedFor;   // trận đang đá lúc đọc danh sách trận
    Timer? tick;

    bool open => md?.Status is MatchdayStatus.WindowOpen or MatchdayStatus.Locked or MatchdayStatus.Playing;

    // Như trang cũ: trận chờ HLV người, chưa đá, vòng đang mở (PO 17/11: bỏ khoá vòng)
    bool CanPlay(FixtureView f) => season!.NeedsHuman(f) && f.Status == FixtureStatus.Scheduled && open;

    protected override async Task OnInitializedAsync()
    {
        Jobs.Changed += OnJob;
        tick = new Timer(_ => { if (Jobs.BotMinutesLeft is not null) InvokeAsync(StateHasChanged); }, null, 60000, 60000);   // thời gian còn lại của BOT
        admin = await Me.IsAdminAsync();
        guest = await Me.IsGuestAsync();
        who = await Me.NameAsync();
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        loadedFor = Jobs.CurrentFixtureId;
        season = await Q.SeasonAsync();
        if (season is null) return;
        myClub = !guest && !admin && season.HumanClubId != Guid.Empty ? season.HumanClubId : null;
        md = await Q.CurrentMatchdayAsync(season.Id);
        fixtures = md is null ? [] : await Q.FixturesAsync(season.Id, md.Id);
        editions = await Q.EditionsAsync(season.Id);
        news = await Q.NewsAsync(season.Id, null, null, 3);
        if (editions.Count > 1) summaries = await Q.SummariesAsync(season.Id, editions, Store, Clock);
        deadline = open ? Night.NextDeadline(Clock.GetUtcNow()) : null;

        // trận chính: trận của tôi trong vòng → trận đang đá → trận đầu vòng
        feature = (myClub is { } c ? fixtures.FirstOrDefault(f => f.Home == c || f.Away == c) : null)
                  ?? fixtures.FirstOrDefault(f => f.Status == FixtureStatus.Playing)
                  ?? fixtures.FirstOrDefault(f => f.Status == FixtureStatus.Scheduled)
                  ?? fixtures.FirstOrDefault();
        if (feature is null && myClub is { } c2) feature = (await Q.ClubGlanceAsync(season, c2)).Next;
        homeForm = feature is null ? null : (await Q.ClubGlanceAsync(season, feature.Home)).Form;
        awayForm = feature is null ? null : (await Q.ClubGlanceAsync(season, feature.Away)).Form;
        myForm = myClub is { } c3 ? (feature?.Home == c3 ? homeForm : feature?.Away == c3 ? awayForm : (await Q.ClubGlanceAsync(season, c3)).Form) : null;

        // BXH: giải của trận chính (giải vô địch) → giải đầu tiên → BXH mùa 1 giải
        var ed = editions.FirstOrDefault(e => e.Id == feature?.EditionId && e.Type == CompetitionType.DomesticLeague)
                 ?? editions.FirstOrDefault(e => e.Type == CompetitionType.DomesticLeague) ?? editions.FirstOrDefault();
        if (ed is not null) { table = await Q.EditionStandingsAsync(ed.Id, Store, Clock); tableComp = ed.CompetitionId; tableName = editions.Count > 1 ? ed.Name : null; }
        else { table = await Q.StandingsAsync(season.Id, Store, Clock); tableComp = null; tableName = null; }
        standingsCount = table.Count;

        // clip bàn thắng: vòng hiện tại rồi lùi dần, ưu tiên giải của BXH
        reel = null;
        var order = ed is null ? editions.Cast<EditionView?>().Prepend(null).ToList() : editions.OrderBy(e => e.Id != ed.Id).Cast<EditionView?>().ToList();
        if (order.Count == 0) order.Add(null);
        for (var n = md?.Number ?? 0; n >= 1 && reel is null && n > (md?.Number ?? 0) - 4; n--)
            foreach (var e in order)
                if (Reels.Info(e?.Id, season.Id, n) is { } info && info.Items.Count > 0) { reel = (info, editions.Count > 1 ? e?.Name : null); break; }
    }

    IEnumerable<(StandingRow<Guid> Row, int Index)> TableRows()
    {
        var all = table.Select((r, i) => (r, i)).ToList();
        var top = all.Take(5).ToList();
        if (myClub is { } c && !top.Any(x => x.r.Club == c) && all.FirstOrDefault(x => x.r.Club == c) is { r: not null } mine) top.Add(mine);
        return top;
    }

    RenderFragment TeamBlock(Guid club, TeamForm? form, bool away) => __builder =>
    {
        <span class="h-team">
            <span class="crest-wrap">
                <Crest Name="@season!.Clubs[club]" Logo="@season.Logo(club)" />
                @if (form is { StarterOvr: > 0 }) { <span class="h-ovr @(away ? "away" : "")" title="OVR trung bình đội hình chính">@Math.Round(form.StarterOvr)</span> }
            </span>
            <b>@season.Clubs[club]</b>
            <small>@(club == myClub ? "CLB của bạn" : season.IsHuman(club) ? "HLV người" : "BOT")@(form?.Rank is { } rk ? $" · hạng {rk}" : "")</small>
            @if (form is { Last.Count: > 0 }) { <span class="h-form">@foreach (var x in form.Last.TakeLast(5)) { <i class="@x.Result" title="@x.Score">@ResultVi(x.Result)</i> }</span> }
        </span>
    };

    string? EditionName(FixtureView f) => editions.FirstOrDefault(e => e.Id == f.EditionId)?.Name;
    static string ResultVi(char r) => r switch { 'W' => "T", 'D' => "H", _ => "B" };
    static string Signed(int n) => n > 0 ? $"+{n}" : n.ToString();
    static string Clip(double s) => TimeSpan.FromSeconds(s).ToString(s >= 3600 ? @"h\:mm\:ss" : @"mm\:ss");
    string Left(DateTimeOffset dl)
    {
        var t = dl - Clock.GetUtcNow();
        if (t < TimeSpan.Zero) t = TimeSpan.Zero;
        return t.TotalHours >= 24 ? $"{(int)t.TotalDays}n {t.Hours:00}:{t.Minutes:00}" : $"{(int)t.TotalHours:00}:{t.Minutes:00}:{t.Seconds:00}";
    }
    string Ago(DateTimeOffset at)
    {
        var t = Clock.GetUtcNow() - at;
        return t.TotalMinutes < 60 ? $"{Math.Max(1, (int)t.TotalMinutes)} phút trước" : t.TotalHours < 24 ? $"{(int)t.TotalHours} giờ trước" : $"{(int)t.TotalDays} ngày trước";
    }

    void OnJob() => InvokeAsync(async () =>
    {
        // Đọc lại DB khi có kết quả (hết trận / kết thúc việc / sang trận khác), còn lại chỉ vẽ lại nhật ký.
        var last = Jobs.Log.LastOrDefault() ?? "";
        if (last.Contains("hết trận") || last.Contains("xong") || last.Contains("Kết thúc") || wasRunning != Jobs.Running || loadedFor != Jobs.CurrentFixtureId) await LoadAsync();
        wasRunning = Jobs.Running;
        StateHasChanged();
    });

    async Task DelegateAll(Guid matchdayId)
    {
        await using (var db = await Dbs.CreateDbContextAsync())
        {
            await new AbsenceService(db, TimeProvider.System).ApplyDeadlineAsync(matchdayId);   // như đêm hạn chót: trợ lý đá thay + đếm vắng (PO 17/11)
        }
        await LoadAsync();
        Jobs.PlayBots(matchdayId);
    }

    // Đá BOT: trận BOT chưa xong của khung, trận đang đá tính riêng. Đã xin dừng → chỉ còn trận đang đá.
    (int Matches, int Minutes)? BotLeft()
    {
        if (season is null) return null;
        var left = fixtures.Where(f => f.Status != FixtureStatus.Played && !season.NeedsHuman(f)).ToList();
        var current = left.Any(f => f.Id == Jobs.CurrentFixtureId) ? 1 : 0;
        var queued = Jobs.StopPending ? 0 : left.Count - current;
        return Jobs.BotQueueMinutesLeft(queued) is { } m ? (queued + current, m) : null;
    }

    static string Duration(int minutes) => minutes >= 60 ? $"{minutes / 60} giờ {minutes % 60} phút" : $"{minutes} phút";

    public void Dispose()
    {
        Jobs.Changed -= OnJob;
        tick?.Dispose();
    }
}
