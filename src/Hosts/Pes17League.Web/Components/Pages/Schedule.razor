    // ----- Toàn bộ lịch -----
    List<DayGroup> DayGroups()
    {
        var me = season!.HumanClubId;
        var mineIds = mineEds.Select(e => e.Id).ToHashSet();
        return [.. fixtures.Where(f => f.Matchday == day).GroupBy(f => f.EditionId)
            .Select(g => new DayGroup(g.Key ?? Guid.Empty, g.Key is { } id ? edById.GetValueOrDefault(id) : null,
                [.. g.OrderByDescending(f => f.Home == me || f.Away == me)], g.Any(f => f.Home == me || f.Away == me) || g.Key is { } k && mineIds.Contains(k)))
            .OrderByDescending(x => x.Mine).ThenBy(x => x.E is null ? -1 : editions.IndexOf(x.E))];
    }

