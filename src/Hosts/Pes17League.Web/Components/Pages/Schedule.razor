        {
            var ko = dmd.Stage is not (null or FixtureStage.League or FixtureStage.LeaguePhase);
            var links = ko ? mineEds.Where(e => e.Type == (kind == Kind.Eu ? CompetitionType.ContinentalCup : CompetitionType.DomesticCup)).ToList() : new List<EditionView>();
            var wait = tbds.FirstOrDefault(t => t.K == day);
            <div class="lx-emptyday">
                <b>@(ko ? $"{AdminText.SlotKind(dmd.Stage, dmd.Leg)}: chưa có cặp đấu" : "Khung này không có trận")</b>
                @if (ko) { <p>@(wait?.Sub ?? "Cặp đấu được tạo khi vòng trước đá xong. Xem nhánh đấu để biết ai đang còn trong giải.")</p> }
                @foreach (var e in links)
                {
                    <a class="cx-btn ghost sm" href="@season.Url($"giai/{e.CompetitionId}?tab=nhanh")"><span class="ms">account_tree</span>Nhánh đấu @e.Name</a>
                }
            </div>
        }
        else
        {
            <div class="lx-groups">
                @foreach (var g in groups)
                {
                    var on = isOpen.Contains(g.Key);
                    var key = g.Key;
                    var name = g.E?.Name ?? season.Name;
                    var done = g.Fx.Count(f => f.Status == FixtureStatus.Played);
                    var sub = new List<string>();
                    if (g.E is { Type: not CompetitionType.ContinentalCup, Country: { } country }) sub.Add(country);
                    if (g.E is { Type: CompetitionType.DomesticLeague, Tier: { } tier }) sub.Add($"hạng {tier}");
                    sub.Add(Fmt.Round(byEdition[g.Fx[0].EditionId], day));
                    if (g.Mine) sub.Add("giải của bạn");
                    <section class="@($"grp{(g.Mine ? " me" : "")}")">
                        <button type="button" aria-expanded="@B(on)" @onclick="() => Toggle(key, on)">
                            <span class="lg"><Crest Name="@name" Logo="@g.E?.Logo" /></span>
                            <span class="nm"><b>@name</b><small>@string.Join(" · ", sub.Where(x => x.Length > 0))</small></span>
                            <span class="prog">@($"{done}/{g.Fx.Count}")</span><span class="ms chev">expand_more</span>
                        </button>
                        @if (on)
                        {
                            <ul>
                                @foreach (var f in g.Fx)
                                {
                                    var mineRow = f.Home == me || f.Away == me;
                                    var sc = f is { Status: FixtureStatus.Played, HomeGoals: { } hg, AwayGoals: { } ag } ? (H: hg, A: ag) : ((int H, int A)?)null;
                                    var hp = f.HomePenalties;
                                    var ap = f.AwayPenalties;
                                    var homeLost = sc is { } x && (x.H < x.A || x.H == x.A && hp < ap);
                                    var awayLost = sc is { } y && (y.A < y.H || y.H == y.A && ap < hp);
                                    <li>
                                        <a class="@($"m{(mineRow ? " my" : "")}")" href="@season.Url($"tran/{f.Id}")">
                                            <span class="@($"tn ho{(homeLost ? " lose" : "")}")">@Name(f.Home)</span>
                                            <Crest Name="@Name(f.Home)" Logo="@season.Logo(f.Home)" />
                                            @if (sc is { } s)
                                            {
                                                <span class="s">@($"{s.H}–{s.A}")@if (hp is { } pa && ap is { } pb) { <small>@($"pen {pa}–{pb}")</small> }</span>
                                            }
                                            else if (f.Status == FixtureStatus.Playing) { <span class="s live">Đang đá</span> }
                                            else { <span class="s pend">vs</span> }
                                            <Crest Name="@Name(f.Away)" Logo="@season.Logo(f.Away)" />
                                            <span class="@($"tn{(awayLost ? " lose" : "")}")">@Name(f.Away)</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
            </div>
        }
    };
}
