@page "/cai-dat"
@using Microsoft.EntityFrameworkCore
@using Pes17League.Clubs.Infrastructure
@inject CurrentUser Me
@inject IDbContextFactory<ClubsDbContext> Dbs
@inject MatchJobService Jobs
@inject GameSettingsStore Game
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Cài đặt</PageTitle>

@* Cài đặt career (PO 20/11, phương án B): âm thanh (chuyển từ menu ≡; career-audio.js đọc data-snd*, lưu trên trình duyệt), mô phỏng
   (chuyển từ trang chủ, PO 20/11), điều khiển game, tài khoản. *@
<div class="st">
    <h1>Cài đặt</h1>

    <section class="hlv-panel st-sec" aria-labelledby="st-snd">
        <h2 id="st-snd"><i class="ms" aria-hidden="true">volume_up</i>Âm thanh</h2>
        <p class="hlv-note">Lưu trên trình duyệt này. Âm thanh tự sinh trong máy, không tải file.</p>
        <div class="cx-snd st-snd">
            @if (CareerLayout.MusicOn)
            {
                <span class="now" data-snd="now">Nhạc đang tắt</span>
                <label>Nhạc <input type="range" min="0" max="100" data-snd-vol="music" aria-label="Âm lượng nhạc" /></label>
            }
            <label class="sw"><input type="checkbox" data-snd="sfx" /><span>Âm hiệu ứng</span><small>Tiếng bấm nút, mở khoá, kết quả trận</small></label>
            <label>Âm lượng <input type="range" min="0" max="100" data-snd-vol="sfx" aria-label="Âm lượng hiệu ứng" /></label>
        </div>
    </section>

    @if (clubId is not null)
    {
        <section class="hlv-panel st-sec" aria-labelledby="st-sim">
            <h2 id="st-sim"><i class="ms" aria-hidden="true">tune</i>Mô phỏng trận</h2>
            <label class="sw" title="Khi mô phỏng trận của bạn: cầu thủ đá chính mệt (≥ @ConditionRules.TiredAt) được cho nghỉ nếu có dự bị cùng tuyến khoẻ. Không sửa đội hình bạn đã lưu.">
                <input type="checkbox" checked="@autoLineup" @onchange="ToggleAuto" /><span>Trợ lý xoay vòng đội hình</span><small>Khi mô phỏng, cầu thủ quá mệt được nghỉ nếu có dự bị cùng tuyến. Không sửa đội hình bạn đã lưu.</small>
            </label>
            @if (!Jobs.Running && Jobs.Title is MatchJobService.SimTitle or MatchJobService.RolloverTitle && Jobs.Log.Count > 0)
            {
                <details class="st-log"><summary>Nhật ký lần mô phỏng gần nhất</summary><pre>@string.Join("\n", Jobs.Log.TakeLast(12))</pre></details>
            }
        </section>
    }

    @if (clubId is not null || admin)
    {
        <section class="hlv-panel st-sec" aria-labelledby="st-pes">
            <h2 id="st-pes"><i class="ms" aria-hidden="true">videogame_asset</i>Máy game</h2>
            <p class="hlv-note">Áp dụng từ trận kế tiếp bạn vào đá trong game.</p>
            <div class="st-opt" role="radiogroup" aria-labelledby="st-lv">
                <b id="st-lv">Độ khó máy</b>
                <div class="st-chips no-busy">
                    @foreach (var (key, label) in GameSettingsStore.Levels)
                    {
                        <button type="button" role="radio" aria-checked="@(game.Level == key ? "true" : "false")" class="@(game.Level == key ? "on" : null)"
                                @onclick="() => Set(game with { Level = key })">@label<small>@key</small></button>
                    }
                </div>
            </div>
            <div class="st-opt" role="radiogroup" aria-labelledby="st-ai">
                <b id="st-ai">Trí khôn AI</b>
                <div class="st-chips st-gfx no-busy">
                    @foreach (var (key, label, note) in GameSettingsStore.AiModes)
                    {
                        <button type="button" role="radio" aria-checked="@(game.AiMode == key ? "true" : "false")" class="@(game.AiMode == key ? "on" : null)"
                                @onclick="() => Set(game with { AiMode = key })">@label<small>@note</small></button>
                    }
                </div>
                <small class="st-hint"><i class="ms" aria-hidden="true">info</i>Chỉnh cách cầu thủ do máy điều khiển chơi, không đổi chỉ số. Áp cho cả đồng đội bạn không cầm. Đổi mức: game cài lại và tự mở lại trước trận kế tiếp.</small>
            </div>
            <div class="st-opt" role="radiogroup" aria-labelledby="st-gfx">
                <b id="st-gfx">Đồ hoạ</b>
                <div class="st-chips st-gfx no-busy">
                    @foreach (var (key, label, note) in GameSettingsStore.Qualities)
                    {
                        <button type="button" role="radio" aria-checked="@(game.Quality == key ? "true" : "false")" class="@(game.Quality == key ? "on" : null)"
                                @onclick="() => Set(game with { Quality = key })">@label<small>@note</small></button>
                    }
                </div>
                <small class="st-hint"><i class="ms" aria-hidden="true">info</i>Đổi đồ hoạ: game tự mở lại trước trận kế tiếp (thêm khoảng 30–60 giây). Máy game giữ 60 khung/giây ở mọi mức; hình bị giật do mạng thì bật "Giảm giật" trên màn hình chơi.</small>
            </div>
            <div class="st-opt" aria-labelledby="st-cam">
                <b id="st-cam">Camera trong trận</b>
                <CameraPicker Current="game" OnSave="Set" />
            </div>
            @if (saved is not null) { <p class="st-saved" role="status"><i class="ms" aria-hidden="true">check_circle</i>@saved</p> }
        </section>
    }

    <section class="hlv-panel st-sec" aria-labelledby="st-game">
        <h2 id="st-game"><i class="ms" aria-hidden="true">sports_esports</i>Điều khiển game</h2>
        <a class="st-row" href="dieu-khien"><span><b>Bàn phím và tay cầm</b>Đổi phím dùng khi vào trận</span><i class="ms" aria-hidden="true">chevron_right</i></a>
        <div class="st-row st-tip"><i class="ms" aria-hidden="true">fullscreen</i><span><b>Toàn màn hình · Giảm giật</b>2 nút ở giữa mép trên màn hình chơi</span></div>
    </section>

    <section class="hlv-panel st-sec" aria-labelledby="st-acc">
        <h2 id="st-acc"><i class="ms" aria-hidden="true">account_circle</i>Tài khoản</h2>
        @if (profile is not null) { <a class="st-row" href="@profile"><span><b>@who</b>Trang người chơi của bạn</span><i class="ms" aria-hidden="true">chevron_right</i></a> }
        @if (admin) { <a class="st-row" href="admin"><span><b>Quản trị</b>Dành cho ban tổ chức</span><i class="ms" aria-hidden="true">chevron_right</i></a> }
        @if (profile is not null)
        {
            <form method="post" action="/logout" data-enhance="false"><button class="cx-btn ghost sm st-out"><i class="ms" aria-hidden="true">logout</i>Đăng xuất</button></form>
        }
    </section>
</div>

@code {
    bool admin, autoLineup = true;
    string? who, profile, saved;
    GameSettingsStore.Settings game = new();
    Guid? clubId;

    protected override async Task OnInitializedAsync()
    {
        admin = await Me.IsAdminAsync();
        game = Game.Get();
        if (await Me.ManagerIdAsync() is { } mid)
        {
            await using var db = await Dbs.CreateDbContextAsync();
            var mine = await (from a in db.TeamAssignments join c in db.Clubs on a.ClubId equals c.Id
                              where a.ParticipantId == mid && a.To == null && a.ControllerType == ControllerType.Human select new { c.Id, c.AutoLineup }).FirstOrDefaultAsync();
            (clubId, autoLineup) = (mine?.Id, mine?.AutoLineup ?? true);
        }
        if (await Me.ManagerIdAsync() is not null)
        {
            who = await Me.NameAsync();
            profile = "nguoi-choi/" + await Me.UsernameAsync();
        }
        loaded = true;
    }

    // Mở từ menu "Máy game" (cai-dat#st-pes): cuộn lại sau khi trang đủ dữ liệu — lần cuộn sẵn của Blazor có thể lố vì phần trên hiện muộn.
    bool loaded, jumped;
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (loaded && !jumped && (jumped = true) && new Uri(Nav.Uri).Fragment is { Length: > 1 } f)
            try { await JS.InvokeVoidAsync("cxScrollTo", f); } catch (JSException) { }
    }

    void Set(GameSettingsStore.Settings s)
    {
        if (clubId is null && !admin) return;
        var gfx = s.Quality != game.Quality;
        var ai = s.AiMode != game.AiMode;
        var cam = s.CamHeight != game.CamHeight || s.CamAngle != game.CamAngle || s.CamType != game.CamType;
        Game.Save(s);
        game = s;
        saved = ai ? "Đã lưu — game sẽ cài lại trí khôn AI mới trước trận kế tiếp" : gfx ? "Đã lưu — game sẽ mở lại với đồ hoạ mới trước trận kế tiếp" : cam ? "Đã lưu camera — áp dụng từ trận kế tiếp" : "Đã lưu";
    }

    async Task ToggleAuto(ChangeEventArgs e)
    {
        if (clubId is not { } id) return;
        autoLineup = e.Value is true;
        await using var db = await Dbs.CreateDbContextAsync();
        await db.Clubs.Where(c => c.Id == id).ExecuteUpdateAsync(u => u.SetProperty(c => c.AutoLineup, autoLineup));
    }
}
