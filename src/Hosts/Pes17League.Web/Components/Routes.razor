<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @* PO 16/11: trang quản trị (Admin*.razor, Ẩn/hiện) dùng khu riêng AdminLayout.
           PO 19/11 (UI career đợt 1): trang của chế độ sự nghiệp dùng CareerLayout (người chơi chưa cầm CLB → tự quay về MainLayout).
           PO 22/11 (gộp 2 UI, chỉ còn career): MỌI trang người chơi dùng CareerLayout để chung 1 đầu trang/menu; chưa cầm CLB vẫn tự về MainLayout. *@
        <RouteView RouteData="routeData" DefaultLayout="@LayoutFor(routeData.PageType)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <section class="panel"><h1>Không tìm thấy trang</h1><p class="muted">Đường dẫn sai hoặc trang đã bị gỡ.</p><p><a class="btn primary" href="">Về trang chủ</a></p></section>
        </LayoutView>
    </NotFound>
</Router>

@code {
    static Type LayoutFor(Type page) =>
        page.Name.StartsWith("Admin") || page == typeof(Pages.Visibility) ? typeof(AdminLayout)
        : typeof(CareerLayout);
}
